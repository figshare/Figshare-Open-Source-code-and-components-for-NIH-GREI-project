+class OAIREPresenter(OAIMetadataPresenter):
+    """oai_openaire -- OpenAIRE Guidelines for Literature Repositories v4 (OAIRE v4).
+
+    v3-only: gated at the request-validation layer (parsers/oai.py::V3_ONLY_PREFIXES) and in
+    ListMetadataFormats (metadataformat.py)
