+                "is_link_only": False,
+                "computed_md5": "md5",
+                "supplied_md5": "md5",
+            }
+        ],
+    )
+
+    xml = record.OAIREPresenter(doc, is_v3=True).to_xml()
+
+    file_element = xml.find(".//{*}file")
+    assert file_element is not None
+    assert file_element.get("mimeType") is None
+
+
+def test_oaire_presenter_omits_file_for_link_only_files(patcher):
+    _patched_sql_data_cache(patcher)
+    patcher.object(record, "get_citation_data", return_value={"publisher": "Figgy"})
+    doc = _es_thesis_doc_itbm(
+        restrictions={"active": 0, "rules": {"on_files": 0}},
+        files=[
+            {
+                "id": 1,
+                "name": "data.csv",
+                "size": 10,
+                "download_url": "https://example.com/data.csv",
+                "is_link_only": True,
+                "computed_md5": "md5",
+                "supplied_md5": "md5",
+                "mimetype": "text/csv",
+            }
+        ],
+    )
+
+    xml = record.OAIREPresenter(doc, is_v3=True).to_xml()
+
+    assert xml.find(".//{*}file") is None
+
+
