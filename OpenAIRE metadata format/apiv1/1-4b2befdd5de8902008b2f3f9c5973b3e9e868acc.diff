+
+    element_name = "metadata"
+
+    def __init__(self, article, is_v3=False):
+        super(OAIREPresenter, self).__init__(is_v3)
+
+        self["title"] = remove_control_chars(get_attribute(article, "title"))
+        self["authors"] = get_attribute(article, "authors", [])
+        self["identifier"] = self.get_identifier(article)
+        self["identifier_type"] = self.get_identifier_type(article)
+        self["relation"] = self.entity_url(article)
+        self["abstract"] = remove_control_chars(get_attribute(article, "description"))
+        self["subject"] = get_article_categories(article)
+        self["tags"] = [remove_control_chars(tag) for tag in get_article_tags(article)]
+        self["access_details"] = get_coar_access_right_details(article)
+        self["files"] = _public_files(article)
+        self["language"] = get_language_codes(get_stock_field_values(article, "language"))
+        self["journal"] = get_stock_field_value(article, "journal")
+        self["medium"] = get_stock_field_value(article, "medium")
+        self["first_online"] = get_date(article, "first_online", just_date=True)
+        self["publisher_accepted"] = get_date(article, "publisher_accepted", just_date=True)
+        self["publisher_published"] = get_date(article, "publisher_published", just_date=True)
+        self["funding"] = get_article_funding(article)
+
+        defined_type_api = get_attribute(article, "item_type", None, "defined_type_api")
+
+        item_type = get_item_type(article, defined_type_api, "openaire")
+        output_type = item_type.split("/")[0] if item_type else "Product"
+        _, _, coar_code = (item_type or "").rpartition("/")
+        resource_type_general = OAIRE_RESOURCE_TYPE_GENERAL_BY_COAR_CODE.get(coar_code)
+        if resource_type_general:
+            self["resource_type_general"] = resource_type_general
+            self["resource_type_uri"] = "http://purl.org/coar/resource_type/{}".format(coar_code)
+            self["resource_type_label"] = OAIRE_RESOURCE_TYPE_LABEL_BY_COAR_CODE[coar_code]
+        else:
+            self["resource_type_general"] = OAIRE_RESOURCE_TYPE_GENERAL.get(output_type, "dataset")
+            self["resource_type_uri"] = OAIRE_RESOURCE_TYPE_URI[self["resource_type_general"]]
+            self["resource_type_label"] = OAIRE_RESOURCE_TYPE_LABEL_FALLBACK[self["resource_type_general"]]
+
+        _article_id = get_attribute(article, "id")
+        _institution_id = (
+            get_attribute(article, "institution", {}).get("id") if isinstance(article, dict) else article.institution_id
+        )
+        citation_data = get_citation_data(_article_id, _institution_id)
+        self["publisher"] = citation_data.get("publisher", FIGSHARE_BRANDING)
+
+    def to_xml(self):
+        root = etree.Element(self.element_name)
+        e_resource = etree.SubElement(
+            root,
+            nsoaire("resource"),
+            nsmap={None: NS_OAIRE, "datacite": NS_DATACITE, "dc": NS_DC, "xsi": NS_XSI},
+        )
+        e_resource.set("{%s}schemaLocation" % NS_XSI, "%s %s" % (NS_OAIRE, NS_OAIRE_XSD))
+
+        if self["authors"]:
+            creators = etree.SubElement(e_resource, nsdatacite("creators"))
+            for author in self["authors"]:
+                creator = etree.SubElement(creators, nsdatacite("creator"))
+                name = etree.SubElement(creator, nsdatacite("creatorName"))
+                first_name = get_attribute(author, "first_name")
+                last_name = get_attribute(author, "last_name")
+                name.text = "{}, {}".format(remove_control_chars(last_name), remove_control_chars(first_name))
+                if first_name:
+                    etree.SubElement(creator, nsdatacite("givenName")).text = remove_control_chars(first_name)
+                if last_name:
+                    etree.SubElement(creator, nsdatacite("familyName")).text = remove_control_chars(last_name)
+
+        titles = etree.SubElement(e_resource, nsdatacite("titles"))
+        etree.SubElement(titles, nsdatacite("title")).text = self["title"]
+
+        etree.SubElement(e_resource, nsdc("publisher")).text = remove_control_chars(self["publisher"])
+
+        resource_type = etree.SubElement(e_resource, nsoaire("resourceType"))
+        resource_type.set("resourceTypeGeneral", self["resource_type_general"])
+        resource_type.set("uri", self["resource_type_uri"])
+        resource_type.text = self["resource_type_label"]
+
+        identifier_element = etree.SubElement(e_resource, nsdatacite("identifier"))
+        if self["identifier"]:
+            identifier_element.set("identifierType", "DOI" if self["identifier_type"] == "doi" else "HANDLE")
+            identifier_element.text = self["identifier"]
+        else:
+            identifier_element.set("identifierType", "URL")
+            identifier_element.text = self["relation"]
+
+        if self["abstract"]:
+            etree.SubElement(e_resource, nsdc("description")).text = self["abstract"]
+
+        etree.SubElement(e_resource, nsdc("language")).text = self["language"][0] if self["language"] else "und"
+
+        if self["identifier"]:
+            alt_identifiers = etree.SubElement(e_resource, nsdatacite("alternateIdentifiers"))
+            id_element = etree.SubElement(alt_identifiers, nsdatacite("alternateIdentifier"))
+            id_element.set("alternateIdentifierType", "DOI" if self["identifier_type"] == "doi" else "Handle")
+            id_element.text = self["identifier"]
+            url_element = etree.SubElement(alt_identifiers, nsdatacite("alternateIdentifier"))
+            url_element.set("alternateIdentifierType", "URL")
+            url_element.text = self["relation"]
+
+        issued_date = self["publisher_published"] or self["first_online"]
+        if issued_date or self["publisher_accepted"]:
+            dates = etree.SubElement(e_resource, nsdatacite("dates"))
+            if issued_date:
+                etree.SubElement(dates, nsdatacite("date"), attrib={"dateType": "Issued"}).text = issued_date
+            if self["publisher_accepted"]:
+                etree.SubElement(dates, nsdatacite("date"), attrib={"dateType": "Accepted"}).text = self[
+                    "publisher_accepted"
+                ]
+
+        if self["journal"]:
+            etree.SubElement(e_resource, nsdc("source")).text = remove_control_chars(self["journal"])
+
+        if self["medium"]:
+            etree.SubElement(e_resource, nsdc("format")).text = self["medium"]
+
+        access_details = self["access_details"]
+        access_element = etree.SubElement(e_resource, nsdatacite("rights"))
+        access_element.set("rightsURI", access_details["uri"])
+        access_element.text = access_details["name"]
+
+        for file_ in self["files"]:
+            file_element = etree.SubElement(e_resource, nsoaire("file"))
+            file_element.set("accessRightsURI", access_details["uri"])
+            file_element.set("objectType", OAIRE_FILE_OBJECT_TYPE[self["resource_type_general"]])
+            mimetype = file_.get("mimetype")
+            if mimetype and mimetype != "undefined":
+                file_element.set("mimeType", mimetype)
+            file_element.text = file_.get("download_url", "")
+
+        if self["subject"] or self["tags"]:
+            subjects = etree.SubElement(e_resource, nsdatacite("subjects"))
+            for category in self["subject"]:
+                etree.SubElement(subjects, nsdatacite("subject")).text = remove_control_chars(
+                    get_attribute(category, "title")
+                )
+            for tag in self["tags"]:
+                etree.SubElement(subjects, nsdatacite("subject")).text = tag
+
+        funder_names = [get_attribute(funder, "funder_title") for funder in self["funding"]]
+        funder_names = [remove_control_chars(name) for name in funder_names if name]
+        if funder_names:
+            funding_references = etree.SubElement(e_resource, nsoaire("fundingReferences"))
+            for funder_name in funder_names:
+                funding_reference = etree.SubElement(funding_references, nsoaire("fundingReference"))
+                etree.SubElement(funding_reference, nsoaire("funderName")).text = funder_name
+
+        return root
