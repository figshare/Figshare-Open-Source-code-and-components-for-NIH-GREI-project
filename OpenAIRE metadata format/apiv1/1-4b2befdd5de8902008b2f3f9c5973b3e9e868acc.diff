@@ -213,6 +213,36 @@ class TestOAIBaseHandler:
 
             assert handler.params["page"] == 2
 
+    def test_extract_params_with_resumption_token_rejects_v3_only_prefix_on_v2(self, oai_request_list_identifiers):
+        """A resumptionToken issued on /v3/oai for oai_openaire (v3-only, FIG-45329) must not be
+        replayable against /v2/oai -- tokens carry no version binding of their own, so this has
+        to be re-checked at decode time here, not just at the original request's validate_args()."""
+        oai_request = {"verb": "ListIdentifiers", "resumptionToken": "token"}
+        handler = OAIBaseHandler(oai_request, is_v3=False)
+
+        with patch("figshare_api2.app.views.oai.handler.ResumptionToken") as mock_token:
+            mock_decoded = Mock(
+                is_valid=True, params_dict={"verb": "ListIdentifiers", "metadataPrefix": "oai_openaire"}
+            )
+            mock_token.decode.return_value = mock_decoded
+
+            with pytest.raises(oai_exceptions.CannotDiseminateFormat):
+                handler.extract_params()
+
+    def test_extract_params_with_resumption_token_accepts_v3_only_prefix_on_v3(self, oai_request_list_identifiers):
+        oai_request = {"verb": "ListIdentifiers", "resumptionToken": "token"}
+        handler = OAIBaseHandler(oai_request, is_v3=True)
+
+        with patch("figshare_api2.app.views.oai.handler.ResumptionToken") as mock_token:
+            mock_decoded = Mock(
+                is_valid=True, params_dict={"verb": "ListIdentifiers", "metadataPrefix": "oai_openaire"}
+            )
+            mock_token.decode.return_value = mock_decoded
+
+            handler.extract_params()
+
+            assert handler.params["metadataPrefix"] == "oai_openaire"
+
     def test_build_resumption_token(self, oai_request_list_identifiers):
         """Test build_resumption_token creates next page token"""
         handler = OAIBaseHandler(oai_request_list_identifiers)
