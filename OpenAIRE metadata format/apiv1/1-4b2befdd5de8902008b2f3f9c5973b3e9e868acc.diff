diff --git a/figshare_api2/tests/app/presenters/oai/oaire_schema_test.py b/figshare_api2/tests/app/presenters/oai/oaire_schema_test.py
new file mode 100644
index 00000000..9b2a7f56
--- /dev/null
+++ b/figshare_api2/tests/app/presenters/oai/oaire_schema_test.py
@@ -0,0 +1,126 @@
+"""Validates OAIREPresenter's rendered output against the real, published OAIRE v4 XSD.
+
+No format in this suite is validated against its actual schema (see the FIG-45329 investigation)
+-- ordering/structure mistakes are normally only caught by a real harvester. Added here
+specifically because building this presenter surfaced several mismatches between the ticket's
+own spec and the real schema (e.g. resourceType/@uri being required, rights having no rightsList
+wrapper) that only an actual schema validation would catch.
+
+The schema chain (openaire.xsd and its full transitive imports, including the W3C xml.xsd) is
+vendored under schemas/oaire/ so this test needs no network access -- see that directory's
+files, fetched from https://www.openaire.eu/schema/repo-lit/4.0/.
+"""
+
+import os
+
+from lxml import etree
+from mock import Mock, patch
+
+from figcore.lib.db import DBConnection
+from figshare_api2.app.presenters.oai import record
+
+SCHEMA_PATH = os.path.join(os.path.dirname(__file__), "schemas", "oaire", "openaire.xsd")
+
+# resolve_entities=False/no_network=True: nothing here needs the network, the whole schema
+# chain is vendored locally -- see the module docstring.
+_SCHEMA = etree.XMLSchema(etree.parse(SCHEMA_PATH, etree.XMLParser(resolve_entities=False, no_network=True)))
+
+
+def _es_openaire_doc(**overrides):
+    """A minimal ES-dict article, in the shape ListRecords/ListIdentifiers hand to presenters
+    (figshare_api2.app.views.oai.handler.ListingBaseHandler.load_articles). Kept local to this
+    file (rather than reusing record_test.py's builders) since this directory has no
+    __init__.py for a cross-test-file import to resolve against.
+    """
+    doc = {
+        "id": 32061423,
+        "title": "A test article",
+        "description": "Description",
+        "doi": "10.7274/32061423",
+        "url_name": "A_test_article",
+        "version": 1,
+        "item_type": {"id": 8, "name": "thesis"},
+        "authors": [
+            {"first_name": "Jane", "last_name": "Doe", "user_id": 23760399},
+        ],
+        "dates": {
+            "created": "2026-05-05 15:01:32",
+            "modified": "2026-05-05 15:01:40",
+            "published": "2026-05-05 15:01:32",
+        },
+        "restrictions": {"active": 0, "rules": {}},
+        "categories": [],
+        "tags": [],
+        "files": [],
+        "funding": [],
+        "funding_list": [],
+        "references": [],
+        "license": {"name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"},
+        "institution": {"id": 1056, "name": "University of Notre Dame"},
+        "group": {"id": 50931, "name": "University of Notre Dame"},
+        "stock_fields_display": {"text": {}, "date": {}},
+    }
+    doc.update(overrides)
+    return doc
+
+
+def _resource_element(metadata_xml):
+    # OAIREPresenter.to_xml() returns <metadata><resource>...</resource></metadata> --
+    # the schema validates the inner <resource>, "metadata" is this codebase's own envelope.
+    return metadata_xml[0]
+
+
+def test_oaire_presenter_es_dict_output_is_schema_valid(patcher):
+    # get_item_type() goes through SQLDataCache's shared, process-wide CACHE -- patched
+    # directly here instead, so this test doesn't depend on some earlier test in the run
+    # having already warmed that cache (see the resource_type_general assignment in
+    # OAIREPresenter.__init__).
+    patcher.object(record, "get_item_type", return_value=None)
+    patcher.object(record, "get_citation_data", return_value={"publisher": "Figgy"})
+    doc = _es_openaire_doc(
+        stock_fields_display={
+            "text": {"language": ["English"], "journal": "Journal of Cryo Studies", "medium": "PDF"},
+            "date": {},
+        },
+        funding_list=[{"funder_title": "NIH", "grant_code": "R01"}],
+        categories=[{"id": 1, "title": "Chemistry"}],
+        tags=["cryogenics"],
+    )
+
+    xml = record.OAIREPresenter(doc, is_v3=True).to_xml()
+
+    _SCHEMA.assertValid(etree.ElementTree(_resource_element(xml)))
+
+
+def test_oaire_presenter_es_dict_minimal_output_is_schema_valid(patcher):
+    # No DOI, no stock fields, no funding, no categories/tags/authors -- the sparsest record
+    # this presenter renders. Confirms every optional block is skipped cleanly rather than
+    # emitting an empty/invalid element (funderName-less fundingReference, empty subjects, etc.).
+    patcher.object(record, "get_item_type", return_value=None)
+    patcher.object(record, "get_citation_data", return_value={"publisher": "Figgy"})
+    doc = _es_openaire_doc(doi=None, categories=[], tags=[], authors=[])
+
+    xml = record.OAIREPresenter(doc, is_v3=True).to_xml()
+
+    _SCHEMA.assertValid(etree.ElementTree(_resource_element(xml)))
+
+    resource = _resource_element(xml)
+    identifier = resource.find(".//{*}identifier")
+    assert identifier.get("identifierType") == "URL"
+    language = resource.find(".//{*}language")
+    assert language.text == "und"
+    assert resource.find(".//{*}alternateIdentifiers") is None
+
+
+@patch.object(DBConnection, "get_session", return_value=Mock())
+def test_oaire_presenter_orm_object_output_is_schema_valid(db_conn, article, patcher):
+    patcher.object(record, "get_citation_data", return_value={"publisher": "Figgy"})
+    article.defined_type_api = Mock(get_mapping=Mock(return_value="Publication/c_18cf"))
+    # article.funding is explicitly None on this fixture (non-ITBM); get_article_funding()
+    # falls through to article.get_field_value("funding_list"), an otherwise-unstubbed Mock
+    # method whose auto-return is truthy -- same stub the RDFPresenter ORM funding tests use.
+    article.get_field_value = Mock(return_value=[])
+
+    xml = record.OAIREPresenter(article, is_v3=True).to_xml()
+
+    _SCHEMA.assertValid(etree.ElementTree(_resource_element(xml)))
