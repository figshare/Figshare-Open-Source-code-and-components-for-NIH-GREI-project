+    def test_raid_identifier_type_emitted_in_itbm_xml(
+        self, mock_rm, mock_funding, mock_grid_find, mock_grids, mock_cats
+    ):
+        mock_rm.side_effect = [
+            mock.Mock(identifier="https://raid.org/10.26259/5c43ca8f", identifier_type="RAiD", relation="References"),
+        ]
+        related_materials_field = mock.Mock(id=103)
+        related_materials_field.name = "related_materials"
+
+        helper = DataCiteDOIHelper(**self.CONFIG)
+        item_data = self._minimal_item_data(
+            fields={"103": {"value": [401]}},
+            schema=[related_materials_field],
+        )
+        xml = helper.build_xml_itbm(item_data)
+        self.assertIn('relatedIdentifierType="RAiD"', xml)
+        self.assertIn('relationType="References"', xml)
+        self.assertIn("https://raid.org/10.26259/5c43ca8f", xml)
+
+    def test_swhid_identifier_type_emitted_in_itbm_xml(
+        self, mock_rm, mock_funding, mock_grid_find, mock_grids, mock_cats
+    ):
+        mock_rm.side_effect = [
+            mock.Mock(
+                identifier="swh:1:cnt:94a9ed024d3859793618152ea559a168bbcbb5e2",
+                identifier_type="SWHID",
+                relation="IsSupplementTo",
+            ),
+        ]
+        related_materials_field = mock.Mock(id=103)
+        related_materials_field.name = "related_materials"
+
+        helper = DataCiteDOIHelper(**self.CONFIG)
+        item_data = self._minimal_item_data(
+            fields={"103": {"value": [401]}},
+            schema=[related_materials_field],
+        )
+        xml = helper.build_xml_itbm(item_data)
+        self.assertIn('relatedIdentifierType="SWHID"', xml)
+        self.assertIn('relationType="IsSupplementTo"', xml)
+        self.assertIn("swh:1:cnt:94a9ed024d3859793618152ea559a168bbcbb5e2", xml)
+
+    def test_other_relation_type_emitted_in_itbm_xml(
+        self, mock_rm, mock_funding, mock_grid_find, mock_grids, mock_cats
+    ):
+        mock_rm.side_effect = [
+            mock.Mock(identifier="10.1234/abc", identifier_type="DOI", relation="Other"),
+        ]
