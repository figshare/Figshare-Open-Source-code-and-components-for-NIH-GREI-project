+
+        result = actions._account_has_itbm()
+        self.assertTrue(result)
+
+    def test_returns_false_when_itbm_disabled(self):
+        self.feature_flag_overrides["itbm_enabled"] = Mock(is_active=False)
+        actions = self.account.actions_for(self.account)
+
+        result = actions._account_has_itbm()
+        self.assertFalse(result)
