diff --git a/tests/api/account/actions/test_related_material_actions.py b/tests/api/account/actions/test_related_material_actions.py
new file mode 100644
index 000000000..c976dd444
--- /dev/null
+++ b/tests/api/account/actions/test_related_material_actions.py
@@ -0,0 +1,268 @@
+from unittest.mock import Mock, patch
+
+
+import figcore.exc as fig_exc
+from figcore.api import Account, RelatedMaterial
+
+from tests import BaseTestTransactioned
+
+
+class TestCreateRelatedMaterialActions(BaseTestTransactioned):
+    @classmethod
+    def setUpClass(cls):
+        super().setUpClass()
+        cls.setup_environment()
+        cls.create_complete_environment()
+
+        cls.account = Account.find(1)
+        cls.article = cls.account.create_article(
+            {
+                "title": "Test article",
+                "description": "Test",
+                "account_id": 1,
+                "is_active": 1,
+                "defined_type": 3,
+                "institution_id": 1,
+                "license_id": 1,
+                "tags": ["test"],
+                "categories": [3],
+                "authors": [{"name": "Author"}],
+            }
+        )
+        cls.collection = cls.account.create_collection(
+            {
+                "title": "Test collection",
+                "description": "Test",
+                "tags": ["test"],
+                "categories": [3],
+            },
+            owner_is_author=True,
+        )
+        cls.material_data = {
+            "identifier": "10.1234/test",
+            "identifier_type": "DOI",
+            "relation": "Cites",
+            "title": "Test material",
+            "is_linkout": False,
+        }
+
+    def test_create_without_item_id(self):
+        actions = self.account.actions_for(self.account)
+        material = actions.create_related_material(dict(self.material_data))
+
+        self.assertEqual(material.account_id, self.account.id)
+        self.assertEqual(material.identifier, "10.1234/test")
+
+    def test_create_with_article_item_id(self):
+        actions = self.account.actions_for(self.account)
+        material = actions.create_related_material(dict(self.material_data), item_id=self.article.id)
+
+        self.assertEqual(material.account_id, self.article.account_id)
+        self.assertEqual(material.relation, "Cites")
+
+    def test_create_with_collection_item_id(self):
+        actions = self.account.actions_for(self.account)
+        material = actions.create_related_material(dict(self.material_data), item_id=self.collection.id)
+
+        self.assertEqual(material.account_id, self.collection.account_id)
+
+    def test_create_with_invalid_item_id_raises(self):
+        actions = self.account.actions_for(self.account)
+        with self.assertRaises(fig_exc.InsufficientPermissions):
+            actions.create_related_material(dict(self.material_data), item_id=999999)
+
+    def test_create_without_edit_permission_raises(self):
+        other_account = Account.find(2)
+        actions = other_account.actions_for(other_account)
+        with self.assertRaises(fig_exc.InsufficientPermissions):
+            actions.create_related_material(dict(self.material_data), item_id=self.article.id)
