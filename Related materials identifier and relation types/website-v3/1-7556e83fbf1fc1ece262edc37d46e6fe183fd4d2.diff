@@ -0,0 +1,79 @@
+import React from "react";
+import { render } from "@testing-library/react";
+import { IdentifiersAndRelationshipsContext } from "shared/resources/IdentifiersAndRelationships/context";
+
+import { RelatedMaterialPreviewBlock } from "./RelatedMaterialPreviewBlock";
+
+
+const contextValue = {
+  identifiers: {
+    data: [
+      { value: "DOI", label: "DOI" },
+      { value: "ARK", label: "ARK" },
+      { value: "RAiD", label: "RAiD" },
+    ],
+  },
+  relationships: {
+    data: [
+      { value: "References", label: "References" },
+      { value: "Other", label: "Other" },
+    ],
+  },
+};
+
+function renderWithContext(material) {
+  return render(
+    <IdentifiersAndRelationshipsContext.Provider value={contextValue}>
+      <RelatedMaterialPreviewBlock material={material} />
+    </IdentifiersAndRelationshipsContext.Provider>
+  );
+}
+
+
+describe("RelatedMaterialPreviewBlock", () => {
+  it("renders the preview banner for a standard relation type", () => {
+    const { container } = renderWithContext({
+      relationshipType: "References",
+      identifierType: "DOI",
+      identifier: "10.1234/test",
+    });
+
+    const preview = container.querySelector("[data-control-id='material-preview-section']");
+    expect(preview).not.toBeNull();
+    expect(preview.textContent).toContain("References");
+    expect(preview.textContent).toContain("(DOI)");
+    expect(preview.textContent).toContain("10.1234/test");
+  });
+
+  it("does not render the preview banner when relation type is Other", () => {
+    const { container } = renderWithContext({
+      relationshipType: "Other",
+      identifierType: "DOI",
+      identifier: "10.1234/test",
+    });
+
+    expect(container.querySelector("[data-control-id='material-preview-section']")).toBeNull();
+  });
+
+  it("does not render the preview banner when fields are missing", () => {
+    const { container } = renderWithContext({
+      relationshipType: "",
+      identifierType: "",
+    });
+
+    expect(container.querySelector("[data-control-id='material-preview-section']")).toBeNull();
+  });
+
+  it("renders the preview banner for ITBM identifier types", () => {
+    const { container } = renderWithContext({
+      relationshipType: "References",
+      identifierType: "RAiD",
+      identifier: "https://raid.org/10.25.1/abc",
+    });
+
+    const preview = container.querySelector("[data-control-id='material-preview-section']");
+    expect(preview).not.toBeNull();
+    expect(preview.textContent).toContain("(RAiD)");
+    expect(preview.textContent).toContain("https://raid.org/10.25.1/abc");
+  });
+});
