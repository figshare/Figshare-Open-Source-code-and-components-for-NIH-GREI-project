diff --git a/src/pages/editItem/EditItemMain/EditItemForm/EditItemFormField/figshareFields/relatedMaterials/components/manageRelatedMaterials/RelatedMaterialPreviewBlock.test.jsx b/src/pages/editItem/EditItemMain/EditItemForm/EditItemFormField/figshareFields/relatedMaterials/components/manageRelatedMaterials/RelatedMaterialPreviewBlock.test.jsx
