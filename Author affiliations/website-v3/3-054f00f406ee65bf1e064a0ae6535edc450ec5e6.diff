@@ -0,0 +1,295 @@
+/* Popover dialog that opens below the clicked author */
+.popover {
+  position: fixed;
+  z-index: 10;
+
+  display: flex;
+  flex-direction: column;
+
+  box-sizing: border-box;
+  width: 400px;
+  padding: 24px;
+
+  align-items: flex-start;
+  gap: 12px;
+
+  border: 1px solid #ddd;
+  border-radius: 6px;
+  background: #fff;
+  box-shadow: 0 0 6px 3px rgba(70, 70, 70, 0.12);
+}
+
+/* Arrow triangle pointing up from the popover towards the author button */
+.arrow {
+  position: absolute;
+  top: -7px;
+  left: 24px;
+
+  overflow: hidden;
+
+  width: 14px;
+  height: 7px;
+}
+
+.arrow::before {
+  display: block;
+
+  width: 10px;
+  height: 10px;
+  margin: 0 auto;
+
+  content: "";
+  transform: rotate(45deg) translateY(3px);
+
+  border: 1px solid #ddd;
+  background: #fff;
+  box-shadow: 0 0 6px 3px rgba(70, 70, 70, 0.12);
+}
+
+/* Header row: author name + close button */
+.header {
+  display: flex;
+  flex-direction: row;
+
+  width: 100%;
+
+  align-items: flex-start;
+  gap: 12px;
+}
+
+/* Author name + optional subtitle text */
+.headerContent {
+  display: flex;
+  flex-direction: column;
+
+  min-width: 0;
+
+  flex: 1;
+  justify-content: center;
+  gap: 3px;
+}
+
+.authorName {
+  font-family: Arial, sans-serif;
+  font-size: 20px;
+  font-weight: 400;
+  line-height: 30px;
+
+  overflow: hidden;
+
+  width: 100%;
+  margin: 0;
+
+  white-space: nowrap;
+  text-overflow: ellipsis;
+
+  color: #252525;
+}
+
+/* Close (X) button */
+.closeButton {
+  display: flex;
+
+  width: 36px;
+  height: 36px;
+  padding: 10px;
+
+  cursor: pointer;
+  align-items: center;
+  justify-content: center;
+
+  color: #8d8d8d;
+  border: none;
+  border-radius: 3px;
+  background: none;
+
+  flex-shrink: 0;
+}
+
+/* SVG fill overrides for icon paths — lower-specificity selectors first to satisfy no-descending-specificity */
+.closeButton svg path {
+  fill: #8d8d8d;
+}
+
+.institutionIcon svg path {
+  fill: #464646;
+}
+
+.externalIcon svg path {
+  fill: #a60845;
+}
+
+.profileButtonIcon svg path {
+  fill: #fff;
+}
+
+.closeButton:hover svg path,
+.closeButton:focus-visible svg path {
+  fill: #464646;
+}
+
+.closeButton:hover,
+.closeButton:focus-visible {
+  background: #f5f5f5;
+}
+
+/* Horizontal separator between header and detail list */
+.separator {
+  width: 100%;
+  height: 1px;
+
+  background: #ddd;
+
+  flex-shrink: 0;
+}
+
+/* Vertical list of detail items (affiliations, orcid) */
+.detailList {
+  display: flex;
+  flex-direction: column;
+
+  width: 100%;
+  margin: 0;
+  padding: 0;
+
+  list-style: none;
+  gap: 6px;
+}
+
+/* A single detail row: icon + text/link + optional external-link icon */
+.detailItem {
+  display: flex;
+  flex-direction: row;
+
+  align-items: center;
+  gap: 8px;
+}
+
+.detailIcon {
+  display: flex;
+
+  width: 18px;
+  height: 18px;
+
+  align-items: center;
+  justify-content: center;
+
+  flex-shrink: 0;
+}
+
+/* Institution icon SVG has a tall non-square viewBox (10×36) — scale width to fill, let height auto-adjust */
+.institutionIcon svg {
+  width: 14px;
+  height: auto;
+}
+
+/* Plain text styling for affiliations (no link for now) */
+.detailText {
+  font-family: Arial, sans-serif;
+  font-size: 14px;
+  font-weight: 400;
+  line-height: 24px;
+
+  color: #464646;
+}
+
+/* Link styling for orcid */
+.detailLink {
+  font-family: Arial, sans-serif;
+  font-size: 14px;
+  font-weight: 400;
+  line-height: 24px;
+
+  overflow: hidden;
+
+  white-space: nowrap;
+  text-decoration: underline;
+  text-overflow: ellipsis;
+
+  color: #a60845;
+}
+
+.detailLink:hover,
+.detailLink:focus-visible {
+  text-decoration: none;
+}
+
+.externalIcon {
+  display: flex;
+
+  width: 12px;
+  height: 12px;
+
+  align-items: center;
+  justify-content: center;
+
+  flex-shrink: 0;
+}
+
+/* GoToLink icon has a tall viewBox (8×36) — scale width to fit, height auto */
+.externalIcon svg {
+  width: 12px;
+  height: auto;
+}
+
+/* "Individual contributors: ..." text for organization-type authors */
+.contributorsText {
+  font-family: Arial, sans-serif;
+  font-size: 16px;
+  font-weight: 400;
+  line-height: 24px;
+
+  width: 100%;
+  margin: 0;
+
+  color: #464646;
+}
+
+/* Primary "View author profile" button at the bottom */
+.profileButton {
+  display: flex;
+  flex-direction: row;
+
+  width: 100%;
+  padding: 6px 12px;
+
+  cursor: pointer;
+  text-decoration: none;
+  align-items: center;
+  justify-content: center;
+  gap: 12px;
+
+  border: none;
+  border-radius: 3px;
+  background: #a60845;
+}
+
+.profileButton:hover,
+.profileButton:focus-visible {
+  background: #8a0639;
+}
+
+.profileButtonLabel {
+  font-family: Arial, sans-serif;
+  font-size: 16px;
+  font-weight: 400;
+  line-height: 24px;
+
+  color: #fff;
+}
+
+.profileButtonIcon {
+  display: flex;
+
+  width: 16px;
+  height: 16px;
+
+  align-items: center;
+  justify-content: center;
+}
+
+/* GoToLink icon — scale width to fit, height auto */
+.profileButtonIcon svg {
+  width: 16px;
+  height: auto;
+}
diff --git a/src/shared/itmb/preview/UnderlyingFields/Values/AuthorPopover/AuthorPopover.tsx b/src/shared/itmb/preview/UnderlyingFields/Values/AuthorPopover/AuthorPopover.tsx
