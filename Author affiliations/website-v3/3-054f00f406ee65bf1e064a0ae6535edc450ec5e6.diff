+++ b/src/shared/itmb/preview/UnderlyingFields/Values/AuthorPopover/AuthorPopover.tsx
@@ -0,0 +1,184 @@
+import React, { useCallback, useEffect, useLayoutEffect, useRef, useState } from "react";
+import CancelIcon from "@digital-science/figshare-fcl/icons/cancel/medium";
+import GoToLinkIcon from "@digital-science/figshare-fcl/icons/goToLink/small";
+import InstitutionIcon from "@digital-science/figshare-fcl/icons/institution/small";
+import OrcidIcon from "@digital-science/figshare-fcl/icons/orcid/small";
+import { PERSON_TYPE_ORGANIZATIONAL } from "shared/itmb/personList";
+
+import styles from "./AuthorPopover.module.css";
+
+
+const ORCID_URL_PREFIX = "https://orcid.org/";
+
+
+interface Affiliation {
+  rorId?: string;
+  name?: string;
+}
+
+export interface AuthorPopoverData {
+  type?: number;
+  name: string;
+  orcidId?: string | null;
+  affiliations?: Affiliation[];
+  contributors?: string | null;
+  isActive?: boolean;
+  isPublic?: boolean;
+  publicUrl?: string | null;
+}
+
+interface AuthorPopoverProps {
+  author: AuthorPopoverData;
+  onClose: () => void;
+}
+
+
+export function AuthorPopover({ author, onClose }: AuthorPopoverProps) {
+  const popoverRef = useRef<HTMLDivElement>(null);
+  const [position, setPosition] = useState<{ top: number; left: number } | null>(null);
+
+  // Compute fixed position relative to the trigger button (parent wrapper element).
+  // Uses fixed positioning to avoid issues with CSS containing blocks in ancestor elements.
+  useLayoutEffect(() => {
+    function updatePosition() {
+      const wrapper = popoverRef.current?.parentElement;
+      if (!wrapper) {
+        return;
+      }
+      const rect = wrapper.getBoundingClientRect();
+      setPosition({ top: rect.bottom + 8, left: rect.left });
+    }
+
+    updatePosition();
+    window.addEventListener("scroll", updatePosition, true);
+    window.addEventListener("resize", updatePosition);
+
+    return () => {
+      window.removeEventListener("scroll", updatePosition, true);
+      window.removeEventListener("resize", updatePosition);
+    };
+  }, []);
+
+  // Close on click outside or Escape key.
+  // Skip the first frame so the mousedown that opened the popover doesn't immediately close it.
+  useEffect(() => {
+    let active = false;
+    const frameId = requestAnimationFrame(() => {
+      active = true;
+    });
+
+    function handleClickOutside(event: MouseEvent) {
+      // Check against the wrapper (parent) so clicking the trigger button doesn't count as "outside"
+      const wrapper = popoverRef.current?.parentNode;
+      if (active && wrapper && !wrapper.contains(event.target as Node)) {
+        onClose();
+      }
+    }
+
+    function handleKeyDown(event: KeyboardEvent) {
+      if (event.key === "Escape") {
+        onClose();
+      }
+    }
+
+    document.addEventListener("mousedown", handleClickOutside);
+    document.addEventListener("keydown", handleKeyDown);
+
+    return () => {
+      cancelAnimationFrame(frameId);
+      document.removeEventListener("mousedown", handleClickOutside);
+      document.removeEventListener("keydown", handleKeyDown);
+    };
+  }, [onClose]);
+
+  const handleCloseClick = useCallback((e: React.MouseEvent) => {
+    e.stopPropagation();
+    onClose();
+  }, [onClose]);
+
+  const isOrganization = author.type === PERSON_TYPE_ORGANIZATIONAL;
+  const hasAffiliations = author.affiliations && author.affiliations.length > 0;
+  const hasOrcid = Boolean(author.orcidId);
+  const hasProfileUrl = author.isActive && author.isPublic && author.publicUrl;
+  const hasDetails = hasAffiliations || hasOrcid;
+
+  return (
+    <div
+      ref={popoverRef}
+      aria-label={`Details for ${author.name}`}
+      className={styles.popover}
+      role="dialog"
+      style={position ? { top: position.top, left: position.left } : undefined}
+    >
+      <div className={styles.arrow} />
+
+      {/* Header: author name + close */}
+      <div className={styles.header}>
+        <div className={styles.headerContent}>
+          <h3 className={styles.authorName}>{author.name}</h3>
+        </div>
+        <button
+          aria-label="Close"
+          className={styles.closeButton}
+          type="button"
+          onClick={handleCloseClick}
+        >
+          <CancelIcon />
+        </button>
+      </div>
+
+      {/* Organization: separator + individual contributors text */}
+      {isOrganization && author.contributors && (
+        <>
+          <div className={styles.separator} />
+          <p className={styles.contributorsText}>Individual contributors: {author.contributors}</p>
+        </>
+      )}
+
+      {/* Individual: separator + detail list (affiliations, ORCID) */}
+      {!isOrganization && hasDetails && (
+        <>
+          <div className={styles.separator} />
+          <ul className={styles.detailList}>
+            {/* Affiliations */}
+            {(author.affiliations || []).map((aff) => (
+              <li key={aff.rorId || aff.name} className={styles.detailItem}>
+                <span className={`${styles.detailIcon} ${styles.institutionIcon}`}><InstitutionIcon /></span>
+                <span className={styles.detailText}>{aff.name}</span>
+              </li>
+            ))}
+
+            {/* ORCID */}
+            {hasOrcid && (
+              <li className={styles.detailItem}>
+                <span className={styles.detailIcon}><OrcidIcon /></span>
+                <a
+                  className={styles.detailLink}
+                  href={`${ORCID_URL_PREFIX}${author.orcidId}`}
+                  rel="noopener noreferrer"
+                  target="_blank"
+                >
+                  {author.orcidId}
+                </a>
+                <span className={styles.externalIcon}><GoToLinkIcon /></span>
+              </li>
+            )}
+          </ul>
+        </>
+      )}
+
+      {/* View author profile button — individuals only */}
+      {!isOrganization && hasProfileUrl && (
+        <a
+          className={styles.profileButton}
+          href={author.publicUrl!}
+          rel="noopener noreferrer"
+          target="_blank"
+        >
+          <span className={styles.profileButtonLabel}>View author profile</span>
+          <span className={styles.profileButtonIcon}><GoToLinkIcon /></span>
+        </a>
+      )}
+    </div>
+  );
+}
