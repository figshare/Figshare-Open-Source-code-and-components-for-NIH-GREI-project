+/* Wrapper for the author button + popover — keeps popover anchored to the button */
+.authorWrapper {
+  position: relative;
+
+  display: inline;
+}
+
+/* Dashed underline matching the item type trigger style (e.g. "Thesis") */
+.authorButton [data-part="button-label"] {
+  border-bottom: 1px dashed var(--color-border-tertiary);
+}
+
+/* Prevent the tertiary button's default text-decoration: underline on all states */
+.authorButton,
+.authorButton:hover,
+.authorButton:focus,
+.authorButton:focus-visible,
+.authorButton:active {
+  text-decoration: none !important;
+}
+
+/* When the popover is open, mimic the Tab focus-visible ring around the author button */
+.authorButtonOpen {
+  outline: none !important;
+  box-shadow: 0 0 0 2px #1e1e1e, 0 0 4px 2px #1e1e1e !important;
+}
