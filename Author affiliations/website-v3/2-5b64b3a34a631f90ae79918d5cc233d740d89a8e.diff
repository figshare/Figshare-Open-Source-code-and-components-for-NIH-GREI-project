+                  />
+                </div>
+              </div>
+            </form>
+          ) : (
+            <Form id={form.state.formId}>
+              <div className={styles.fields}>
+                {isEditing && (
+                  <Alert
+                    message={changeTypeMessage}
+                    persistent={true}
+                    type="info"
+                  />
+                )}
+
+                {!isEditing && !hideAuthorType && (
+                  <div className={styles.authorTypeSection}>
+                    <span className={styles.fieldLabel}>{fieldLabel} type</span>
+                    <div className={styles.radioGroup}>
+                      <Radio
+                        checked={authorType === "person"}
+                        label="Person"
+                        name="authorType"
+                        value="person"
+                        // eslint-disable-next-line react/jsx-no-bind
+                        onChange={() => setAuthorType("person")}
+                      />
+                      <Radio
+                        checked={authorType === "organization"}
+                        label="Organization"
+                        name="authorType"
+                        value="organization"
+                        // eslint-disable-next-line react/jsx-no-bind
+                        onChange={() => setAuthorType("organization")}
+                      />
+                    </div>
+                  </div>
+                )}
+
+                {/* First name + Last name in a 2-column row */}
+                <div className={styles.twoColumnRow}>
+                  <Field
+                    name="firstName"
+                    required={mandatoryAuthorFields?.includes("firstName")}
+                    validateOnBlur={true}
+                    component={TextFieldComponent}
+                  />
+                  <Field
+                    name="lastName"
+                    required={mandatoryAuthorFields?.includes("lastName")}
+                    validateOnBlur={true}
+                    component={TextFieldComponent}
+                  />
+                </div>
+
+                {/* Email */}
+                {renderEmailField()}
+
+                {/* ORCID iD */}
+                <Field
+                  name="orcidId"
+                  required={mandatoryAuthorFields?.includes("orcidId")}
+                  validateOnBlur={true}
+                  component={TextFieldComponent}
+                />
+
+                {/* Affiliations section */}
+                {renderAffiliationsSection()}
+              </div>
+            </Form>
+          )}
+        </FormContext.Provider>
+      </OverlayContent>
+
+      <OverlayFooter>
