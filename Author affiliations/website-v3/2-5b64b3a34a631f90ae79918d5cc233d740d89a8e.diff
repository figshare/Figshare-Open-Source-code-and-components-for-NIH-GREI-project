@@ -0,0 +1,55 @@
+import React, { useCallback } from "react";
+import { ListElementDropdown, ListElement } from "shared/ui/ListElementDropdown";
+
+import { getAuthorName } from "../../utils";
+
+
+interface Author {
+  id: number | string;
+  firstName?: string;
+  lastName?: string;
+  first_name?: string;
+  last_name?: string;
+}
+
+export type AuthorAction = "edit" | "moveUp" | "moveDown" | "moveToTop" | "moveToBottom" | "delete";
+
+interface AuthorActionMenuProps {
+  author: Author;
+  disabled?: boolean;
+  isFirst: boolean;
+  isLast: boolean;
+  onAction: (author: Author, action: AuthorAction) => void;
+}
+
+
+export function AuthorActionMenu({ author, disabled = false, isFirst, isLast, onAction }: AuthorActionMenuProps) {
+  const name = getAuthorName(author);
+
+  // Forward the selected action value back to the parent handler
+  const handleSelect = useCallback(({ value }: { value: AuthorAction }) => {
+    onAction(author, value);
+  }, [author, onAction]);
+
+  return (
+    <ListElementDropdown
+      id={`author-${author.id}-actions`}
+      toggle="more"
+      toggleTooltip={`More actions for ${name}`}
+      disabled={disabled}
+    >
+      <ListElement id={`author-${author.id}-edit`} value="edit" onSelect={handleSelect}>
+        Edit {name}
+      </ListElement>
+      <ListElement id={`author-${author.id}-move-top`} value="moveToTop" disabled={isFirst} onSelect={handleSelect}>
+        Move to top
+      </ListElement>
+      <ListElement id={`author-${author.id}-move-bottom`} value="moveToBottom" disabled={isLast} onSelect={handleSelect}>
+        Move to bottom
+      </ListElement>
+      <ListElement destructive={true} id={`author-${author.id}-delete`} value="delete" onSelect={handleSelect}>
+        Delete {name}
+      </ListElement>
+    </ListElementDropdown>
+  );
+}
