+import React from "react";
+import { render, cleanup, screen, fireEvent } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { TestScope } from "types/testing";
+
+import { AffiliationDropdown } from "./AffiliationDropdown";
+
+
+// Mock the loader to avoid pulling in the full contentBox tree
+jest.mock("../../contentBox", () => {
+  return { LoaderContentBox: () => <div data-testid="loader">Loading...</div> };
+});
+
+
+describe("<AffiliationDropdown />", () => {
+  function setup() {
+    const scope: TestScope = {
+      user: userEvent.setup(),
+      props: {
+        loading: false,
+        error: undefined,
+        results: [],
+        searchTerm: "",
+        hasMore: false,
+        onSelect: jest.fn(),
+        onLoadMore: jest.fn(),
+        onAddManually: jest.fn(),
+      },
+    };
+
+    scope.run = () => {
+      scope.wrapper = render(<AffiliationDropdown {...scope.props} />);
+    };
+
+    scope.rerender = () => {
+      scope.wrapper.rerender(<AffiliationDropdown {...scope.props} />);
+    };
+
+    return scope;
+  }
+
+  function teardown() {
+    cleanup();
+  }
+
+  // -- Empty and short search states --
+
+  it("shows hint text when searchTerm is empty", () => {
+    const scope = setup();
+    scope.run();
+
+    expect(screen.getByText("Start typing to search for an organization")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("shows custom emptyHint when provided and searchTerm is empty", () => {
+    const scope = setup();
+    scope.props.emptyHint = "Type to find your institution";
+    scope.run();
+
+    expect(screen.getByText("Type to find your institution")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("renders nothing when searchTerm is shorter than 3 characters", () => {
+    const scope = setup();
+    scope.props.searchTerm = "ab";
+    scope.run();
+
+    // Less than 3 chars → returns null, no DOM output
+    expect(scope.wrapper.container.innerHTML).toBe("");
+
+    teardown();
+  });
+
+  // -- Loading state --
+
+  it("shows loader when loading with no results yet", () => {
+    const scope = setup();
+    scope.props.searchTerm = "MIT";
+    scope.props.loading = true;
+    scope.run();
+
+    expect(screen.getByTestId("loader")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  // -- Error state --
+
+  it("shows error message when an error occurs", () => {
+    const scope = setup();
+    scope.props.searchTerm = "MIT";
+    scope.props.error = new Error("Network error");
+    scope.run();
+
+    expect(screen.getByText("Something went wrong. Please try again.")).toBeInTheDocument();
+    // Error message uses aria-live="assertive" for screen readers
+    expect(screen.getByRole("alert")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  // -- No results states --
+
+  it("shows 'Not on the list?' with add button when no results and no freeTextFallback", () => {
+    const scope = setup();
+    scope.props.searchTerm = "NonExistentOrg";
+    scope.run();
+
+    expect(screen.getByText("Not on the list?")).toBeInTheDocument();
+    expect(screen.getByText("Add a new organization")).toBeInTheDocument();
+
+    teardown();
+  });
+
