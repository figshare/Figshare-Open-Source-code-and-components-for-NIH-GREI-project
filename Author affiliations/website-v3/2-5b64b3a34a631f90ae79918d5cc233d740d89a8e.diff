+    setAuthorType(type);
+    setAffiliations(author?.affiliations ?? []);
+    setOrganizationName(author?.type === AUTHOR_TYPE_ORGANIZATION ? (author?.name ?? "") : "");
+    setOrgRorId(author?.type === AUTHOR_TYPE_ORGANIZATION ? (author?.rorId ?? undefined) : undefined);
