+
+  // Build validation rules with required checks for mandatory fields
+  const formValidation = useMemo(
+    () => buildAuthorFormValidation(mandatoryAuthorFields),
+    [mandatoryAuthorFields]
+  );
+
+  // eslint-disable-next-line arrow-body-style
+  const formMeta = useMemo(() => ({}), []);
+
+  const form = useForm({
+    schema: AUTHOR_PERSON_FORM_SCHEMA,
+    validation: formValidation,
+    data: initialFormData,
+    meta: formMeta,
+    persist: false,
+    sync: true,
+  });
+
+  // Reset form when the author being edited changes
+  useEffect(() => {
+    form.resetForm({
+      data: {
+        firstName: author?.firstName ?? "",
+        lastName: author?.lastName ?? "",
+        email: author?.email ?? "",
+        orcidId: author?.orcidId ?? "",
+      },
+    });
+  }, [author]); // eslint-disable-line
+
+
+  const handleSelectMatchingAuthor = useCallback((authorValue: Author) => {
+    onSelectMatchingAuthor(authorValue);
+    onClose();
+  }, [onSelectMatchingAuthor, onClose]);
+
+  const goBackToAddForm = useCallback(() => {
+    form.updateField("email", { value: "", error: undefined });
+    form.updateField("orcidId", { value: "", error: undefined });
+    setBackFromMatchingAuthors(true);
+  }, [form.updateField]);
+
+  // Affiliations from the author's figshare profile, excluding ones already added.
+  // Only shown when adding a new author (not editing an existing one).
+  const suggestedAffiliations = useMemo(() => {
+    if (isEditing) return [];
+    const profileAffs: Affiliation[] = author?.profileAffiliations ?? [];
+
+    return profileAffs.filter(
+      (suggested) => !affiliations.some((added) =>
+        (suggested.rorId && added.rorId === suggested.rorId) ||
+        (!suggested.rorId && !added.rorId && added.name.toLowerCase() === suggested.name.toLowerCase())
+      )
+    );
+  }, [isEditing, author?.profileAffiliations, affiliations]);
+
+  // Select an organization from the ROR dropdown for the org-name field
+  const handleSelectOrganization = useCallback((org: RorOrganization) => {
+    setOrganizationName(org.name);
+    setOrgRorId(org.rorId);
+    setOrganizationNameError(undefined);
+  }, []);
+
+  // Submit handler for organization type — validates and calls onSubmit directly.
+  // When editing, preserve the existing id so the parent can match the record.
+  const handleOrgSubmit = useCallback((e: React.FormEvent) => {
+    e.preventDefault();
+    if (!organizationName.trim()) {
+      setOrganizationNameError("Organization name is required");
+
+      return;
+    }
+    setOrganizationNameError(undefined);
+    const emailValue = getIn(form, "state.fields.email.value", "");
+    onSubmit({
+      type: AUTHOR_TYPE_ORGANIZATION,
+      ...(author?.userId ? { userId: author.userId } : {}),
+      name: organizationName.trim(),
+      rorId: orgRorId ?? null,
+      ...(emailValue ? { email: emailValue } : {}),
+      contributors: individualContributors.trim() || undefined,
+    });
+  }, [organizationName, orgRorId, individualContributors, onSubmit, form]);
+
+  const hasChanges = useMemo(() => {
+    if (authorType === "organization") {
+      if (organizationName !== (author?.name ?? "")) return true;
+      if (individualContributors !== (author?.contributors ?? "")) return true;
+
+      return false;
+    }
+
+    // Person: compare each form field against the original author value
+    const fields = form.state.fields ?? {};
+    for (const key of AUTHOR_PERSON_FORM_SCHEMA.order) {
+      const fieldValue = getIn(fields, `${key}.value`, "");
+      const authorValue = author?.[key] ?? "";
+      if (fieldValue !== authorValue) return true;
+    }
+
+    if (JSON.stringify(affiliations) !== JSON.stringify(author?.affiliations ?? [])) return true;
+
+    return false;
+  }, [authorType, organizationName, individualContributors, form.state.fields, affiliations, author]);
+
+  const onCloseOverlay = () => {
+    if (hasChanges) {
+      setIsConfirmationVisible(true);
+
+      return;
+    }
+
+    onClose();
+  };
+
+  const discardChanges = () => {
+    onDiscardChanges();
+    setIsConfirmationVisible(false);
+  };
+
+  // Person form submit — validates via useForm and collects values
+  const handlePersonSubmit = useCallback(() => {
+    const { valid } = form.validateForm({ at: "submit" });
+
+    if (!valid) {
+      return;
+    }
