+            disabled={isPreview}
+            theme="primary"
+            tooltip={isPreview ? `Cannot add or edit ${pluralizeLabel(fieldLabel)} in preview mode` : undefined}
+            onClick={isPreview ? noop : submitAuthorForm}
+          >
+            Save {fieldLabel.toLowerCase()}
+          </FclButton>
+        </OverlayFooter.Primary>
+      </OverlayFooter>
+
+    </>
+  );
+
+  const renderMatchedAuthors = () => (
+    <>
+      <OverlayHeader
+        description="The details you entered match registered user(s)."
+        title={`Matched ${pluralizeLabel(fieldLabel)}`}
+        onGoBack={goBackToAddForm}
+      />
+      <OverlayContent>
+        <UserList className={styles.matchedAuthorsList} onScrollToBottom={noop}>
+          {(matchedAuthors ?? []).map((user) => (
+            <UserListItem
+              key={user.id}
+              canReselect={false}
+              href={user.isPublic ? user.publicUrl : undefined}
+              info={[user.institutionName, user.email, user.orcidId]}
+              name={getAuthorName(user)}
+              selected={!!selectedAuthors?.find((v) => v.id === user.id)}
+              value={user}
+              variant="link"
+              onSelect={handleSelectMatchingAuthor}
+            />
+          ))}
+        </UserList>
+      </OverlayContent>
+      <OverlayFooter>
+        <OverlayFooter.Primary>
+          <FclButton theme="secondaryAlt" onClick={goBackToAddForm}>Close</FclButton>
+        </OverlayFooter.Primary>
+      </OverlayFooter>
+    </>
+  );
+
+  return (
+    <>
+      <Overlay
+        background="primary"
+        focusIn={true}
+        isVisible={isVisible}
+        returnFocus={!!isConfirmationVisible}
+        status={(matchedAuthors?.length ?? 0) > 0 && !backFromMatchingAuthors ? "matched" : "editor"}
+        variant="formModal"
+        onClose={onCloseOverlay}
+      >
+        <RenderSwitch value={(matchedAuthors?.length ?? 0) > 0 && !backFromMatchingAuthors}>
+          <RenderSwitch.Case key="author-form" value={false}>
+            {renderEditorForm()}
+          </RenderSwitch.Case>
+          <RenderSwitch.Case key="matching-users-list" value={true}>
+            {() => renderMatchedAuthors()}
+          </RenderSwitch.Case>
+        </RenderSwitch>
+      </Overlay>
+      <UnsavedChangesOverlay
+        id="author-editor"
+        isVisible={isConfirmationVisible}
+        onDiscard={discardChanges}
+        onKeep={() => setIsConfirmationVisible(false)}
+      />
+    </>
+  );
+}
+
+
+export { AuthorEditor };
+
+export default AuthorEditor;
