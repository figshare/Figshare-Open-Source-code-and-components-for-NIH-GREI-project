@@ -0,0 +1,131 @@
+import React from "react";
+import { render, cleanup, screen, fireEvent } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { TestScope } from "types/testing";
+
+import { AuthorActionMenu } from "./AuthorActionMenu";
+
+
+describe("<AuthorActionMenu />", () => {
+  function setup() {
+    const scope: TestScope = {
+      user: userEvent.setup(),
+      props: {
+        author: { id: 1, firstName: "John", lastName: "Doe" },
+        isFirst: false,
+        isLast: false,
+        onAction: jest.fn(),
+      },
+    };
+
+    scope.run = () => {
+      scope.wrapper = render(<AuthorActionMenu {...scope.props} />);
+    };
+
+    return scope;
+  }
+
+  function teardown() {
+    cleanup();
+  }
+
+  // Helper to open the dropdown — FCL ListElementDropdown renders a combobox toggle
+  async function openMenu(scope: TestScope) {
+    const toggle = screen.getByRole("combobox");
+    await scope.user.click(toggle);
+  }
+
+  it("renders the action menu toggle button", () => {
+    const scope = setup();
+    scope.run();
+
+    // ListElementDropdown renders a combobox toggle with "more" icon
+    expect(screen.getByRole("combobox")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("shows menu items when the toggle is clicked", async() => {
+    const scope = setup();
+    scope.run();
+
+    await openMenu(scope);
+
+    // All action options should be visible in the open menu
+    expect(screen.getByText("Edit John Doe")).toBeInTheDocument();
+    expect(screen.getByText("Move to top")).toBeInTheDocument();
+    expect(screen.getByText("Move to bottom")).toBeInTheDocument();
+    expect(screen.getByText("Delete John Doe")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("dispatches the edit action when Edit is clicked", async() => {
+    const scope = setup();
+    scope.run();
+
+    await openMenu(scope);
+    // Use fireEvent.click to avoid jsdom addRange bug on ListElement items
+    fireEvent.click(screen.getByText("Edit John Doe"));
+
+    // onAction receives the author object and the action string
+    expect(scope.props.onAction).toHaveBeenCalledWith(scope.props.author, "edit");
+
+    teardown();
+  });
+
+  it("dispatches the delete action when Delete is clicked", async() => {
+    const scope = setup();
+    scope.run();
+
+    await openMenu(scope);
+    fireEvent.click(screen.getByText("Delete John Doe"));
+
+    expect(scope.props.onAction).toHaveBeenCalledWith(scope.props.author, "delete");
+
+    teardown();
+  });
+
+  it("disables Move to top when the author is first", async() => {
+    const scope = setup();
+    scope.props.isFirst = true;
+    scope.run();
+
+    await openMenu(scope);
+
+    // Move to top should be disabled — ListElement uses data-element-disabled on the button
+    const moveToTop = screen.getByText("Move to top").closest("[role='menuitem']");
+    expect(moveToTop).toHaveAttribute("data-element-disabled", "true");
+
+    teardown();
+  });
+
+  it("disables Move to bottom when the author is last", async() => {
+    const scope = setup();
+    scope.props.isLast = true;
+    scope.run();
+
+    await openMenu(scope);
+
+    // Move to bottom should be disabled — same data attribute pattern as move to top
+    const moveToBottom = screen.getByText("Move to bottom").closest("[role='menuitem']");
+    expect(moveToBottom).toHaveAttribute("data-element-disabled", "true");
+
+    teardown();
+  });
+
+  it("uses snake_case name fields when camelCase ones are absent", async() => {
+    const scope = setup();
+    // Some authors come from the API with snake_case field names
+    // eslint-disable-next-line camelcase
+    scope.props.author = { id: 2, first_name: "Jane", last_name: "Smith" };
+    scope.run();
+
+    await openMenu(scope);
+
+    expect(screen.getByText("Edit Jane Smith")).toBeInTheDocument();
+    expect(screen.getByText("Delete Jane Smith")).toBeInTheDocument();
+
+    teardown();
+  });
+});
