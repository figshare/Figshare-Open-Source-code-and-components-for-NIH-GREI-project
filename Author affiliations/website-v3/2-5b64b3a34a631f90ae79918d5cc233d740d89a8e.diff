+import React, { useState, useCallback } from "react";
+import { Button } from "shared/ui/latest/Button";
+import PlusSvg from "@digital-science/figshare-fcl/icons/react/Plus";
+import { Alert } from "shared/ui/latest/Alert";
+import { DragDropContext, Droppable, Draggable } from "react-beautiful-dnd";
+import { AffiliationRow } from "pages/account/profileEdit/components/affiliations/AffiliationRow/AffiliationRow";
+
+import { type RorOrganization } from "../AffiliationDropdown/AffiliationDropdown";
+import { RorSearchField } from "../RorSearchField/RorSearchField";
+
+import styles from "./AffiliationsSelector.module.css";
+
+
+export interface Affiliation {
+  rorId?: string;
+  name: string;
+}
+
+interface AffiliationsSelectorProps {
+  /** Current list of affiliations — controlled by the parent. */
+  affiliations: Affiliation[];
+  /** Called whenever the list changes (add, remove, reorder). */
+  onChange: (affiliations: Affiliation[]) => void;
+  /** Optional suggested affiliations (e.g. from the author's profile) shown as quick-add links. */
+  suggestedAffiliations?: Affiliation[];
+  /** Unique droppable ID for react-beautiful-dnd (avoids collisions when multiple instances exist). */
+  droppableId?: string;
+}
+
+
+export function AffiliationsSelector({
+  affiliations,
+  onChange,
+  suggestedAffiliations = [],
+  droppableId = "affiliations-selector",
+}: AffiliationsSelectorProps) {
+  const [isSearching, setIsSearching] = useState(false);
+  const [showDuplicateAlert, setShowDuplicateAlert] = useState(false);
+
+  // Check if an affiliation is already in the list by rorId or case-insensitive name
+  const isDuplicate = useCallback((affiliation: Affiliation) => affiliations.some((a) =>
+    (affiliation.rorId && a.rorId === affiliation.rorId) ||
+      (!affiliation.rorId && !a.rorId && a.name.toLowerCase() === affiliation.name.toLowerCase())
+  ), [affiliations]);
+
+  // Add a suggested affiliation from the profile quick-add links
+  const addSuggested = useCallback((affiliation: Affiliation) => {
+    if (isDuplicate(affiliation)) {
+      setShowDuplicateAlert(true);
+
+      return;
+    }
+    setShowDuplicateAlert(false);
+    onChange([...affiliations, affiliation]);
+  }, [isDuplicate, affiliations, onChange]);
+
+  // Select from ROR dropdown — add affiliation and close search
+  const handleSelect = useCallback((org: RorOrganization) => {
+    if (isDuplicate({ rorId: org.rorId, name: org.name })) {
+      setShowDuplicateAlert(true);
+      setIsSearching(false);
+
+      return;
+    }
+    setShowDuplicateAlert(false);
+    onChange([...affiliations, { rorId: org.rorId, name: org.name }]);
+    setIsSearching(false);
+  }, [isDuplicate, affiliations, onChange]);
+
+  // Add the current search term as a manual affiliation (no ROR id)
+  const handleAddManually = useCallback((term: string) => {
+    if (term) {
+      if (isDuplicate({ name: term })) {
+        setShowDuplicateAlert(true);
+        setIsSearching(false);
+
+        return;
+      }
+      setShowDuplicateAlert(false);
+      onChange([...affiliations, { name: term }]);
+    }
+    setIsSearching(false);
+  }, [isDuplicate, affiliations, onChange]);
+
+  const handleCancelSearch = useCallback(() => {
+    setIsSearching(false);
+  }, []);
+
+  const removeAffiliation = useCallback((index: number) => {
+    onChange(affiliations.filter((_, i) => i !== index));
+  }, [affiliations, onChange]);
+
+  const handleReorder = useCallback((index: number, direction: "up" | "down") => {
+    const next = [...affiliations];
+    const targetIndex = direction === "up" ? index - 1 : index + 1;
+
+    if (targetIndex < 0 || targetIndex >= next.length) return;
+    [next[index], next[targetIndex]] = [next[targetIndex], next[index]];
+    onChange(next);
+  }, [affiliations, onChange]);
+
+  const handleDragEnd = useCallback((result: { source: { index: number }; destination?: { index: number } | null }) => {
+    if (!result.destination || result.source.index === result.destination.index) return;
+    const next = [...affiliations];
+    const [moved] = next.splice(result.source.index, 1);
+    next.splice(result.destination!.index, 0, moved);
+    onChange(next);
+  }, [affiliations, onChange]);
+
+  return (
+    <div className={styles.container}>
+      <span className={styles.title}>Affiliations</span>
+
+      {showDuplicateAlert && (
+        <Alert
+          className={styles.compactAlert}
+          message="This affiliation is already in your list."
+          persistent={false}
+          type="info"
+          onClose={() => setShowDuplicateAlert(false)}
+        />
+      )}
+
+      {/* Quick-add links for affiliations from the author's profile */}
+      {suggestedAffiliations.length > 0 && (
+        <p className={styles.suggestedAffiliations}>
+          <span className={styles.suggestedLabel}>Suggested from profile: </span>
+          {suggestedAffiliations.map((affiliation, i) => (
+            <React.Fragment key={affiliation.name ?? i}>
+              {i > 0 && <span>, </span>}
+              {/* eslint-disable-next-line react/jsx-no-bind */}
+              <button
+                className={styles.suggestionLink}
+                type="button"
+                onClick={() => addSuggested(affiliation)}
+              >
+                Add {affiliation.name}
+              </button>
+            </React.Fragment>
+          ))}
+        </p>
+      )}
+
+      {/* Already-added affiliations — orderable drag-and-drop list */}
+      {affiliations.length > 0 && (
+        <DragDropContext onDragEnd={handleDragEnd}>
+          <Droppable droppableId={droppableId} isDropDisabled={affiliations.length <= 1}>
+            {(provided) => (
+              <div ref={provided.innerRef} className={styles.affiliationsList} {...provided.droppableProps}>
+                {affiliations.map((affiliation, i) => (
+                  <Draggable
+                    key={affiliation.rorId || affiliation.name}
+                    draggableId={affiliation.rorId || affiliation.name}
+                    index={i}
+                    isDragDisabled={affiliations.length <= 1}
+                  >
+                    {(item) => (
+                      <div ref={item.innerRef} {...item.draggableProps}>
+                        <AffiliationRow
+                          affiliation={affiliation}
+                          dragHandleProps={item.dragHandleProps}
+                          isFirst={i === 0}
+                          isLast={i === affiliations.length - 1}
+                          reorderable={affiliations.length > 1}
+                          // eslint-disable-next-line react/jsx-no-bind
+                          onDelete={() => removeAffiliation(i)}
+                          // eslint-disable-next-line react/jsx-no-bind
+                          onMoveDown={() => handleReorder(i, "down")}
+                          // eslint-disable-next-line react/jsx-no-bind
+                          onMoveUp={() => handleReorder(i, "up")}
+                        />
+                      </div>
+                    )}
+                  </Draggable>
+                ))}
+                {provided.placeholder}
+              </div>
+            )}
+          </Droppable>
+        </DragDropContext>
+      )}
+
+      {/* Search input + dropdown — shown after clicking the button */}
+      {isSearching ? (
+        /*
+         * FCL Dropdown + Toggle + Menu: Menu uses Popper with strategy="fixed" and
+         * autoAdjust=true (flip modifier) so it escapes the overlay's overflow/transform
+         * and automatically flips above when there's not enough space below.
+         */
+        <RorSearchField
+          onAddManually={handleAddManually}
+          onCancel={handleCancelSearch}
+          onSelect={handleSelect}
+        />
+      ) : (
+        // eslint-disable-next-line react/jsx-no-bind
+        <Button className={styles.addButton} kind="tertiary" onClick={() => setIsSearching(true)}>
+          <Button.Icon><PlusSvg /></Button.Icon>
+          <Button.Label>Add new affiliation</Button.Label>
+        </Button>
+      )}
+    </div>
+  );
+}
