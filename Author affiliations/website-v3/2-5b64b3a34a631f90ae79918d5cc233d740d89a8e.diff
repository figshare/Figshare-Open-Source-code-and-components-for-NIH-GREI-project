+/* Dropdown container — matches the demo dropdown CSS */
+.container {
+  display: flex;
+  overflow: hidden; /* list scrolls independently; footer stays pinned at bottom */
+  flex-direction: column;
+
+  box-sizing: border-box;
+  width: 100%;
+  max-height: calc(60 * var(--gridSize)); /* 360px */
+
+  margin: var(--gridSize) 0;           /* 6px gap from the search input */
+  padding: var(--gridSize) 0;          /* 6px inner breathing room top/bottom */
+
+  border: 1px solid var(--color-border-primary, #ddd);
+  border-radius: var(--gridSize);      /* 6px */
+  background: var(--color-layout-primary-background, #fff);
+  box-shadow: 0 1px var(--gridSize) rgba(0, 0, 0, 0.21);
+}
+
+/* Hint text — empty state, error, no-results */
+.hint {
+  font-family: var(--fontFamily);
+  font-size: var(--typography-M-fontSize);  /* 16px */
+  font-weight: 400;
+  line-height: var(--typography-M-lineHeight); /* 24px */
+
+  display: flex;
+  flex-direction: column;
+
+  margin: 0;
+
+  padding: 20px 16px;
+
+  text-align: center;
+
+  color: var(--color-typography-primary, #252525);
+  align-items: center;
+  gap: 12px;
+}
+
+/* Results list */
+.list {
+  overflow-y: auto;
+
+  width: 100%;
+  margin: 0;
+  padding: 0;
+
+  list-style: none;
+  flex: 1;
+}
+
+/* Each result row — mirrors profileEdit OrganizationList.resultItem */
+.item {
+  /* Reset FCL global a,button styles (normalize.css) */
+  font-family: var(--fontFamily);
+
+  display: flex;
+  flex-direction: column;
+
+  width: 100%;
+  padding: calc(2 * var(--gridSize)) calc(3 * var(--gridSize)); /* 12px 18px */
+
+  cursor: pointer;
+  text-align: left;
+  text-decoration: none;
+
+  color: inherit;
+  border: none;
+  background: var(--color-layout-primary-background, #fff);
+  justify-content: center;
+  align-items: flex-start;
+  gap: calc(0.5 * var(--gridSize)); /* 3px between name and URL */
+  align-self: stretch;
+}
+
+.item:hover,
+.item:focus {
+  text-decoration: none;
+
+  color: inherit;
+
+  /* Reset FCL global *:focus box-shadow */
+  border-radius: 0;
+  outline: none;
+  background: var(--color-layout-secondary-background, #f5f5f5);
+  box-shadow: none;
+}
+
+.item:focus-visible {
+  box-shadow: inset 0 0 0 2px var(--color-typography-primary);
+}
+
+/* Organization name */
+.itemName {
+  font-family: var(--fontFamily);
+  font-size: var(--typography-M-fontSize);
+  font-weight: 400;
+  line-height: var(--typography-M-lineHeight);
+
+  color: var(--color-typography-primary, #252525);
+  align-self: stretch;
+}
+
+/* ROR full URL shown below the name */
+.itemId {
+  font-family: var(--fontFamily);
+  font-size: var(--typography-S-fontSize, 14px);
+  font-weight: 400;
+  line-height: var(--typography-S-lineHeight, 24px);
+
+  color: var(--color-typography-secondary, #464646);
+  align-self: stretch;
+}
+
+/* ── "Not on the list?" footer — mirrors profileEdit SearchDropdown ── */
+
+.separator {
+  display: flex;
+  flex-direction: column;
+
+  width: 100%;
+  padding: var(--gridSize) 0;
+  align-items: flex-start;
+  align-self: stretch;
+}
+
+.separatorLine {
+  width: 100%;
+  height: 1px;
+
+  background: var(--color-border-primary, #ddd);
+}
+
+.footer {
+  display: flex;
+  flex-direction: row;
+
+  width: 100%;
+  padding: calc(2 * var(--gridSize)) calc(3 * var(--gridSize)); /* 12px 18px */
+
+  background: var(--color-layout-primary-background, #fff);
+  justify-content: center;
+  align-items: center;
+  gap: calc(2 * var(--gridSize)); /* 12px */
+  align-self: stretch;
+}
+
+.footerText {
+  font-family: var(--fontFamily);
+  font-size: var(--typography-M-fontSize);
+  font-weight: 400;
+  line-height: var(--typography-M-lineHeight);
+
+  color: var(--color-typography-secondary, #464646);
+}
+
+/* "Use X as free text" option — same style as .item (ROR result row) */
+.freeTextOption {
+  composes: item;
+
+  color: var(--color-typography-secondary, #464646);
+}
