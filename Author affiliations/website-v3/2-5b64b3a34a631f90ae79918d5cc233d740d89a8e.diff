+        content: (
+          <>
+            <span>{submitError}</span>
+            <br />
+            <GenericButton href="mailto:support@figshare.com?subject=Report incorrect author">
+              Please contact support.
+            </GenericButton>
+          </>
+        ),
+      });
+    }
+  }, [isVisible, submitError]);
+
+  // ── Render helpers ─────────────────────────────────────────
+
+  // Email field — uses Field's render-prop to customize with disabled state
+  const renderEmailField = () => (
+    <Field
+      name="email"
+      required={mandatoryAuthorFields?.includes("email")}
+      validateOnBlur={true}
+      component={TextFieldComponent}
+    />
+  );
+
+  const renderAffiliationsSection = () => (
+    <div className={styles.affiliationsSection}>
+      <AffiliationsSelector
+        affiliations={affiliations}
+        droppableId="author-affiliations"
+        suggestedAffiliations={suggestedAffiliations}
+        onChange={handleAffiliationsChange}
+      />
+    </div>
+  );
+
+  const article = /^[aeiou]/i.test(fieldLabel) ? "an" : "a";
+  const changeTypeMessage =
+    `To change ${article} ${fieldLabel.toLowerCase()} type (person or organization), ` +
+    `remove this ${fieldLabel.toLowerCase()} and add them again.`;
+
+  const renderEditorForm = () => (
+    <>
+      <OverlayHeader
+        className={styles.header}
+        description={`These details will be saved with this item when you publish, but won't change the ${fieldLabel.toLowerCase()}'s main profile.`}
+        title={isEditing ? `Edit ${fieldLabel.toLowerCase()} (${authorType})` : `Add ${fieldLabel.toLowerCase()}`}
+      />
+
+      <OverlayContent className={styles.content}>
+        {/* Alerts render only when present — sits at top of scrollable body */}
+        <Alerts id="edit-author-alerts" />
+
+        <FormContext.Provider value={form}>
+          {/* Organization type still uses a native form for its own submit handler */}
+          {authorType === "organization" ? (
+            <form
+              className={styles.fullWidth}
+              data-id="author-editor-form-element"
+              noValidate={true}
+              onSubmit={handleOrgSubmit}
+            >
+              <div className={styles.fields}>
+                {isEditing && (
+                  <Alert
+                    message={changeTypeMessage}
+                    persistent={true}
+                    type="info"
+                  />
+                )}
+
+                {!isEditing && !hideAuthorType && (
+                  <div className={styles.authorTypeSection}>
+                    <span className={styles.fieldLabel}>{fieldLabel} type</span>
+                    <div className={styles.radioGroup}>
+                      <Radio
+                        checked={authorType === "person"}
+                        label="Person"
+                        name="authorType"
+                        value="person"
+                        // eslint-disable-next-line react/jsx-no-bind
+                        onChange={() => setAuthorType("person")}
+                      />
+                      <Radio
+                        checked={authorType === "organization"}
+                        label="Organization"
+                        name="authorType"
+                        value="organization"
+                        // eslint-disable-next-line react/jsx-no-bind
+                        onChange={() => setAuthorType("organization")}
+                      />
+                    </div>
+                  </div>
+                )}
+
+                {/* Organization name — ROR search with manual fallback */}
+                <div className={styles.fieldGroup}>
+                  <label className={styles.fieldLabel} htmlFor="organizationName">
+                    Organization name
+                    <span aria-hidden="true" className={styles.requiredMark}>*</span>
+                  </label>
+
+                  <RorSearchField
+                    emptyHint="Start typing to search the ROR registry"
+                    freeTextFallback={true}
+                    showOnFocus={true}
+                    value={organizationName}
+                    // eslint-disable-next-line react/jsx-no-bind
