+    const { fields } = form.state;
+    const submitted: Record<string, unknown> = {};
+
+    for (const key of AUTHOR_PERSON_FORM_SCHEMA.order) {
+      const value = getIn(fields, `${key}.value`, "");
+      if (value !== undefined && value !== "") {
+        submitted[key] = value;
+      }
+    }
+
+    // Carry userId through so the parent can match the entry in the list
+    if (author?.userId !== undefined) {
+      submitted.userId = author.userId;
+    }
