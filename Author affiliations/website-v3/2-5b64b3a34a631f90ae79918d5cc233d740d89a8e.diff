+import { RorSearchField } from "./RorSearchField/RorSearchField";
+import styles from "./authorEditor.css";
+import { AUTHOR_PERSON_FORM_SCHEMA, buildAuthorFormValidation } from "./constants";
+
+
+export const AUTHOR_TYPE_PERSON = 1;
+export const AUTHOR_TYPE_ORGANIZATION = 2;
+
+
+interface Affiliation {
+  rorId?: string;
+  name: string;
+}
+
+interface Author {
+  id?: number | string;
+  userId?: number;
+  authorType?: "person" | "organization";
+  name?: string; // org authors use this instead of firstName/lastName
+  rorId?: string; // ROR identifier for organization authors
+  firstName?: string;
+  lastName?: string;
+  email?: string;
+  orcidId?: string;
+  publicUrl?: string;
+  isPublic?: boolean;
+  affiliations?: Affiliation[];
+  profileAffiliations?: Affiliation[];
+  institutionName?: string;
+  contributors?: string;
+  [key: string]: unknown;
+}
+
+interface AuthorEditorProps {
+  isVisible: boolean;
+  isEditing?: boolean;
+  hideAuthorType?: boolean;
+  onClose: () => void;
+  onDiscardChanges: () => void;
+  onSubmit: (author: Record<string, unknown>) => void;
+  onSelectMatchingAuthor: (author: Author) => void;
+  author?: Author;
+  mandatoryAuthorFields?: string[];
+  matchedAuthors?: Author[];
+  selectedAuthors?: Author[];
+  fieldLabel?: string;
+  submitError?: string;
+}
+
+
+function AuthorEditor({
+  isVisible,
+  isEditing,
+  hideAuthorType = false,
+  author, onClose, onDiscardChanges, onSubmit, matchedAuthors,
+  selectedAuthors, onSelectMatchingAuthor, fieldLabel = "Author", submitError, mandatoryAuthorFields,
+}: AuthorEditorProps) {
+  const [isConfirmationVisible, setIsConfirmationVisible] = useState(false);
+
+  // Per-item author settings — not part of the author's global figshare profile
+  const [affiliations, setAffiliations] = useState<Affiliation[]>(author?.affiliations ?? []);
+
+  // Author type selector — only relevant when adding (not editing)
+  const [authorType, setAuthorType] = useState<"person" | "organization">("person");
+
+  // Organization-specific fields
+  const [organizationName, setOrganizationName] = useState("");
+  const [organizationNameError, setOrganizationNameError] = useState<string | undefined>();
+  const [individualContributors, setIndividualContributors] = useState("");
+
+  // Affiliation change handler — passed to AffiliationsSelector
+  const handleAffiliationsChange = useCallback((newAffiliations: Affiliation[]) => {
+    setAffiliations(newAffiliations);
+  }, []);
+
+  // Organization name — stored rorId from ROR search selection
+  const [orgRorId, setOrgRorId] = useState<string | undefined>();
+
+  const [backFromMatchingAuthors, setBackFromMatchingAuthors] = useState(false);
+  const previewContext = useContext(EditPreviewContext);
+  const isPreview = previewContext?.isPreview;
+
+
+  // Sync per-item state when the author being edited changes.
+  // For org authors, seed the org-specific fields from the author object.
+  useEffect(() => {
