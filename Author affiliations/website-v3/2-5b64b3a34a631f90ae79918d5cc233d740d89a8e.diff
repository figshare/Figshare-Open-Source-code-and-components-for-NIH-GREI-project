@@ -0,0 +1,78 @@
+import { personListToAuthors, getEntityAuthors, formatAuthorCitationName } from "./personList";
+
+
+describe("personListToAuthors", () => {
+  it("maps account, ghost and organization users to the legacy author shape, in order", () => {
+    const entries = [
+      {
+        type: 1, userId: 5, firstName: "Jane", lastName: "Smith", name: "Jane Smith",
+        isActive: true, isPublic: true, publicUrl: "https://figshare.com/authors/Jane_Smith/5",
+      },
+      { type: 1, userId: 6, firstName: "John", lastName: "Doe", name: "John Doe" },
+      { type: 2, userId: 7, name: "Wellcome Sanger Institute", rorId: "05cy4wa09" },
+    ];
+
+    expect(personListToAuthors(entries)).toEqual([
+      {
+        id: 5, type: 1, name: "Jane Smith", firstName: "Jane", lastName: "Smith",
+        isActive: true, isPublic: true, publicUrl: "https://figshare.com/authors/Jane_Smith/5",
+      },
+      {
+        id: 6, type: 1, name: "John Doe", firstName: "John", lastName: "Doe",
+        isActive: false, isPublic: false, publicUrl: null,
+      },
+      {
+        id: 7, type: 2, name: "Wellcome Sanger Institute", firstName: "", lastName: "",
+        isActive: false, isPublic: false, publicUrl: null,
+      },
+    ]);
+  });
+
+  it("builds the name from its parts when the entry has none", () => {
+    expect(personListToAuthors([{ type: 1, userId: 6, lastName: "Doe" }])[0].name).toBe("Doe");
+  });
+
+  it("returns an empty list for a missing value", () => {
+    expect(personListToAuthors(null)).toEqual([]);
+    expect(personListToAuthors(undefined)).toEqual([]);
+  });
+});
+
+describe("getEntityAuthors", () => {
+  const legacyAuthors = [{ id: 1, name: "Legacy Author" }];
+
+  it("reads the authors person_list field when the entity has one (ITBM)", () => {
+    const itemTypeFields = [
+      { name: "title", value: "A title" },
+      { name: "authors", value: [{ type: 1, userId: 7, firstName: "Jane", lastName: "Smith", name: "Jane Smith" }] },
+    ];
+
+    expect(getEntityAuthors(legacyAuthors, itemTypeFields).map((author) => author.id)).toEqual([7]);
+  });
+
+  it("returns no authors for an ITBM entity with an empty authors field", () => {
+    expect(getEntityAuthors(legacyAuthors, [{ name: "authors", value: null }])).toEqual([]);
+  });
+
+  it("keeps the legacy authors when there's no authors field (non-ITBM)", () => {
+    expect(getEntityAuthors(legacyAuthors, [])).toBe(legacyAuthors);
+    expect(getEntityAuthors(legacyAuthors, undefined)).toBe(legacyAuthors);
+    expect(getEntityAuthors(undefined, undefined)).toEqual([]);
+  });
+});
+
+describe("formatAuthorCitationName", () => {
+  it("formats people as family, given", () => {
+    expect(formatAuthorCitationName({ type: 1, firstName: "Jane", lastName: "Smith" })).toBe("Smith, Jane");
+    expect(formatAuthorCitationName({ firstName: "Jane", lastName: "Smith" }, ",")).toBe("Smith,Jane");
+  });
+
+  it("uses the family name alone when there's no given name", () => {
+    expect(formatAuthorCitationName({ type: 1, firstName: "", lastName: "Smith" })).toBe("Smith");
+  });
+
+  it("uses the name for organizations", () => {
+    expect(formatAuthorCitationName({ type: 2, name: "Wellcome Sanger Institute", lastName: "" })).
+      toBe("Wellcome Sanger Institute");
+  });
+});
