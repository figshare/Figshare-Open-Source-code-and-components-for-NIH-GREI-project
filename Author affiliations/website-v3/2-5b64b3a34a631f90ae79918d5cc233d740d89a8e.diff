+
+// Base validation rules — format checks that always apply
+const BASE_VALIDATION = {
+  firstName: [{
+    at: ["blur:touched", "submit"],
+    type: "compoundValidation",
+    withResults: true,
+    fn: (value) => {
+      if (value && value.length > 255) {
+        return { valid: false, message: "The first name cannot be longer than 255 characters." };
+      }
+
+      return undefined;
+    },
+  }],
+  lastName: [{
+    at: ["blur:touched", "submit"],
+    type: "compoundValidation",
+    withResults: true,
+    fn: (value) => {
+      if (value && value.length > 255) {
+        return { valid: false, message: "The last name cannot be longer than 255 characters." };
+      }
+
+      return undefined;
+    },
+  }],
+  email: [{
+    at: ["blur:touched", "submit"],
+    type: "compoundValidation",
+    withResults: true,
+    fn: (value) => {
+      const trimmed = value?.trim();
+
+      if (trimmed && !isEmail(trimmed)) {
+        return {
+          valid: false,
+          message: "Please enter a valid email address that contains only ASCII characters and a domain extension of at least 2 characters.",
+        };
+      }
+
+      return undefined;
+    },
+  }],
+  orcidId: [{
+    at: ["blur:touched", "submit"],
+    type: "compoundValidation",
+    withResults: true,
+    fn: (value) => {
+      const trimmed = value?.trim();
+
+      if (trimmed && !isOrcid(trimmed)) {
+        return { valid: false, message: "Please add a valid ORCID." };
+      }
+
+      return undefined;
+    },
+  }],
+};
+
+// Required-check rules — prepended for fields listed in mandatoryAuthorFields
+const REQUIRED_RULES = {
+  firstName: {
+    at: ["blur:touched", "submit"],
+    type: "compoundValidation",
+    withResults: true,
+    fn: (value) => {
+      if (!value?.trim()) {
+        return { valid: false, message: "The first name is mandatory for adding authors." };
+      }
+
+      return undefined;
+    },
+  },
+  lastName: {
+    at: ["blur:touched", "submit"],
+    type: "compoundValidation",
+    withResults: true,
+    fn: (value) => {
+      if (!value?.trim()) {
+        return { valid: false, message: "The last name is mandatory for adding authors." };
+      }
+
+      return undefined;
+    },
+  },
+  email: {
+    at: ["blur:touched", "submit"],
+    type: "compoundValidation",
+    withResults: true,
+    fn: (value) => {
+      if (!value?.trim()) {
+        return { valid: false, message: "The email address is mandatory for adding authors" };
+      }
+
+      return undefined;
+    },
+  },
+  orcidId: {
+    at: ["blur:touched", "submit"],
+    type: "compoundValidation",
+    withResults: true,
+    fn: (value) => {
+      if (!value?.trim()) {
+        return { valid: false, message: "The ORCID is mandatory for adding authors." };
+      }
+
+      return undefined;
+    },
+  },
 };
 
+// Build validation with required rules prepended for mandatory fields
+function buildAuthorFormValidation(mandatoryAuthorFields = []) {
+  const validation = {};
+
+  for (const fieldId of AUTHOR_PERSON_FORM_SCHEMA.order) {
+    const rules = [...BASE_VALIDATION[fieldId]];
+
+    if (mandatoryAuthorFields.includes(fieldId)) {
+      rules.unshift(REQUIRED_RULES[fieldId]);
+    }
+
+    validation[fieldId] = rules;
+  }
+
+  return validation;
+}
+
+
 export {
   authorEditorFormFields,
   authorEditorFieldValidations,
   authorEditorRequiredFieldValidations,
   authorEditorFormConfig,
+  AUTHOR_PERSON_FORM_SCHEMA,
+  buildAuthorFormValidation,
 };
