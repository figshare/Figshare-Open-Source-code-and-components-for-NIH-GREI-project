+import React from "react";
+import { render, cleanup, screen, fireEvent } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { TestScope } from "types/testing";
+
+import { AffiliationsSelector, type Affiliation } from "./AffiliationsSelector";
+
+
+// Mock RorSearchField — simulates search, select, add-manually, and cancel actions
+jest.mock("../RorSearchField/RorSearchField", () => {
+  return {
+    RorSearchField: ({ onSelect, onAddManually, onCancel }: any) => (
+      <div data-testid="ror-search">
+        <button data-testid="ror-select" onClick={() => onSelect({ rorId: "041nk4h34", name: "MIT" })}>
+          Select MIT
+        </button>
+        <button data-testid="ror-add-manual" onClick={() => onAddManually("Custom Org")}>
+          Add Manual
+        </button>
+        <button data-testid="ror-cancel" onClick={onCancel}>Cancel</button>
+      </div>
+    ),
+  };
+});
+
+// Mock AffiliationRow — renders name + action buttons for each affiliation
+jest.mock("pages/account/profileEdit/components/affiliations/AffiliationRow/AffiliationRow", () => {
+  return {
+    AffiliationRow: ({ affiliation, onDelete, onMoveUp, onMoveDown, isFirst, isLast }: any) => (
+      <div data-testid={`affiliation-row-${affiliation.name}`}>
+        <span>{affiliation.name}</span>
+        <button data-testid={`delete-${affiliation.name}`} onClick={onDelete}>Delete</button>
+        <button data-testid={`move-up-${affiliation.name}`} disabled={isFirst} onClick={onMoveUp}>Up</button>
+        <button data-testid={`move-down-${affiliation.name}`} disabled={isLast} onClick={onMoveDown}>Down</button>
+      </div>
+    ),
+  };
+});
+
+
+describe("<AffiliationsSelector />", () => {
+  function setup() {
+    const scope: TestScope = {
+      user: userEvent.setup(),
+      props: {
+        affiliations: [] as Affiliation[],
+        onChange: jest.fn(),
+        suggestedAffiliations: [],
+      },
+    };
+
+    scope.run = () => {
+      scope.wrapper = render(<AffiliationsSelector {...scope.props} />);
+    };
+
+    scope.rerender = () => {
+      scope.wrapper.rerender(<AffiliationsSelector {...scope.props} />);
+    };
+
+    return scope;
+  }
+
+  function teardown() {
+    cleanup();
+  }
+
+  // -- Basic rendering --
+
+  it("renders the 'Affiliations' title and 'Add new affiliation' button", () => {
+    const scope = setup();
+    scope.run();
+
+    expect(screen.getByText("Affiliations")).toBeInTheDocument();
+    expect(screen.getByText("Add new affiliation")).toBeInTheDocument();
+    // Search field should not be visible initially
+    expect(screen.queryByTestId("ror-search")).not.toBeInTheDocument();
+
+    teardown();
+  });
+
+  // -- Suggested affiliations --
+
+  it("shows suggested affiliations when provided", () => {
+    const scope = setup();
+    scope.props.suggestedAffiliations = [
+      { name: "Harvard" },
+      { name: "Stanford" },
+    ];
+    scope.run();
+
+    expect(screen.getByText("Suggested from profile:")).toBeInTheDocument();
+    expect(screen.getByText("Add Harvard")).toBeInTheDocument();
+    expect(screen.getByText("Add Stanford")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("clicking a suggested affiliation calls onChange with it appended", () => {
+    const scope = setup();
+    scope.props.suggestedAffiliations = [{ name: "Harvard", rorId: "abc123" }];
+    scope.run();
+
+    // fireEvent.click avoids jsdom addRange bug with FCL Button
+    fireEvent.click(screen.getByText("Add Harvard"));
+
+    // Should append the suggested affiliation to the existing (empty) list
+    expect(scope.props.onChange).toHaveBeenCalledWith([{ name: "Harvard", rorId: "abc123" }]);
+
+    teardown();
+  });
+
+  // -- Search mode --
+
+  it("clicking 'Add new affiliation' shows the RorSearchField", () => {
+    const scope = setup();
+    scope.run();
+
+    // fireEvent.click avoids jsdom addRange bug with FCL Button
+    fireEvent.click(screen.getByText("Add new affiliation"));
+
+    expect(screen.getByTestId("ror-search")).toBeInTheDocument();
+    // The add button should be replaced by the search field
+    expect(screen.queryByText("Add new affiliation")).not.toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("selecting from ROR search calls onChange with new affiliation", () => {
+    const scope = setup();
+    scope.run();
+
+    // Enter search mode, then select MIT from the mocked results
+    // fireEvent.click avoids jsdom addRange bug with FCL Button
+    fireEvent.click(screen.getByText("Add new affiliation"));
+    // fireEvent.click avoids jsdom addRange bug with FCL Button
+    fireEvent.click(screen.getByTestId("ror-select"));
+
+    expect(scope.props.onChange).toHaveBeenCalledWith([{ rorId: "041nk4h34", name: "MIT" }]);
+
+    teardown();
+  });
+
+  it("adding manually calls onChange with name-only affiliation", () => {
+    const scope = setup();
+    scope.run();
+
+    // fireEvent.click avoids jsdom addRange bug with FCL Button
+    fireEvent.click(screen.getByText("Add new affiliation"));
+    // fireEvent.click avoids jsdom addRange bug with FCL Button
+    fireEvent.click(screen.getByTestId("ror-add-manual"));
+
+    expect(scope.props.onChange).toHaveBeenCalledWith([{ name: "Custom Org" }]);
+
+    teardown();
+  });
+
+  it("canceling search hides the RorSearchField", () => {
+    const scope = setup();
+    scope.run();
+
+    // fireEvent.click avoids jsdom addRange bug with FCL Button
+    fireEvent.click(screen.getByText("Add new affiliation"));
+    expect(screen.getByTestId("ror-search")).toBeInTheDocument();
+
+    // fireEvent.click avoids jsdom addRange bug with FCL Button
+    fireEvent.click(screen.getByTestId("ror-cancel"));
+
+    // Back to the add button
+    expect(screen.queryByTestId("ror-search")).not.toBeInTheDocument();
+    expect(screen.getByText("Add new affiliation")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  // -- Existing affiliations --
+
+  it("renders AffiliationRow for each existing affiliation", () => {
+    const scope = setup();
+    scope.props.affiliations = [
+      { rorId: "abc", name: "MIT" },
+      { name: "Harvard" },
+    ];
+    scope.run();
+
+    expect(screen.getByTestId("affiliation-row-MIT")).toBeInTheDocument();
+    expect(screen.getByTestId("affiliation-row-Harvard")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("delete button removes an affiliation from the list", () => {
+    const scope = setup();
+    scope.props.affiliations = [
+      { rorId: "abc", name: "MIT" },
+      { name: "Harvard" },
+    ];
+    scope.run();
+
+    // fireEvent.click avoids jsdom addRange bug with FCL Button
+    fireEvent.click(screen.getByTestId("delete-MIT"));
+
+    // onChange called with the remaining affiliation only
+    expect(scope.props.onChange).toHaveBeenCalledWith([{ name: "Harvard" }]);
+
+    teardown();
+  });
+
+  it("move-up reorders affiliations correctly", () => {
+    const scope = setup();
+    scope.props.affiliations = [
+      { name: "First" },
+      { name: "Second" },
+      { name: "Third" },
+    ];
+    scope.run();
+
+    // Move "Second" up to position 0
+    // fireEvent.click avoids jsdom addRange bug with FCL Button
+    fireEvent.click(screen.getByTestId("move-up-Second"));
+
+    expect(scope.props.onChange).toHaveBeenCalledWith([
+      { name: "Second" },
+      { name: "First" },
+      { name: "Third" },
+    ]);
+
+    teardown();
+  });
+
+  it("move-down reorders affiliations correctly", () => {
+    const scope = setup();
+    scope.props.affiliations = [
+      { name: "First" },
+      { name: "Second" },
+    ];
+    scope.run();
+
+    // Move "First" down to position 1
+    // fireEvent.click avoids jsdom addRange bug with FCL Button
+    fireEvent.click(screen.getByTestId("move-down-First"));
+
+    expect(scope.props.onChange).toHaveBeenCalledWith([
+      { name: "Second" },
+      { name: "First" },
+    ]);
+
+    teardown();
+  });
+
+  // -- Duplicate detection --
+
+  it("shows duplicate alert when adding an affiliation with the same rorId", () => {
+    const scope = setup();
+    scope.props.affiliations = [{ rorId: "041nk4h34", name: "MIT" }];
+    scope.run();
+
+    // Try to add MIT again via ROR search (same rorId)
+    // fireEvent.click avoids jsdom addRange bug with FCL Button
+    fireEvent.click(screen.getByText("Add new affiliation"));
+    // fireEvent.click avoids jsdom addRange bug with FCL Button
+    fireEvent.click(screen.getByTestId("ror-select"));
+
+    // Should show duplicate alert instead of calling onChange
+    expect(screen.getByText("This affiliation is already in your list.")).toBeInTheDocument();
+    expect(scope.props.onChange).not.toHaveBeenCalled();
+
+    teardown();
+  });
+
+  it("shows duplicate alert for case-insensitive name match on suggested affiliations", () => {
+    const scope = setup();
+    // Existing affiliation with lowercase name
+    scope.props.affiliations = [{ name: "harvard" }];
+    // Suggested with different casing — should be detected as duplicate
+    scope.props.suggestedAffiliations = [{ name: "Harvard" }];
+    scope.run();
+
+    // fireEvent.click avoids jsdom addRange bug with FCL Button
+    fireEvent.click(screen.getByText("Add Harvard"));
+
+    expect(screen.getByText("This affiliation is already in your list.")).toBeInTheDocument();
+    expect(scope.props.onChange).not.toHaveBeenCalled();
+
+    teardown();
+  });
+});
