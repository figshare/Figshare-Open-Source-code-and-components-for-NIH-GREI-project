+    onSubmit({ ...submitted, type: AUTHOR_TYPE_PERSON, affiliations });
+  }, [form, author, affiliations, onSubmit]);
+
+  const submitAuthorForm = useCallback(throttle.sync(() => {
+    if (authorType === "organization") {
