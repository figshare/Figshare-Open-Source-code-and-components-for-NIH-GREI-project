+
+// person_list entry `type` values (figcore UnderlyingFieldStatic.PERSON_TYPE_*)
+export const PERSON_TYPE_PERSONAL = 1;
+export const PERSON_TYPE_ORGANIZATIONAL = 2;
+
+// A hydrated person_list entry, as an ITBM `authors` field value comes back from GraphQL.
+export interface PersonListEntry {
+  type: number;
+  userId: number;
+  name?: string | null;
+  firstName?: string | null;
+  lastName?: string | null;
+  isActive?: boolean;
+  isPublic?: boolean;
+  publicUrl?: string | null;
+}
+
+// The legacy author shape read by meta tags, sharing and author links.
+export interface EntityAuthor {
+  id: number;
+  type?: number;
+  name: string;
+  firstName: string;
+  lastName: string;
+  isActive: boolean;
+  isPublic: boolean;
+  publicUrl: string | null;
+}
+
+interface UnderlyingFieldEntry {
+  name: string;
+  value?: unknown;
+}
+
+// Map person_list entries to the legacy author shape. Ghost and organization users have no account flags.
+export function personListToAuthors(entries: unknown): EntityAuthor[] {
+  if (!Array.isArray(entries)) {
+    return [];
+  }
+
+  return entries.map((entry: PersonListEntry) => {
+    return {
+      id: entry.userId,
+      type: entry.type,
+      name: entry.name ?? (compact([entry.firstName, entry.lastName]) as string[]).join(" "),
+      firstName: entry.firstName ?? "",
+      lastName: entry.lastName ?? "",
+      isActive: Boolean(entry.isActive),
+      isPublic: Boolean(entry.isPublic),
+      publicUrl: entry.publicUrl ?? null,
+    };
+  });
+}
+
+// The authors of an item or collection: ITBM entities (whose `itemTypeFields` include the core `authors`
+// field) read the person_list field, since ITBM doesn't fill the legacy `authors` query field; other
+// entities keep the legacy authors.
+export function getEntityAuthors<T>(
+  legacyAuthors: T[] | null | undefined,
+  itemTypeFields: UnderlyingFieldEntry[] | null | undefined,
+): Array<T | EntityAuthor> {
+  const authorsField = getUnderlyingFieldByName("authors", itemTypeFields ?? []);
+  if (authorsField) {
+    return personListToAuthors(authorsField.value);
+  }
+
+  return legacyAuthors ?? [];
+}
+
+// "Family, Given" for citation meta tags; organizations (and people without a family name) use their
+// name instead.
+export function formatAuthorCitationName(
+  author: Partial<EntityAuthor> | null | undefined,
+  separator = ", ",
+): string {
+  if (author?.type === PERSON_TYPE_ORGANIZATIONAL || !author?.lastName) {
+    return author?.name ?? "";
+  }
+
+  return author.firstName ? `${author.lastName}${separator}${author.firstName}` : author.lastName;
+}
