@@ -0,0 +1,329 @@
+import React from "react";
+import { render, cleanup, screen, fireEvent } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { TestScope } from "types/testing";
+
+import { AuthorsTable } from "./AuthorsTable";
+
+
+// Mock child components to isolate AuthorsTable behavior
+jest.mock("./BulkAddAffiliations/BulkAddAffiliationsOverlay", () => {
+  return {
+    BulkAddAffiliationsOverlay: ({ isVisible, onClose, onSubmit, selectedCount }: any) =>
+      isVisible ? (
+        <div data-testid="bulk-overlay">
+          <span data-testid="bulk-selected-count">{selectedCount}</span>
+          <button data-testid="bulk-close" onClick={onClose}>Close</button>
+          <button data-testid="bulk-submit" onClick={() => onSubmit([{ name: "MIT" }])}>Submit</button>
+        </div>
+      ) : null,
+  };
+});
+
+jest.mock("./AuthorActionMenu", () => {
+  return {
+    AuthorActionMenu: ({ author, onAction, disabled }: any) => (
+      <div data-testid={`action-menu-${author.userId || author.name || "unknown"}`}>
+        <button
+          data-testid={`edit-${author.userId || author.name}`}
+          disabled={disabled}
+          onClick={() => onAction(author, "edit")}
+        >
+          Edit
+        </button>
+        <button
+          data-testid={`delete-${author.userId || author.name}`}
+          disabled={disabled}
+          onClick={() => onAction(author, "delete")}
+        >
+          Delete
+        </button>
+      </div>
+    ),
+  };
+});
+
+
+// Helper to create a person author with standard shape
+function makePerson(userId: number, first: string, last: string, affiliations: any[] = []) {
+  return { type: 1, userId, firstName: first, lastName: last, affiliations };
+}
+
+// Helper to create an org author (type=2) — not selectable for bulk affiliations
+function makeOrg(name: string, contributors = "") {
+  return { type: 2, name, contributors };
+}
+
+
+describe("<AuthorsTable />", () => {
+  function setup() {
+    const scope: TestScope = {
+      user: userEvent.setup(),
+      props: {
+        authors: [
+          makePerson(1, "John", "Doe"),
+          makePerson(2, "Jane", "Smith"),
+        ],
+        onReorder: jest.fn(),
+        onAction: jest.fn(),
+        onBulkAddAffiliations: jest.fn(),
+      },
+    };
+
+    scope.run = () => {
+      scope.wrapper = render(<AuthorsTable {...scope.props} />);
+    };
+
+    scope.rerender = () => {
+      scope.wrapper.rerender(<AuthorsTable {...scope.props} />);
+    };
+
+    return scope;
+  }
+
+  function teardown() {
+    cleanup();
+  }
+
+  // -- Empty state --
+
+  it("shows empty state message when no authors", () => {
+    const scope = setup();
+    scope.props.authors = [];
+    scope.run();
+
+    // pluralizeLabel("Author") returns "authors" (lowercase)
+    expect(screen.getByText("No authors added yet.")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  // -- Rendering --
+
+  it("renders author names in the table", () => {
+    const scope = setup();
+    scope.run();
+
+    expect(screen.getByText("John Doe")).toBeInTheDocument();
+    expect(screen.getByText("Jane Smith")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("shows affiliations text for authors with affiliations", () => {
+    const scope = setup();
+    scope.props.authors = [
+      makePerson(1, "John", "Doe", [{ name: "MIT" }, { name: "Harvard" }]),
+    ];
+    scope.run();
+
+    // Affiliations are joined with "; " separator
+    expect(screen.getByText("MIT; Harvard")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("shows 'Organization' subtitle for org-type authors", () => {
+    const scope = setup();
+    scope.props.authors = [
+      makePerson(1, "John", "Doe"),
+      makeOrg("Acme Corp"),
+    ];
+    scope.run();
+
+    expect(screen.getByText("Organization")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("shows contributors text for org-type authors", () => {
+    const scope = setup();
+    scope.props.authors = [makeOrg("Acme Corp", "Alice, Bob")];
+    scope.run();
+
+    expect(screen.getByText("Alice, Bob")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  // -- Selection --
+
+  it("shows '0 of N selected' initially", () => {
+    const scope = setup();
+    scope.run();
+
+    expect(screen.getByText("0 of 2 selected")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("updates selection count when a checkbox is clicked", () => {
+    const scope = setup();
+    scope.run();
+
+    // FCL Checkbox renders a native <input type="checkbox"> inside a <label>.
+    // Query the actual inputs to trigger onChange correctly.
+    const inputs = document.querySelectorAll("input[type='checkbox']");
+    // inputs[0] = select-all header, [1] = first author, [2] = second author
+    fireEvent.click(inputs[1]);
+
+    expect(screen.getByText("1 of 2 selected")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("select-all checkbox selects all selectable (non-org) authors", () => {
+    const scope = setup();
+    scope.props.authors = [
+      makePerson(1, "John", "Doe"),
+      makeOrg("Acme Corp"),
+      makePerson(3, "Jane", "Smith"),
+    ];
+    scope.run();
+
+    // Click the header select-all native checkbox input
+    const inputs = document.querySelectorAll("input[type='checkbox']");
+    fireEvent.click(inputs[0]);
+
+    // 2 person authors selected out of 3 total (org is not selectable)
+    expect(screen.getByText("2 of 3 selected")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("org-type authors have disabled checkboxes", () => {
+    const scope = setup();
+    scope.props.authors = [makePerson(1, "John", "Doe"), makeOrg("Acme Corp")];
+    scope.run();
+
+    // FCL Checkbox puts aria-disabled on the native <input>
+    const inputs = document.querySelectorAll("input[type='checkbox']");
+    // inputs: [0]=header, [1]=John (enabled), [2]=Acme (disabled)
+    expect(inputs[2]).toHaveAttribute("aria-disabled", "true");
+
+    teardown();
+  });
+
+  // -- Reorder --
+
+  it("calls onReorder when move-up button is clicked", async() => {
+    const scope = setup();
+    scope.run();
+
+    // Move up the second author (index 1 → 0)
+    const moveUpButtons = screen.getAllByRole("button", { name: /move up/i });
+    await scope.user.click(moveUpButtons[1]);
+
+    expect(scope.props.onReorder).toHaveBeenCalledWith(1, 0);
+
+    teardown();
+  });
+
+  it("disables move-up for the first author and move-down for the last", () => {
+    const scope = setup();
+    scope.run();
+
+    const moveUpButtons = screen.getAllByRole("button", { name: /move up/i });
+    const moveDownButtons = screen.getAllByRole("button", { name: /move down/i });
+
+    // FCL Button uses aria-disabled — first author can't move up, last can't move down
+    expect(moveUpButtons[0]).toHaveAttribute("aria-disabled", "true");
+    expect(moveDownButtons[moveDownButtons.length - 1]).toHaveAttribute("aria-disabled", "true");
+
+    teardown();
+  });
+
+  // -- Action menu --
+
+  it("dispatches onAction when action menu item is clicked", async() => {
+    const scope = setup();
+    scope.run();
+
+    await scope.user.click(screen.getByTestId("edit-1"));
+
+    expect(scope.props.onAction).toHaveBeenCalledWith(scope.props.authors[0], "edit");
+
+    teardown();
+  });
+
+  // -- Show all / collapse --
+
+  it("shows only first 10 authors and a 'Show all' button when more than 10", async() => {
+    const scope = setup();
+    // Create 12 authors — only first 10 should be visible
+    scope.props.authors = Array.from({ length: 12 }, (_, i) =>
+      makePerson(i + 1, `Author${i + 1}`, "Test")
+    );
+    scope.run();
+
+    // 10 author names visible + the 2 hidden ones not rendered
+    const authorNames = document.querySelectorAll(".authorName");
+    expect(authorNames).toHaveLength(10);
+
+    // pluralizeLabel("Author") returns "authors" (lowercase)
+    expect(screen.getByText("Show all 12 authors")).toBeInTheDocument();
+
+    // Click show all to expand
+    await scope.user.click(screen.getByText("Show all 12 authors"));
+
+    const expandedNames = document.querySelectorAll(".authorName");
+    expect(expandedNames).toHaveLength(12);
+    expect(screen.getByText("Collapse table")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  // -- Bulk add affiliations --
+
+  it("disables bulk add button when no authors are selected", () => {
+    const scope = setup();
+    scope.run();
+
+    // FCL Button uses aria-disabled instead of the HTML disabled attribute
+    const bulkButton = screen.getByText("Bulk add affiliations").closest("button");
+    expect(bulkButton).toHaveAttribute("aria-disabled", "true");
+
+    teardown();
+  });
+
+  it("opens bulk overlay when authors are selected and button is clicked", () => {
+    const scope = setup();
+    scope.run();
+
+    // Select the first author — use native checkbox input
+    const inputs = document.querySelectorAll("input[type='checkbox']");
+    fireEvent.click(inputs[1]);
+
+    // Click the bulk add button
+    fireEvent.click(screen.getByText("Bulk add affiliations"));
+
+    // The mocked overlay should now be visible
+    expect(screen.getByTestId("bulk-overlay")).toBeInTheDocument();
+    expect(screen.getByTestId("bulk-selected-count")).toHaveTextContent("1");
+
+    teardown();
+  });
+
+  it("submitting bulk overlay calls onBulkAddAffiliations and clears selection", () => {
+    const scope = setup();
+    scope.run();
+
+    // Select both authors — use native checkbox input
+    const inputs = document.querySelectorAll("input[type='checkbox']");
+    fireEvent.click(inputs[0]); // select-all
+
+    fireEvent.click(screen.getByText("Bulk add affiliations"));
+    fireEvent.click(screen.getByTestId("bulk-submit"));
+
+    // onBulkAddAffiliations receives selected indices and the affiliations
+    expect(scope.props.onBulkAddAffiliations).toHaveBeenCalledWith(
+      [0, 1],
+      [{ name: "MIT" }]
+    );
+
+    // Selection should be cleared after submit
+    expect(screen.getByText("0 of 2 selected")).toBeInTheDocument();
+
+    teardown();
+  });
+});
diff --git a/src/pages/editItem/EditItemMain/EditItemForm/EditItemFormField/figshareFields/authors/components/AuthorsTable/AuthorsTable.tsx b/src/pages/editItem/EditItemMain/EditItemForm/EditItemFormField/figshareFields/authors/components/AuthorsTable/AuthorsTable.tsx
