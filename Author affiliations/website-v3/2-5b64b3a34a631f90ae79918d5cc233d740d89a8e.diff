+import React, { useState, useCallback } from "react";
+import { Button as FclButton } from "@digital-science/figshare-fcl/button";
+import { Overlay, OverlayHeader, OverlayContent, OverlayFooter } from "@digital-science/figshare-fcl/overlay";
+
+import { pluralizeLabel } from "../../../utils";
+import { AffiliationsSelector, type Affiliation } from "../../authorEditor/AffiliationsSelector/AffiliationsSelector";
+
+import styles from "./BulkAddAffiliationsOverlay.module.css";
+
+
+interface BulkAddAffiliationsProps {
+  isVisible: boolean;
+  selectedCount: number;
+  onClose: () => void;
+  onSubmit: (affiliations: Affiliation[]) => void;
+  fieldLabel?: string;
+}
+
+
+export function BulkAddAffiliationsOverlay({ isVisible, selectedCount, onClose, onSubmit, fieldLabel = "author" }: BulkAddAffiliationsProps) {
+  const [affiliations, setAffiliations] = useState<Affiliation[]>([]);
+
+  // Reset state when closing
+  const handleClose = useCallback(() => {
+    setAffiliations([]);
+    onClose();
+  }, [onClose]);
+
+  // Submit the affiliations to parent and reset
+  const handleSubmit = useCallback(() => {
+    if (affiliations.length === 0) return;
+    onSubmit(affiliations);
+    setAffiliations([]);
+  }, [affiliations, onSubmit]);
+
+  return (
+    <Overlay
+      background="primary"
+      focusIn={true}
+      isVisible={isVisible}
+      variant="formModal"
+      onClose={handleClose}
+    >
+      <OverlayHeader
+        description={
+          `Choose the affiliations and the ${pluralizeLabel(fieldLabel)} to add them to. ` +
+          `They'll be added to each selected ${fieldLabel.toLowerCase()}'s existing affiliations.`
+        }
+        title={`Add affiliations to multiple ${pluralizeLabel(fieldLabel)}`}
+      />
+
+      <OverlayContent>
+        <div className={styles.body}>
+          <AffiliationsSelector
+            affiliations={affiliations}
+            droppableId="bulk-affiliations"
+            onChange={setAffiliations}
+          />
+
+          {/* Count of selected authors */}
+          <p className={styles.selectedCount}>
+            Adding affiliations to {selectedCount} selected {fieldLabel.toLowerCase()}(s).
+          </p>
+        </div>
+      </OverlayContent>
+
+      <OverlayFooter>
+        <OverlayFooter.Primary>
+          <FclButton theme="secondaryAlt" onClick={handleClose}>Cancel</FclButton>
+          <FclButton
+            disabled={affiliations.length === 0}
+            theme="primary"
+            onClick={handleSubmit}
+          >
+            Add affiliations
+          </FclButton>
+        </OverlayFooter.Primary>
+      </OverlayFooter>
+    </Overlay>
+  );
+}
