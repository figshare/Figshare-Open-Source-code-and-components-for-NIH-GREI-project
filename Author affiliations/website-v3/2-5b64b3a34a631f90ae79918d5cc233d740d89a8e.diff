+/*
+ * Grid table layout
+ * Uses CSS Grid instead of DataGrid's flex to guarantee column alignment
+ * between the header row and every data row.
+ */
+
+.tableWrapper {
+  overflow-x: auto;
+
+  width: 100%;
+}
+
+/* Outer container — replicates DataGrid's border and radius */
+.table {
+  display: grid;
+  grid-template-columns: 54px 1fr 1fr 120px 81px;
+
+  border: 1px solid var(--Border-Primary, #ddd);
+  border-radius: 6px;
+}
+
+/* ── Toolbar ──────────────────────────────────────────────────────── */
+
+.toolbar {
+  grid-column: 1 / -1;
+
+  display: flex;
+  flex-direction: row;
+
+  box-sizing: border-box;
+  height: 60px;
+
+  padding: 18px;
+
+  border-bottom: 1px solid var(--Border-Primary, #ddd);
+  border-radius: 6px 6px 0 0;
+
+  background: var(--Layout-background-Primary, #fff);
+  align-items: center;
+  gap: 18px;
+}
+
+.selectionCount {
+  font-family: var(--fontFamily);
+  font-size: var(--typography-M-fontSize);
+  line-height: var(--typography-M-lineHeight);
+
+  color: var(--color-typography-primary);
+}
+
+/* ── Header cells ─────────────────────────────────────────────────── */
+
+.headerCell {
+  font-family: var(--fontFamily);
+  font-size: var(--typography-M-fontSize);
+  font-weight: 400;
+  line-height: var(--typography-M-lineHeight);
+
+  display: flex;
+  align-items: center;
+
+  min-height: 36px;
+  padding: 12px 18px;
+
+  color: var(--color-typography-primary);
+  background-color: var(--Layout-background-Tertiary, #f8f8f8);
+}
+
+/* Center-aligned header cells */
+.headerCellCenter {
+  composes: headerCell;
+  justify-content: center;
+}
+
+/* ── Data cells ───────────────────────────────────────────────────── */
+
+.cell {
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+
+  padding: 12px 18px;
+}
+
+/* Center-aligned data cells (checkbox, reorder, action) */
+.cellCenter {
+  composes: cell;
+  align-items: center;
+}
+
+/* Affiliations cell: fixed height from design spec */
+.cellAffiliations {
+  composes: cell;
+
+  height: 72px;
+}
+
+/*
+ * Row separator — since cells are direct grid items (no row wrapper), the
+ * first cell in each row draws a top-border. Remaining cells inherit it
+ * via the shared .rowBorder class.
+ */
+
+.rowBorder {
+  border-top: 1px solid var(--Border-Primary, #ddd);
+}
+
+/* ── Author content styles ────────────────────────────────────────── */
+
+.authorName {
+  font-family: var(--fontFamily);
+  font-size: var(--typography-M-fontSize);
+  font-weight: 400;
+  line-height: var(--typography-M-lineHeight);
+
+  color: var(--color-typography-primary);
+}
+
+.authorSubtitle {
+  font-family: var(--fontFamily);
+  font-size: var(--typography-S-fontSize);
+  font-weight: 400;
+  line-height: var(--typography-S-lineHeight);
+
+  color: var(--color-typography-tertiary);
+}
+
+.affiliationsText {
+  font-family: var(--fontFamily);
+  font-size: var(--typography-M-fontSize);
+  font-weight: 400;
+  line-height: var(--typography-M-lineHeight);
+
+  display: -webkit-box;
+  overflow: hidden;
+
+  color: var(--color-typography-secondary);
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+}
+
+.reorderButtons {
+  display: flex;
+  flex-direction: row;
+  align-items: center;
+}
+
+/* ── Show all / collapse ──────────────────────────────────────────── */
+
+.showAllRow {
+  grid-column: 1 / -1;
+
+  display: flex;
+  flex-direction: row;
+
+  box-sizing: border-box;
+
+  padding: 16px 18px;
+
+  border-top: 1px solid var(--Border-Primary, #ddd);
+  align-items: center;
+}
+
+.showAllButton {
+  font-family: var(--fontFamily);
+  font-size: var(--typography-M-fontSize);
+  font-weight: 400;
+  line-height: var(--typography-M-lineHeight);
+
+  padding: 0;
+
+  cursor: pointer;
+  text-decoration: underline;
+
+  color: var(--color-branding-figRed, #a60845);
+  border: none;
+  background: none;
+}
+
+.showAllButton:hover,
+.showAllButton:focus {
+  color: var(--color-button-primary-background_hover);
+}
+
+/* ── Empty state ──────────────────────────────────────────────────── */
+
+.emptyState {
+  font-family: var(--fontFamily);
+  font-size: var(--typography-M-fontSize);
+  font-weight: 400;
+  line-height: var(--typography-M-lineHeight);
+
+  margin: 0;
+
+  color: var(--color-typography-secondary);
+}
diff --git a/src/pages/editItem/EditItemMain/EditItemForm/EditItemFormField/figshareFields/authors/components/AuthorsTable/AuthorsTable.test.tsx b/src/pages/editItem/EditItemMain/EditItemForm/EditItemFormField/figshareFields/authors/components/AuthorsTable/AuthorsTable.test.tsx
