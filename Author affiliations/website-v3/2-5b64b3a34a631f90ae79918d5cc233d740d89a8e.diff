@@ -0,0 +1,279 @@
+import React, { useState, useCallback, useEffect } from "react";
+import Checkbox from "@digital-science/figshare-fcl/input/checkbox";
+import ChevronUpSvg from "@digital-science/figshare-fcl/icons/react/ChevronUp";
+import ChevronDownSvg from "@digital-science/figshare-fcl/icons/react/ChevronDown";
+import { Button } from "shared/ui/latest/Button";
+
+import { getAuthorName, pluralizeLabel } from "../../utils";
+import { AUTHOR_TYPE_ORGANIZATION } from "../authorEditor";
+
+import { AuthorActionMenu } from "./AuthorActionMenu";
+import { BulkAddAffiliationsOverlay } from "./BulkAddAffiliations/BulkAddAffiliationsOverlay";
+import styles from "./AuthorsTable.module.css";
+
+
+const DEFAULT_VISIBLE_COUNT = 10;
+
+
+interface Author {
+  type?: number;
+  userId?: number;
+  name?: string;
+  firstName?: string;
+  lastName?: string;
+  first_name?: string;
+  last_name?: string;
+  isActive?: boolean;
+  hasAccount?: boolean;
+  affiliations?: Array<{ rorId?: string; name?: string }>;
+  isGroupAuthor?: boolean;
+  members?: string[];
+  contributors?: string;
+  [key: string]: unknown;
+}
+
+interface Affiliation {
+  rorId?: string;
+  name: string;
+}
+
+interface AuthorsTableProps {
+  authors: Author[];
+  onReorder: (fromIndex: number, toIndex: number) => void;
+  onAction: (author: Author, action: import("./AuthorActionMenu").AuthorAction) => void;
+  onBulkAddAffiliations?: (authorIndices: number[], affiliations: Affiliation[]) => void;
+  disabled?: boolean;
+  fieldLabel?: string;
+}
+
+
+export function AuthorsTable({ authors, onReorder, onAction, onBulkAddAffiliations, disabled = false, fieldLabel = "Author" }: AuthorsTableProps) {
+  // Track selected authors by their array index — works for all authors
+  // regardless of whether they have a userId (linked) or not (custom/unlinked).
+  const [selectedIndices, setSelectedIndices] = useState<Set<number>>(new Set());
+  const [showAll, setShowAll] = useState(false);
+  const [isBulkOverlayVisible, setIsBulkOverlayVisible] = useState(false);
+
+  // Visible authors — truncated unless "Show all" is clicked
+  const visibleAuthors = showAll ? authors : authors.slice(0, DEFAULT_VISIBLE_COUNT);
+  const hasMore = authors.length > DEFAULT_VISIBLE_COUNT;
+
+  // Only person authors are selectable (orgs have no affiliations)
+  const isSelectable = (a: Author) => a.type !== AUTHOR_TYPE_ORGANIZATION;
+  const selectableIndices = authors.reduce<number[]>((acc, a, i) => {
+    if (isSelectable(a)) acc.push(i);
+
+    return acc;
+  }, []);
+
+  // Prune selection when the authors list changes — drop indices that are
+  // out of bounds or now point to non-selectable authors.
+  useEffect(() => {
+    setSelectedIndices((prev) => {
+      if (prev.size === 0) return prev;
+      const validSet = new Set(selectableIndices);
+      const pruned = new Set([...prev].filter((i) => validSet.has(i)));
+
+      return pruned.size === prev.size ? prev : pruned;
+    });
+  }, [authors]); // eslint-disable-line
+
+  const allSelected = selectableIndices.length > 0 && selectedIndices.size === selectableIndices.length;
+  const someSelected = selectedIndices.size > 0 && selectedIndices.size < selectableIndices.length;
+
+  const handleSelectAll = useCallback(() => {
+    if (allSelected) {
+      setSelectedIndices(new Set());
+    } else {
+      setSelectedIndices(new Set(selectableIndices));
+    }
+  }, [allSelected, selectableIndices]);
+
+  const handleSelectOne = useCallback((index: number) => {
+    setSelectedIndices((prev) => {
+      const next = new Set(prev);
+      if (next.has(index)) {
+        next.delete(index);
+      } else {
+        next.add(index);
+      }
+
+      return next;
+    });
+  }, []);
+
+  const handleMoveUp = useCallback((index: number) => {
+    if (index > 0) {
+      onReorder(index, index - 1);
+    }
+  }, [onReorder]);
+
+  const handleMoveDown = useCallback((index: number) => {
+    if (index < authors.length - 1) {
+      onReorder(index, index + 1);
+    }
+  }, [onReorder, authors.length]);
+
+  // Format affiliations/members/contributors for display
+  const getAffiliationsDisplay = useCallback((author: Author) => {
+    if (author.type === AUTHOR_TYPE_ORGANIZATION && author.contributors) {
+      return author.contributors;
+    }
+    if (author.isGroupAuthor && author.members?.length) {
+      return author.members.join(", ");
+    }
+    if (author.affiliations?.length) {
+      return author.affiliations.map((a) => a.name).filter(Boolean).join("; ");
+    }
+
+    return "";
+  }, []);
+
+  // Author subtitle ("Organization" for org-type authors)
+  const getSubtitle = useCallback((author: Author) => {
+    if (author.type === AUTHOR_TYPE_ORGANIZATION || author.isGroupAuthor) {
+      return "Organization";
+    }
+
+    return null;
+  }, []);
+
+  // Submit bulk affiliations to parent, then close overlay and clear selection
+  const handleBulkSubmit = useCallback((affiliations: Affiliation[]) => {
+    onBulkAddAffiliations?.(Array.from(selectedIndices), affiliations);
+    setIsBulkOverlayVisible(false);
+    setSelectedIndices(new Set());
+  }, [onBulkAddAffiliations, selectedIndices]);
+
+  if (authors.length === 0) {
+    return (
+      <p className={styles.emptyState}>No {pluralizeLabel(fieldLabel)} added yet.</p>
+    );
+  }
+
+  return (
+    <div className={styles.tableWrapper}>
+      {/* CSS Grid table — column tracks are shared between header and all
+          data rows, guaranteeing perfect column alignment. */}
+      <div className={styles.table}>
+        {/* Selection toolbar — spans all columns */}
+        <div className={styles.toolbar}>
+          <span className={styles.selectionCount}>
+            {selectedIndices.size} of {authors.length} selected
+          </span>
+          {/* eslint-disable-next-line react/jsx-no-bind */}
+          <Button kind="secondary" em="high" disabled={selectedIndices.size === 0} onClick={() => setIsBulkOverlayVisible(true)}>
+            <Button.Label>Bulk add affiliations</Button.Label>
+          </Button>
+        </div>
+
+        {/* Column headers — direct grid items */}
+        <div className={styles.headerCellCenter}>
+          <Checkbox
+            checked={allSelected}
+            disabled={disabled}
+            indeterminate={someSelected}
+            onChange={handleSelectAll}
+          />
+        </div>
+        <div className={styles.headerCell}>Name</div>
+        <div className={styles.headerCell}>Affiliations / Members</div>
+        <div className={styles.headerCellCenter}>Reorder</div>
+        <div className={styles.headerCellCenter}>Action</div>
+
+        {/* Author rows — each row is 5 cells that are direct grid items */}
+        {visibleAuthors.map((author, index) => {
+          const isSelected = selectedIndices.has(index);
+          const subtitle = getSubtitle(author);
+          const affiliationsText = getAffiliationsDisplay(author);
+          const isFirst = index === 0;
+          const isLast = index === authors.length - 1;
+          const canSelect = isSelectable(author);
+
+          return (
+            <React.Fragment key={author.userId ?? `author-${index}`}>
+              {/* Checkbox */}
+              <div className={`${styles.cellCenter} ${styles.rowBorder}`}>
+                <Checkbox
+                  checked={isSelected}
+                  disabled={disabled || !canSelect}
+                  onChange={() => handleSelectOne(index)}
+                />
+              </div>
+
+              {/* Name + optional subtitle */}
+              <div className={`${styles.cell} ${styles.rowBorder}`}>
+                <span className={styles.authorName}>{getAuthorName(author)}</span>
+                {subtitle && <span className={styles.authorSubtitle}>{subtitle}</span>}
+              </div>
+
+              {/* Affiliations / Members */}
+              <div className={`${styles.cellAffiliations} ${styles.rowBorder}`}>
+                <span className={styles.affiliationsText}>{affiliationsText}</span>
+              </div>
+
+              {/* Reorder — up/down chevron buttons */}
+              <div className={`${styles.cellCenter} ${styles.rowBorder}`}>
+                <div className={styles.reorderButtons}>
+                  <Button
+                    kind="tertiary"
+                    em={isFirst ? "low" : "high"}
+                    span="icon"
+                    disabled={isFirst || disabled}
+                    tooltip={`Move up ${getAuthorName(author)}`}
+                    tooltipContentProps={ { "data-font-style": "normal" } }
+                    onClick={() => handleMoveUp(index)}
+                  >
+                    <Button.Icon><ChevronUpSvg /></Button.Icon>
+                    <Button.Label hidden={true}>Move up {getAuthorName(author)}</Button.Label>
+                  </Button>
+                  <Button
+                    kind="tertiary"
+                    em={isLast ? "low" : "high"}
+                    span="icon"
+                    disabled={isLast || disabled}
+                    tooltip={`Move down ${getAuthorName(author)}`}
+                    tooltipContentProps={ { "data-font-style": "normal" } }
+                    onClick={() => handleMoveDown(index)}
+                  >
+                    <Button.Icon><ChevronDownSvg /></Button.Icon>
+                    <Button.Label hidden={true}>Move down {getAuthorName(author)}</Button.Label>
+                  </Button>
+                </div>
+              </div>
+
+              {/* Action menu */}
+              <div className={`${styles.cellCenter} ${styles.rowBorder}`}>
+                <AuthorActionMenu
+                  author={author}
+                  disabled={disabled}
+                  isFirst={isFirst}
+                  isLast={isLast}
+                  onAction={onAction}
+                />
+              </div>
+            </React.Fragment>
+          );
+        })}
+
+        {/* Show all / collapse — spans all columns */}
+        {hasMore && (
+          <div className={styles.showAllRow}>
+            <button className={styles.showAllButton} type="button" onClick={() => setShowAll(!showAll)}>
+              {showAll ? "Collapse table" : `Show all ${authors.length} ${pluralizeLabel(fieldLabel)}`}
+            </button>
+          </div>
+        )}
+      </div>
+
+      {/* Bulk add affiliations overlay */}
+      <BulkAddAffiliationsOverlay
+        isVisible={isBulkOverlayVisible}
+        fieldLabel={fieldLabel}
+        selectedCount={selectedIndices.size}
+        onClose={() => setIsBulkOverlayVisible(false)}
+        onSubmit={handleBulkSubmit}
+      />
+    </div>
+  );
+}
