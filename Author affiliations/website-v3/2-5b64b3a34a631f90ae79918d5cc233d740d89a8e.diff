@@ -0,0 +1,155 @@
+import React, { useState, useCallback, useEffect } from "react";
+import { noop } from "utils/noop";
+import { Dropdown, Toggle, Menu } from "@digital-science/figshare-fcl/dropdown";
+import { SearchInput } from "shared/ui/latest/SearchInput";
+import { Button } from "shared/ui/latest/Button";
+import { useRorSearch } from "pages/account/profileEdit/components/affiliations/useRorSearch";
+
+import { AffiliationDropdown, type RorOrganization } from "../AffiliationDropdown/AffiliationDropdown";
+
+import styles from "./RorSearchField.css";
+
+
+// Popper v2 modifier: makes the menu the same width as its reference element
+const sameWidthModifier = {
+  name: "sameWidth",
+  enabled: true,
+  phase: "beforeWrite" as const,
+  requires: ["computeStyles"],
+  fn: ({ state }: { state: { styles: { popper: Record<string, string> }; rects: { reference: { width: number } } } }) => {
+    state.styles.popper.width = `${state.rects.reference.width}px`;
+  },
+};
+
+
+interface RorSearchFieldProps {
+  placeholder?: string;
+  onSelect: (org: RorOrganization) => void;
+  /** Called when the text in the search input changes (in addition to the internal ROR query). */
+  onChange?: (value: string) => void;
+  /** Called when the user clicks "Add a new organization" — receives the current search term. */
+  onAddManually?: (term: string) => void;
+  /** Called when the user clicks Cancel. If omitted the Cancel button is hidden. */
+  onCancel?: () => void;
+  /** Controlled value — when provided the component reflects this instead of its own search term. */
+  value?: string;
+  /** When true, the dropdown only appears while the input is focused. Default: false (always visible). */
+  showOnFocus?: boolean;
+  /** Text shown in the dropdown when the input is empty. */
+  emptyHint?: string;
+  /** When true, show "Use X as free text" instead of "Not on the list?" on no results. */
+  freeTextFallback?: boolean;
+}
+
+
+export function RorSearchField({
+  placeholder = "Search the ROR registry or type a name",
+  onSelect,
+  onChange,
+  onAddManually,
+  onCancel,
+  value,
+  showOnFocus = false,
+  emptyHint,
+  freeTextFallback = false,
+}: RorSearchFieldProps) {
+  const { searchTerm, setSearchTerm, loading, error, results, hasMore, handleLoadMore } = useRorSearch();
+  // When showOnFocus is false (inline search mode), start with the dropdown
+  // visible so the empty-state hint appears immediately on mount.
+  const [focused, setFocused] = useState(!showOnFocus);
+
+  // Keep internal searchTerm in sync with controlled value so the ROR query
+  // and AffiliationDropdown state match what the input displays.
+  useEffect(() => {
+    if (value !== undefined && value !== searchTerm) {
+      setSearchTerm(value);
+    }
+  }, [value]); // eslint-disable-line -- only sync when value changes
+
+  const displayValue = value ?? searchTerm;
+  // Dropdown is visible while the input is focused. When showOnFocus is false
+  // (inline search mode), we still tie visibility to focus so clicking outside
+  // the search area dismisses the results list.
+  const dropdownVisible = focused;
+
+  const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {
+    setSearchTerm(e.target.value);
+    setFocused(true);
+    onChange?.(e.target.value);
+  };
+
+  const handleSelect = useCallback((org: RorOrganization) => {
+    setSearchTerm(org.name);
+    setFocused(false);
+    onSelect(org);
+  }, [onSelect, setSearchTerm]);
+
+  const handleAddManually = useCallback(() => {
+    onAddManually?.(searchTerm.trim());
+    setFocused(false);
+    setSearchTerm("");
+  }, [onAddManually, searchTerm, setSearchTerm]);
+
+  const handleCancel = useCallback(() => {
+    setSearchTerm("");
+    onCancel?.();
+  }, [onCancel, setSearchTerm]);
+
+  return (
+    <Dropdown isVisible={dropdownVisible} onToggle={noop}>
+      {({ props: dropdownProps }) => (
+        <div {...dropdownProps} className={styles.container}>
+          <Toggle>
+            {({ props: toggleBucketProps }) => {
+              // ref is the Popper reference element — placed on the search input wrapper
+              // so the dropdown aligns to (and matches the width of) the input only
+              const { ref: toggleRef, ...toggleProps } = toggleBucketProps as { ref: React.Ref<HTMLDivElement>; [key: string]: unknown };
+
+              return (
+                <div {...toggleProps} className={onCancel ? styles.row : undefined}>
+                  <div ref={toggleRef} className={onCancel ? styles.inputWrapper : undefined}>
+                    <SearchInput
+                      placeholder={placeholder}
+                      value={displayValue}
+                      onChange={handleChange}
+                      // eslint-disable-next-line react/jsx-no-bind
+                      onFocus={() => setFocused(true)}
+                      // eslint-disable-next-line react/jsx-no-bind
+                      onBlur={() => setFocused(false)}
+                    />
+                  </div>
+                  {onCancel && (
+                    <Button kind="tertiary" onClick={handleCancel}>
+                      <Button.Label>Cancel</Button.Label>
+                    </Button>
+                  )}
+                </div>
+              );
+            }}
+          </Toggle>
+          {dropdownVisible && (
+            <Menu autoAdjust={true} modifiers={[sameWidthModifier]} placement="bottom-start" strategy="fixed">
+              {({ props: menuProps }) => (
+                // eslint-disable-next-line react/jsx-no-bind, jsx-a11y/no-static-element-interactions
+                <div {...menuProps} style={ { ...menuProps.style, zIndex: 10000 } } onMouseDown={(e) => e.preventDefault()}>
+                  <AffiliationDropdown
+                    emptyHint={emptyHint}
+                    error={error}
+                    freeTextFallback={freeTextFallback}
+                    hasMore={hasMore}
+                    loading={loading}
+                    results={results}
+                    searchTerm={displayValue}
+                    onAddManually={(onAddManually || freeTextFallback) ? handleAddManually : noop}
+                    onLoadMore={handleLoadMore}
+                    onSelect={handleSelect}
+                  />
+                </div>
+              )}
+            </Menu>
+          )}
+        </div>
+      )}
+    </Dropdown>
+  );
+}
