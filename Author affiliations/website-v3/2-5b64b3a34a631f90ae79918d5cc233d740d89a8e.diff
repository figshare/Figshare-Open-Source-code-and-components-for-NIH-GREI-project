+/* ── AffiliationsSelector — shared affiliations UI ── */
+
+.container {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: calc(2 * var(--gridSize)); /* 12px between sub-elements */
+
+  width: 100%;
+}
+
+/* "Affiliations" heading — bold 16px label */
+.title {
+  font-family: var(--fontFamily);
+  font-size: var(--typography-M-fontSize);
+  font-weight: 700;
+  line-height: var(--typography-M-lineHeight);
+
+  color: var(--color-typography-primary, #252525);
+}
+
+/* Compact alert — keeps the close button from adding extra height */
+.compactAlert {
+  width: 100%;
+}
+
+.compactAlert [data-part="alert-close"] {
+  margin: calc(-1 * var(--gridSize)) 0;
+}
+
+/* "Suggested from profile: Add X, Add Y" row */
+.suggestedAffiliations {
+  font-family: var(--fontFamily);
+  font-size: var(--typography-S-fontSize, 14px);
+  font-weight: 400;
+  line-height: var(--typography-S-lineHeight, 24px);
+
+  margin: 0;
+
+  color: var(--color-typography-secondary, #464646);
+}
+
+.suggestedLabel {
+  color: var(--color-typography-secondary, #464646);
+}
+
+/* Clickable "Add [institution]" link */
+.suggestionLink {
+  font-family: var(--fontFamily);
+  font-size: var(--typography-S-fontSize, 14px);
+  font-weight: 400;
+
+  padding: 0;
+
+  cursor: pointer;
+  text-decoration: underline;
+
+  color: var(--color-typography-link, #a60845);
+  border: none;
+  background: none;
+}
+
+.suggestionLink:hover,
+.suggestionLink:focus {
+  opacity: 0.85;
+}
+
+/* Drag-and-drop container for added affiliations */
+.affiliationsList {
+  display: flex;
+  flex-direction: column;
+  gap: var(--gridSize);
+
+  width: 100%;
+}
+
+/* "Add new affiliation" button — tertiary with a border */
+.addButton {
+  padding: 0 12px !important;
+
+  border: 1px solid var(--color-border-primary, #ddd) !important;
+}
