+import React, { useCallback } from "react";
+import { Button } from "shared/ui/latest/Button";
+
+import { LoaderContentBox } from "../../contentBox";
+
+import styles from "./AffiliationDropdown.module.css";
+
+
+const ROR_URL_PREFIX = "https://ror.org/";
+const SCROLL_OFFSET = 10;
+
+
+export interface RorOrganization {
+  rorId: string;
+  name: string;
+}
+
+interface AffiliationDropdownProps {
+  loading: boolean;
+  error?: Error;
+  results: RorOrganization[];
+  searchTerm: string;
+  hasMore: boolean;
+  onSelect: (org: RorOrganization) => void;
+  onLoadMore?: () => void;
+  onAddManually?: () => void;
+  /** Text shown when the input is empty. */
+  emptyHint?: string;
+  /** When true, show a "Use X as free text" option instead of "Not on the list?" + button. */
+  freeTextFallback?: boolean;
+}
+
+
+export function AffiliationDropdown({
+  loading, error, results, searchTerm, hasMore,
+  onSelect, onLoadMore, onAddManually,
+  emptyHint = "Start typing to search for an organization",
+  freeTextFallback = false,
+}: AffiliationDropdownProps) {
+  // Hook must be declared before any early returns
+  const handleScroll = useCallback((e: React.UIEvent<HTMLUListElement>) => {
+    const { scrollTop, scrollHeight, clientHeight } = e.currentTarget;
+
+    if (scrollHeight - scrollTop - clientHeight < SCROLL_OFFSET) {
+      onLoadMore?.();
+    }
+  }, [onLoadMore]);
+
+  const hasQuery = searchTerm.length >= 3;
+
+  // Empty input — prompt the user to start typing
+  if (searchTerm === "") {
+    return (
+      <div className={styles.container}>
+        <p className={styles.hint}>{emptyHint}</p>
+      </div>
+    );
+  }
+
+  // Not enough characters yet — hide the dropdown
+  if (!hasQuery) {
+    return null;
+  }
+
+  // Initial load spinner
+  if (loading && results.length === 0) {
+    return <LoaderContentBox />;
+  }
+
+  if (error) {
+    return (
+      <div className={styles.container}>
+        <p aria-live="assertive" className={styles.hint} role="alert">
+          Something went wrong. Please try again.
+        </p>
+      </div>
+    );
+  }
+
+  if (!loading && results.length === 0) {
+    if (freeTextFallback) {
+      return (
+        <div className={styles.container}>
+          <button className={styles.freeTextOption} type="button" onClick={onAddManually}>
+            Use &ldquo;{searchTerm}&rdquo; as free text
+          </button>
+        </div>
+      );
+    }
+
+    return (
+      <div className={styles.container}>
+        <div className={styles.footer}>
+          <span className={styles.footerText}>Not on the list?</span>
+          <Button kind="secondary" onClick={onAddManually}>Add a new organization</Button>
+        </div>
+      </div>
+    );
+  }
+
+  return (
+    <div className={styles.container}>
+      <ul className={styles.list} onScroll={handleScroll}>
+        {results.map((org) => (
+          <li key={org.rorId}>
+            {/* eslint-disable-next-line react/jsx-no-bind */}
+            <button
+              className={styles.item}
+              type="button"
+              onClick={() => onSelect(org)}
+            >
+              <span className={styles.itemName}>{org.name}</span>
+              <span className={styles.itemId}>{`${ROR_URL_PREFIX}${org.rorId}`}</span>
+            </button>
+          </li>
+        ))}
+        {/* "Use as free text" — last item in the list once all pages are loaded */}
+        {!hasMore && freeTextFallback && (
+          <li>
+            <button className={styles.freeTextOption} type="button" onClick={onAddManually}>
+              Use &ldquo;{searchTerm}&rdquo; as free text
+            </button>
+          </li>
+        )}
+      </ul>
+
+      {/* Footer shown when all results are loaded — affiliations only */}
+      {!hasMore && !freeTextFallback && (
+        <>
+          <div className={styles.separator}>
+            <div className={styles.separatorLine} />
+          </div>
+          <div className={styles.footer}>
+            <span className={styles.footerText}>Not on the list?</span>
+            <Button kind="secondary" onClick={onAddManually}>Add a new organization</Button>
+          </div>
+        </>
+      )}
+    </div>
+  );
+}
