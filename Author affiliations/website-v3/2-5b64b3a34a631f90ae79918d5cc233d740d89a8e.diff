+      const formEl = document.querySelector("form[data-id=\"author-editor-form-element\"]") as HTMLFormElement | null;
+      formEl?.requestSubmit?.();
+    } else {
+      handlePersonSubmit();
+    }
+  }, 2000), [authorType, handlePersonSubmit]);
+
+  useEffect(() => {
+    setBackFromMatchingAuthors(false);
+  }, [matchedAuthors]);
+
+  useEffect(() => {
