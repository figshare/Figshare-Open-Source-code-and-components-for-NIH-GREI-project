+import React from "react";
+import { render, cleanup, screen, fireEvent } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { TestScope } from "types/testing";
+
+import { RorSearchField } from "./RorSearchField";
+
+
+// Mock useRorSearch hook — returns controllable search state
+const mockSetSearchTerm = jest.fn();
+const mockHandleLoadMore = jest.fn();
+let mockSearchTerm = "";
+
+jest.mock("pages/account/profileEdit/components/affiliations/useRorSearch", () => {
+  return {
+    useRorSearch: () => {
+      return {
+        searchTerm: mockSearchTerm,
+        setSearchTerm: mockSetSearchTerm,
+        loading: false,
+        error: undefined,
+        results: [],
+        hasMore: false,
+        handleLoadMore: mockHandleLoadMore,
+      };
+    },
+  };
+});
+
+// Mock AffiliationDropdown — simplified rendering for testing interactions
+jest.mock("../AffiliationDropdown/AffiliationDropdown", () => {
+  return {
+    AffiliationDropdown: ({ searchTerm, onSelect, onAddManually }: any) => (
+      <div data-testid="affiliation-dropdown">
+        <span data-testid="dropdown-search-term">{searchTerm}</span>
+        <button data-testid="dropdown-select" onClick={() => onSelect({ rorId: "041nk4h34", name: "MIT" })}>
+          Select MIT
+        </button>
+        <button data-testid="dropdown-add-manually" onClick={onAddManually}>
+          Add manually
+        </button>
+      </div>
+    ),
+  };
+});
+
+
+describe("<RorSearchField />", () => {
+  beforeEach(() => {
+    mockSearchTerm = "";
+    mockSetSearchTerm.mockClear();
+    mockHandleLoadMore.mockClear();
+  });
+
+  function setup() {
+    const scope: TestScope = {
+      user: userEvent.setup(),
+      props: { onSelect: jest.fn() },
+    };
+
+    scope.run = () => {
+      scope.wrapper = render(<RorSearchField {...scope.props} />);
+    };
+
+    scope.rerender = () => {
+      scope.wrapper.rerender(<RorSearchField {...scope.props} />);
+    };
+
+    // Helper to find the search input by placeholder
+    scope.getInput = () => screen.getByPlaceholderText(
+      scope.props.placeholder || "Search the ROR registry or type a name"
+    );
+
+    return scope;
+  }
+
+  function teardown() {
+    cleanup();
+  }
+
+  // -- Rendering --
+
+  it("renders search input with default placeholder", () => {
+    const scope = setup();
+    scope.run();
+
+    expect(scope.getInput()).toBeInTheDocument();
+    expect(scope.getInput()).toHaveAttribute("placeholder", "Search the ROR registry or type a name");
+
+    teardown();
+  });
+
+  it("renders search input with custom placeholder", () => {
+    const scope = setup();
+    scope.props.placeholder = "Find an organization";
+    scope.run();
+
+    expect(screen.getByPlaceholderText("Find an organization")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("shows Cancel button when onCancel is provided", () => {
+    const scope = setup();
+    scope.props.onCancel = jest.fn();
+    scope.run();
+
+    expect(screen.getByText("Cancel")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("hides Cancel button when onCancel is not provided", () => {
+    const scope = setup();
+    scope.run();
+
+    // No onCancel → no Cancel button
+    expect(screen.queryByText("Cancel")).not.toBeInTheDocument();
+
+    teardown();
+  });
+
+  // -- Cancel behavior --
+
+  it("clicking Cancel calls onCancel and clears search term", () => {
+    const scope = setup();
+    scope.props.onCancel = jest.fn();
+    scope.run();
+
+    // Use fireEvent.click to avoid jsdom addRange bug near SearchInput
+    fireEvent.click(screen.getByText("Cancel"));
+
+    expect(mockSetSearchTerm).toHaveBeenCalledWith("");
+    expect(scope.props.onCancel).toHaveBeenCalled();
+
+    teardown();
+  });
+
+  // -- Typing in search --
+
+  it("typing in search input calls setSearchTerm and onChange", async() => {
+    const scope = setup();
+    scope.props.onChange = jest.fn();
+    scope.run();
+
+    const input = scope.getInput();
+    // Use fireEvent.focus + userEvent.type to avoid jsdom addRange bug
+    fireEvent.focus(input);
+    await scope.user.type(input, "M");
+
+    // setSearchTerm is called for each character typed
+    expect(mockSetSearchTerm).toHaveBeenCalledWith("M");
+    expect(scope.props.onChange).toHaveBeenCalledWith("M");
+
+    teardown();
+  });
+
+  // -- Dropdown visibility --
+
+  it("shows the dropdown by default when showOnFocus is false (default)", () => {
+    const scope = setup();
+    scope.run();
+
+    // Default showOnFocus=false → dropdown starts visible
+    expect(screen.getByTestId("affiliation-dropdown")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  // -- Select from dropdown --
+
+  it("selecting from dropdown calls onSelect and closes dropdown", async() => {
+    const scope = setup();
+    scope.run();
+
+    await scope.user.click(screen.getByTestId("dropdown-select"));
+
+    // onSelect receives the org object
+    expect(scope.props.onSelect).toHaveBeenCalledWith({ rorId: "041nk4h34", name: "MIT" });
+    // setSearchTerm updates to the selected org name
+    expect(mockSetSearchTerm).toHaveBeenCalledWith("MIT");
+
+    teardown();
+  });
+
+  // -- Add manually --
+
+  it("add manually calls onAddManually with the current search term", async() => {
+    const scope = setup();
+    scope.props.onAddManually = jest.fn();
+    scope.run();
+
+    await scope.user.click(screen.getByTestId("dropdown-add-manually"));
+
+    // Passes the trimmed search term (empty in this case since mockSearchTerm="")
+    expect(scope.props.onAddManually).toHaveBeenCalledWith("");
+    expect(mockSetSearchTerm).toHaveBeenCalledWith("");
+
+    teardown();
+  });
+
+  // -- Controlled value --
+
+  it("controlled value prop overrides internal searchTerm display", () => {
+    const scope = setup();
+    scope.props.value = "Controlled Value";
+    scope.run();
+
+    // The input should display the controlled value, not the hook's searchTerm
+    expect(scope.getInput()).toHaveValue("Controlled Value");
+
+    teardown();
+  });
+});
