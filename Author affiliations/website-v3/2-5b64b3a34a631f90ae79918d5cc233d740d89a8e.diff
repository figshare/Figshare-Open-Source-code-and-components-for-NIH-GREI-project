+import React from "react";
+import { render, cleanup, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { TestScope } from "types/testing";
+
+import { BulkAddAffiliationsOverlay } from "./BulkAddAffiliationsOverlay";
+
+
+// Mock AffiliationsSelector — provides a button to simulate adding affiliations
+jest.mock("../../authorEditor/AffiliationsSelector/AffiliationsSelector", () => {
+  return {
+    AffiliationsSelector: ({ affiliations, onChange }: any) => (
+      <div data-testid="affiliations-selector">
+        <span data-testid="affiliations-count">{affiliations.length}</span>
+        <button
+          data-testid="add-affiliation"
+          onClick={() => onChange([...affiliations, { name: "MIT" }])}
+        >
+          Add MIT
+        </button>
+      </div>
+    ),
+  };
+});
+
+
+describe("<BulkAddAffiliationsOverlay />", () => {
+  function setup() {
+    const scope: TestScope = {
+      user: userEvent.setup(),
+      props: {
+        isVisible: true,
+        selectedCount: 3,
+        onClose: jest.fn(),
+        onSubmit: jest.fn(),
+      },
+    };
+
+    scope.run = () => {
+      scope.wrapper = render(<BulkAddAffiliationsOverlay {...scope.props} />);
+    };
+
+    scope.rerender = () => {
+      scope.wrapper.rerender(<BulkAddAffiliationsOverlay {...scope.props} />);
+    };
+
+    return scope;
+  }
+
+  function teardown() {
+    cleanup();
+  }
+
+  // -- Visibility --
+
+  it("renders nothing when isVisible is false", () => {
+    const scope = setup();
+    scope.props.isVisible = false;
+    scope.run();
+
+    // FCL Overlay returns null when not visible
+    expect(screen.queryByText("Add affiliations to multiple authors")).not.toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("renders overlay with title and description when visible", () => {
+    const scope = setup();
+    scope.run();
+
+    expect(screen.getByText("Add affiliations to multiple authors")).toBeInTheDocument();
+    expect(screen.getByText(/Choose the affiliations/)).toBeInTheDocument();
+
+    teardown();
+  });
+
+  // -- Content --
+
+  it("shows AffiliationsSelector and selected count", () => {
+    const scope = setup();
+    scope.run();
+
+    expect(screen.getByTestId("affiliations-selector")).toBeInTheDocument();
+    expect(screen.getByText("Adding affiliations to 3 selected author(s).")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  // -- Cancel --
+
+  it("Cancel button calls onClose", async() => {
+    const scope = setup();
+    scope.run();
+
+    await scope.user.click(screen.getByText("Cancel"));
+
+    expect(scope.props.onClose).toHaveBeenCalled();
+
+    teardown();
+  });
+
+  // -- Submit button disabled state --
+
+  it("submit button is disabled when no affiliations are added", () => {
+    const scope = setup();
+    scope.run();
+
+    // FCL FclButton uses aria-disabled instead of the native disabled attribute
+    const submitButton = screen.getByRole("button", { name: "Add affiliations" });
+    expect(submitButton).toHaveAttribute("aria-disabled", "true");
+
+    teardown();
+  });
+
+  it("submit button is enabled after adding an affiliation", async() => {
+    const scope = setup();
+    scope.run();
+
+    // Add an affiliation via the mocked selector
+    await scope.user.click(screen.getByTestId("add-affiliation"));
+
+    // The submit button should now be enabled
+    const submitButton = screen.getByText("Add affiliations");
+    expect(submitButton).not.toBeDisabled();
+
+    teardown();
+  });
+
+  // -- Submit --
+
+  it("submitting calls onSubmit with affiliations", async() => {
+    const scope = setup();
+    scope.run();
+
+    // Add an affiliation, then submit
+    await scope.user.click(screen.getByTestId("add-affiliation"));
+    await scope.user.click(screen.getByText("Add affiliations"));
+
+    expect(scope.props.onSubmit).toHaveBeenCalledWith([{ name: "MIT" }]);
+
+    teardown();
+  });
+
+  // -- Selected count display --
+
+  it("shows correct selected count from props", () => {
+    const scope = setup();
+    scope.props.selectedCount = 5;
+    scope.run();
+
+    expect(screen.getByText("Adding affiliations to 5 selected author(s).")).toBeInTheDocument();
+
+    teardown();
+  });
+});
