+import React from "react";
+import { render, cleanup, screen } from "@testing-library/react";
+
+import { RorOrganization } from "../OrganizationList/OrganizationList";
+
+import { SearchDropdown } from "./SearchDropdown";
+
+
+// Render ContentBox and LoaderContentBox as simple wrappers so we can
+// assert on content without dealing with the real component's side effects
+jest.mock(
+  "../../../../itemEdit/main/form/formField/figshareFields/authors/components/contentBox",
+  () => {
+    return {
+      ContentBox: ({ children }: { children: React.ReactNode }) => (
+        <div data-testid="content-box">{children}</div>
+      ),
+      LoaderContentBox: () => <div data-testid="loader-content-box" />,
+    };
+  }
+);
+
+// OrganizationList and OrganizationListItem are tested separately; stub them out
+jest.mock("../OrganizationList/OrganizationList", () => {
+  return {
+    OrganizationList: ({ children }: { children: React.ReactNode }) => (
+      <ul data-testid="organization-list">{children}</ul>
+    ),
+    OrganizationListItem: ({ org }: { org: RorOrganization }) => (
+      <li data-testid="organization-list-item">{org.name}</li>
+    ),
+  };
+});
+
+// Button renders as a native button for click assertions
+function MockButton({ children, onClick }: { children: React.ReactNode; onClick?: () => void }) {
+  return <button type="button" onClick={onClick}>{children}</button>;
+}
+MockButton.Label = ({ children }: { children: React.ReactNode }) => <span>{children}</span>;
+MockButton.Icon = ({ children }: { children: React.ReactNode }) => <span>{children}</span>;
+jest.mock("shared/ui/latest/Button", () => {
+  return { Button: MockButton };
+});
+
+
+const sampleResults: RorOrganization[] = [
+  { rorId: "01abc", name: "MIT" },
+  { rorId: "02def", name: "Harvard" },
+];
+
+describe("SearchDropdown", () => {
+  function teardown() {
+    cleanup();
+  }
+
+  it("renders correctly when searchTerm is \"\" — shows empty state message", () => {
+    render(
+      <SearchDropdown
+        hasMore={true}
+        loading={false}
+        results={[]}
+        searchTerm=""
+        onAddManually={jest.fn()}
+      />
+    );
+
+    expect(
+      screen.getByText("Start typing to search for an organization, or add manually.")
+    ).toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("renders correctly when searchTerm length is less than 3 — returns null", () => {
+    const { container } = render(
+      <SearchDropdown
+        hasMore={true}
+        loading={false}
+        results={[]}
+        searchTerm="ab"
+        onAddManually={jest.fn()}
+      />
+    );
+
+    expect(container.firstChild).toBeNull();
+
+    teardown();
+  });
+
+  it("renders correctly when loading and no results — shows loader", () => {
+    render(
+      <SearchDropdown
+        hasMore={true}
+        loading={true}
+        results={[]}
+        searchTerm="mit"
+        onAddManually={jest.fn()}
+      />
+    );
+
+    expect(screen.getByTestId("loader-content-box")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("renders correctly when not loading and no results — shows \"No organizations found\"", () => {
+    render(
+      <SearchDropdown
+        hasMore={true}
+        loading={false}
+        results={[]}
+        searchTerm="xyz"
+        onAddManually={jest.fn()}
+      />
+    );
+
+    expect(screen.getByText("No organizations found")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("renders correctly when results exist — shows the results list", () => {
+    render(
+      <SearchDropdown
+        hasMore={true}
+        loading={false}
+        results={sampleResults}
+        searchTerm="mit"
+        onAddManually={jest.fn()}
+      />
+    );
+
+    expect(screen.getByTestId("organization-list")).toBeInTheDocument();
+    expect(screen.getByText("MIT")).toBeInTheDocument();
+    expect(screen.getByText("Harvard")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("renders correctly when hasMore is false — shows \"Not on the list?\" footer", () => {
+    render(
+      <SearchDropdown
+        hasMore={false}
+        loading={false}
+        results={sampleResults}
+        searchTerm="mit"
+        onAddManually={jest.fn()}
+      />
+    );
+
+    expect(screen.getByText("Not on the list?")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("renders correctly when hasMore is true — does not show the footer", () => {
+    render(
+      <SearchDropdown
+        hasMore={true}
+        loading={false}
+        results={sampleResults}
+        searchTerm="mit"
+        onAddManually={jest.fn()}
+      />
+    );
+
+    expect(screen.queryByText("Not on the list?")).not.toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("renders error state when error is provided", () => {
+    render(
+      <SearchDropdown
+        error={new Error("Network error")}
+        hasMore={false}
+        loading={false}
+        results={[]}
+        searchTerm="mit"
+        onAddManually={jest.fn()}
+      />
+    );
+
+    expect(screen.getByText("Something went wrong. Please try again.")).toBeInTheDocument();
+    expect(screen.getByRole("button", { name: /Add organization details/i })).toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("renders error state instead of no-results when both error and empty results", () => {
+    render(
+      <SearchDropdown
+        error={new Error("Server error")}
+        hasMore={false}
+        loading={false}
+        results={[]}
+        searchTerm="xyz"
+        onAddManually={jest.fn()}
+      />
+    );
+
+    // Should show error, not "No organizations found"
+    expect(screen.getByText("Something went wrong. Please try again.")).toBeInTheDocument();
+    expect(screen.queryByText("No organizations found")).not.toBeInTheDocument();
+
+    teardown();
+  });
+});
diff --git a/src/pages/account/profileEdit/components/affiliations/SearchDropdown/SearchDropdown.tsx b/src/pages/account/profileEdit/components/affiliations/SearchDropdown/SearchDropdown.tsx
new file mode 100644
index 000000000..b1a594808
--- /dev/null
+++ b/src/pages/account/profileEdit/components/affiliations/SearchDropdown/SearchDropdown.tsx
@@ -0,0 +1,90 @@
+import React from "react";
+import { Button } from "shared/ui/latest/Button";
+
+import {
+  ContentBox,
+  LoaderContentBox,
+} from "../../../../itemEdit/main/form/formField/figshareFields/authors/components/contentBox";
+import { OrganizationList, OrganizationListItem, RorOrganization } from "../OrganizationList/OrganizationList";
+
+import styles from "./SearchDropdown.module.css";
+
+
+interface SearchDropdownProps {
+  loading: boolean;
+  error?: Error;
+  results: RorOrganization[];
+  searchTerm: string;
+  hasMore: boolean;
+  onSelect?: (org: RorOrganization) => void;
+  onAddManually?: () => void;
+  onLoadMore?: () => void;
+}
+
+
+export function SearchDropdown({ loading, error, results, searchTerm, hasMore, onSelect, onAddManually, onLoadMore }: SearchDropdownProps) {
+  const isEmpty = searchTerm === "";
+  const hasQuery = searchTerm.length >= 3;
+
+  if (isEmpty) {
+    return (
+      <ContentBox layout="dropdown" spacing="none" theme="primary">
+        <div className={styles.emptyState}>
+          <span className={styles.emptyStateText}>Start typing to search for an organization, or add manually.</span>
+          <Button onClick={onAddManually}>Add organization details</Button>
+        </div>
+      </ContentBox>
+    );
+  }
+
+  if (!hasQuery) {
+    return null;
+  }
+
+  if (loading && results.length === 0) {
+    return <LoaderContentBox />;
+  }
+
+  if (error) {
+    return (
+      <ContentBox layout="dropdown" spacing="none" theme="primary">
+        <div className={styles.emptyState}>
+          <span aria-live="assertive" className={styles.emptyStateText} role="alert">Something went wrong. Please try again.</span>
+          <Button onClick={onAddManually}>Add organization details</Button>
+        </div>
+      </ContentBox>
+    );
+  }
+
+  if (!loading && results.length === 0) {
+    return (
+      <ContentBox layout="dropdown" spacing="none" theme="primary">
+        <div className={styles.emptyState}>
+          <span aria-live="assertive" className={styles.emptyStateText} role="status">No organizations found</span>
+          <Button onClick={onAddManually}>Add organization details</Button>
+        </div>
+      </ContentBox>
+    );
+  }
+
+  return (
+    <ContentBox className={styles.resultsWrap} layout="dropdown" spacing="none" theme="primary">
+      <OrganizationList onScrollToBottom={onLoadMore}>
+        {results.map((org) => (
+          <OrganizationListItem key={org.rorId} org={org} onSelect={onSelect} />
+        ))}
+      </OrganizationList>
+      {!hasMore && (
+        <>
+          <div className={styles.separator}>
+            <div className={styles.separatorLine} />
+          </div>
+          <div className={styles.listFooter}>
+            <span className={styles.listFooterText}>Not on the list?</span>
+            <Button onClick={onAddManually}>Add organization details</Button>
+          </div>
+        </>
+      )}
+    </ContentBox>
+  );
+}
