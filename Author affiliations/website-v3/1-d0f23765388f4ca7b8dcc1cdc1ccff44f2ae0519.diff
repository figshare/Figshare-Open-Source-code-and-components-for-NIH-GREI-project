+import React from "react";
+import { render, cleanup, screen, fireEvent } from "@testing-library/react";
+
+import { AffiliationRow } from "./AffiliationRow";
+
+
+// Button renders as a native button that forwards onClick/disabled and renders
+// children. Button.Icon and Button.Label are pass-through spans so their
+// text content contributes to the accessible button name.
+jest.mock("shared/ui/latest/Button", () => {
+  const Button = ({
+    children,
+    onClick,
+    disabled,
+  }: {
+    children: React.ReactNode;
+    onClick?: () => void;
+    disabled?: boolean;
+  }) => (
+    <button type="button" disabled={disabled} onClick={onClick}>
+      {children}
+    </button>
+  );
+
+  Button.Icon = ({ children }: { children: React.ReactNode }) => <span>{children}</span>;
+  Button.Label = ({ children }: { children: React.ReactNode }) => <span>{children}</span>;
+
+  return { Button };
+});
+
+// All FCL SVG icon imports render as a plain span so they don't require
+// the real SVG assets in the test environment.
+jest.mock("@digital-science/figshare-fcl/icons/react/DragDrop", () => {
+  return {
+    __esModule: true,
+    default: () => <span>icon</span>,
+  };
+});
+
+jest.mock("@digital-science/figshare-fcl/icons/react/ChevronUp", () => {
+  return {
+    __esModule: true,
+    default: () => <span>icon</span>,
+  };
+});
+
+jest.mock("@digital-science/figshare-fcl/icons/react/ChevronDown", () => {
+  return {
+    __esModule: true,
+    default: () => <span>icon</span>,
+  };
+});
+
+jest.mock("@digital-science/figshare-fcl/icons/react/Edit", () => {
+  return {
+    __esModule: true,
+    default: () => <span>icon</span>,
+  };
+});
+
+jest.mock("@digital-science/figshare-fcl/icons/react/Delete", () => {
+  return {
+    __esModule: true,
+    default: () => <span>icon</span>,
+  };
+});
+
+jest.mock("@digital-science/figshare-fcl/icons/react/GoToLink", () => {
+  return {
+    __esModule: true,
+    default: () => <span>icon</span>,
+  };
+});
+
+
+describe("AffiliationRow", () => {
+  // Default props that satisfy the interface; individual tests override as needed
+  const defaultProps = {
+    affiliation: { name: "MIT", url: "https://mit.edu" },
+    reorderable: true,
+    isFirst: false,
+    isLast: false,
+    onEdit: jest.fn(),
+    onDelete: jest.fn(),
+    onMoveUp: jest.fn(),
+    onMoveDown: jest.fn(),
+  };
+
+  function teardown() {
+    cleanup();
+  }
+
+  it("renders affiliation name", () => {
+    render(<AffiliationRow {...defaultProps} />);
+
+    expect(screen.getByText("MIT")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("renders URL as a link when url is present", () => {
+    render(<AffiliationRow {...defaultProps} />);
+
+    const link = screen.getByRole("link");
+    expect(link).toHaveAttribute("href", "https://mit.edu");
+
+    teardown();
+  });
+
+  it("does not render a link when url is empty", () => {
+    render(
+      <AffiliationRow
+        {...defaultProps}
+        affiliation={ { name: "MIT", url: "" } }
+      />
+    );
+
+    expect(screen.queryByRole("link")).not.toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("calls onEdit when the Edit button is clicked", () => {
+    const onEdit = jest.fn();
+    render(<AffiliationRow {...defaultProps} onEdit={onEdit} />);
+
+    fireEvent.click(screen.getByRole("button", { name: /Edit/i }));
+
+    expect(onEdit).toHaveBeenCalledTimes(1);
+
+    teardown();
+  });
+
+  it("calls onDelete when the Delete button is clicked", () => {
+    const onDelete = jest.fn();
+    render(<AffiliationRow {...defaultProps} onDelete={onDelete} />);
+
+    fireEvent.click(screen.getByRole("button", { name: /Delete/i }));
+
+    expect(onDelete).toHaveBeenCalledTimes(1);
+
+    teardown();
+  });
+
+  it("calls onMoveUp when the Move up button is clicked", () => {
+    const onMoveUp = jest.fn();
+    render(<AffiliationRow {...defaultProps} onMoveUp={onMoveUp} />);
+
+    fireEvent.click(screen.getByRole("button", { name: /Move up/i }));
+
+    expect(onMoveUp).toHaveBeenCalledTimes(1);
+
+    teardown();
+  });
+
+  it("calls onMoveDown when the Move down button is clicked", () => {
+    const onMoveDown = jest.fn();
+    render(<AffiliationRow {...defaultProps} onMoveDown={onMoveDown} />);
+
+    fireEvent.click(screen.getByRole("button", { name: /Move down/i }));
+
+    expect(onMoveDown).toHaveBeenCalledTimes(1);
+
+    teardown();
+  });
+
+  it("disables the Move up button when isFirst=true", () => {
+    render(<AffiliationRow {...defaultProps} isFirst={true} />);
+
+    expect(screen.getByRole("button", { name: /Move up/i })).toBeDisabled();
+
+    teardown();
+  });
+
+  it("disables the Move down button when isLast=true", () => {
+    render(<AffiliationRow {...defaultProps} isLast={true} />);
+
+    expect(screen.getByRole("button", { name: /Move down/i })).toBeDisabled();
+
+    teardown();
+  });
+});
