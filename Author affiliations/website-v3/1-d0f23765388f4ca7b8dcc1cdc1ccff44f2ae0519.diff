+import React from "react";
+import { render, cleanup, screen, waitFor } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { TestScope } from "types/testing";
+
+import { AffiliationOverlay } from "./AffiliationOverlay";
+
+
+// Overlay renders its children directly so tests can interact with inner content
+jest.mock("@digital-science/figshare-fcl/overlay", () => {
+  return {
+    Overlay: ({ children, isVisible }: { children: React.ReactNode; isVisible: boolean }) =>
+      isVisible ? <div data-testid="overlay">{children}</div> : null,
+    OverlayHeader: ({ title }: { title: string }) => <div data-testid="overlay-header">{title}</div>,
+    OverlayContent: ({ children }: { children: React.ReactNode }) => <div>{children}</div>,
+    OverlayFooter: Object.assign(
+      ({ children }: { children: React.ReactNode }) => <div>{children}</div>,
+      { Primary: ({ children }: { children: React.ReactNode }) => <div>{children}</div> }
+    ),
+  };
+});
+
+// Button renders as a native button so clicks are testable
+function MockButton({ children, onClick }: { children: React.ReactNode; onClick?: () => void }) {
+  return <button type="button" onClick={onClick}>{children}</button>;
+}
+MockButton.Label = ({ children }: { children: React.ReactNode }) => <span>{children}</span>;
+MockButton.Icon = ({ children }: { children: React.ReactNode }) => <span>{children}</span>;
+jest.mock("shared/ui/latest/Button", () => {
+  return { Button: MockButton };
+});
+
+// TextInput renders as a native input; forward name/disabled/value/onChange
+jest.mock("@digital-science/figshare-fcl/input/text", () => {
+  return {
+    __esModule: true,
+    default: (props: {
+      disabled?: boolean;
+      value?: string;
+      name?: string;
+      onChange?: React.ChangeEventHandler<HTMLInputElement>;
+      placeholder?: string;
+      id?: string;
+    }) => (
+      <input
+        disabled={props.disabled}
+        id={props.id}
+        name={props.name}
+        placeholder={props.placeholder}
+        type="text"
+        value={props.value}
+        onChange={props.onChange}
+      />
+    ),
+  };
+});
+
+
+describe("AffiliationOverlay", () => {
+  function setup() {
+    const scope: TestScope = {
+      user: userEvent.setup(),
+      props: {
+        isVisible: true,
+        isEditing: false,
+        affiliation: undefined,
+        onSave: jest.fn(),
+        onClose: jest.fn(),
+      },
+    };
+
+    scope.run = () => {
+      scope.wrapper = render(<AffiliationOverlay {...scope.props} />);
+    };
+
+    return scope;
+  }
+
+  function teardown() {
+    cleanup();
+  }
+
+  it("renders correctly when isEditing is false — shows \"Add affiliation\" title and button", () => {
+    const scope = setup();
+    scope.run();
+
+    expect(screen.getByTestId("overlay-header")).toHaveTextContent("Add affiliation");
+    // The submit button label should say "Add affiliation", not "Save affiliation"
+    expect(screen.getByRole("button", { name: "Add affiliation" })).toBeInTheDocument();
+    expect(screen.queryByRole("button", { name: "Save affiliation" })).not.toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("renders correctly when isEditing is true — shows \"Edit affiliation\" title and \"Save affiliation\" button", () => {
+    const scope = setup();
+    scope.props.isEditing = true;
+    scope.props.affiliation = { name: "MIT", url: "https://mit.edu" };
+    scope.run();
+
+    expect(screen.getByTestId("overlay-header")).toHaveTextContent("Edit affiliation");
+    expect(screen.getByRole("button", { name: "Save affiliation" })).toBeInTheDocument();
+    expect(screen.queryByRole("button", { name: "Add affiliation" })).not.toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("renders correctly when affiliation has a rorId — name field is disabled", () => {
+    const scope = setup();
+    scope.props.affiliation = { rorId: "01abc123", name: "MIT", url: "https://mit.edu" };
+    scope.run();
+
+    // The first input is the name field
+    const inputs = screen.getAllByRole("textbox");
+    expect(inputs[0]).toBeDisabled();
+
+    teardown();
+  });
+
+  it("renders correctly when affiliation has no rorId — name field is editable", () => {
+    const scope = setup();
+    scope.props.affiliation = { name: "My Org", url: "" };
+    scope.run();
+
+    const inputs = screen.getAllByRole("textbox");
+    expect(inputs[0]).not.toBeDisabled();
+
+    teardown();
+  });
+
+  it("shows an error when saving with an empty name", async() => {
+    const scope = setup();
+    scope.run();
+
+    await scope.user.click(screen.getByRole("button", { name: "Add affiliation" }));
+
+    await waitFor(() => {
+      expect(screen.getByText("Affiliation name is required")).toBeInTheDocument();
+    });
+    expect(scope.props.onSave).not.toHaveBeenCalled();
+
+    teardown();
+  });
+
+  it("calls onSave with trimmed values when name is provided", async() => {
+    const scope = setup();
+    scope.run();
+
+    const [nameInput, urlInput] = screen.getAllByRole("textbox");
+    await scope.user.type(nameInput, "  Harvard  ");
+    await scope.user.type(urlInput, "  https://harvard.edu  ");
+
+    await scope.user.click(screen.getByRole("button", { name: "Add affiliation" }));
+
+    await waitFor(() => {
+      expect(scope.props.onSave).toHaveBeenCalledWith({
+        rorId: "",
+        name: "Harvard",
+        url: "https://harvard.edu",
+      });
+    });
+
+    teardown();
+  });
+
+  it("shows an error when saving with an invalid URL", async() => {
+    const scope = setup();
+    scope.run();
+
+    const [nameInput, urlInput] = screen.getAllByRole("textbox");
+    await scope.user.type(nameInput, "My Org");
+    await scope.user.type(urlInput, "not-a-valid-url");
+
+    await scope.user.click(screen.getByRole("button", { name: "Add affiliation" }));
+
+    await waitFor(() => {
+      expect(screen.getByText("Please enter a valid URL")).toBeInTheDocument();
+    });
+    expect(scope.props.onSave).not.toHaveBeenCalled();
+
+    teardown();
+  });
+
+  it("allows saving with an empty URL — URL is optional", async() => {
+    const scope = setup();
+    scope.run();
+
+    const [nameInput] = screen.getAllByRole("textbox");
+    await scope.user.type(nameInput, "My Org");
+
+    await scope.user.click(screen.getByRole("button", { name: "Add affiliation" }));
+
+    await waitFor(() => {
+      expect(scope.props.onSave).toHaveBeenCalledWith({ rorId: "", name: "My Org", url: "" });
+    });
+
+    teardown();
+  });
+
+  it("calls onClose when the Cancel button is clicked", async() => {
+    const scope = setup();
+    scope.run();
+
+    await scope.user.click(screen.getByRole("button", { name: "Cancel" }));
+
+    expect(scope.props.onClose).toHaveBeenCalledTimes(1);
+
+    teardown();
+  });
+});
