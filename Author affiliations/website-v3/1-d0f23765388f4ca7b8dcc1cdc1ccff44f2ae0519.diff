+import React, { useCallback, useMemo, useEffect } from "react";
+import { Overlay, OverlayHeader, OverlayContent, OverlayFooter } from "@digital-science/figshare-fcl/overlay";
+import { useForm, Field, Form, FormContext, TextFieldComponent } from "shared/ui/forms";
+import getIn from "utils/getIn";
+import { Button } from "shared/ui/latest/Button";
+import { isValidUrl } from "utils/validation";
+
+import styles from "./AffiliationOverlay.module.css";
+
+
+interface Affiliation {
+  rorId?: string;
+  name: string;
+  url: string;
+}
+
+interface AffiliationOverlayProps {
+  isVisible: boolean;
+  isEditing?: boolean;
+  affiliation?: Affiliation;
+  onSave: (affiliation: Affiliation) => void;
+  onClose: () => void;
+}
+
+// Schema defines the form fields, their initial values, labels, and required status
+const AFFILIATION_FORM_SCHEMA = {
+  id: "edit-affiliation",
+  namespace: "affiliations",
+  order: ["name", "url"],
+  fields: {
+    name: {
+      id: "name",
+      value: "",
+      initial: "",
+      disabled: false,
+      required: true,
+      settings: { label: "Affiliation name" },
+    },
+    url: {
+      id: "url",
+      value: "",
+      initial: "",
+      disabled: false,
+      required: false,
+      settings: { label: "URL" },
+    },
+  },
+};
+
+// Validation rules: name is required, url must be valid if provided
+const AFFILIATION_FORM_VALIDATION = {
+  name: [{
+    at: ["blur:touched", "submit"],
+    type: "compoundValidation",
+    withResults: true,
+    fn: (value: string) => {
+      if (!value?.trim()) {
+        return { valid: false, message: "Affiliation name is required" };
+      }
+
+      return undefined;
+    },
+  }],
+  url: [{
+    at: ["blur:touched", "submit"],
+    type: "compoundValidation",
+    withResults: true,
+    fn: (value: string) => {
+      const trimmed = value?.trim();
+
+      if (trimmed && !isValidUrl(trimmed)) {
+        return { valid: false, message: "Please enter a valid URL" };
+      }
+
+      return undefined;
+    },
+  }],
+};
+
+
+export function AffiliationOverlay({
+  isVisible,
+  isEditing = false,
+  affiliation,
+  onSave,
+  onClose,
+}: AffiliationOverlayProps) {
+  // Seed form data from the affiliation prop when the overlay opens
+  const initialFormData = useMemo(() => {
+    return { name: affiliation?.name || "", url: affiliation?.url || "" };
+  }, [affiliation?.name, affiliation?.url]);
+
+  const formMeta = useMemo(() => {
+    return {};
+  }, []);
+
+  const form = useForm({
+    schema: AFFILIATION_FORM_SCHEMA,
+    validation: AFFILIATION_FORM_VALIDATION,
+    data: initialFormData,
+    meta: formMeta,
+    persist: false,
+    sync: true,
+  });
+
+  // Reset the form when the overlay opens to reflect the current affiliation
+  useEffect(() => {
+    if (isVisible) {
+      form.resetForm({ data: { name: affiliation?.name || "", url: affiliation?.url || "" } });
+    }
+  }, [isVisible]); // eslint-disable-line
+
+  const handleSave = useCallback(() => {
+    const { valid } = form.validateForm({ at: "submit" });
+
+    if (!valid) {
+      return;
+    }
+
+    const nameValue = getIn(form, "state.fields.name.value", "").trim();
+    const urlValue = getIn(form, "state.fields.url.value", "").trim();
+
+    onSave({
+      rorId: affiliation?.rorId || "",
+      name: nameValue,
+      url: urlValue,
+    });
+  }, [form, affiliation, onSave]);
+
+  // Disable the name field when editing a ROR-sourced affiliation
+  const isNameDisabled = !!affiliation?.rorId;
+
+  return (
+    <Overlay
+      background="primary"
+      className={styles.overlay}
+      id="edit-affiliation-overlay"
+      isVisible={isVisible}
+      onClose={onClose}
+    >
+      <OverlayHeader title={isEditing ? "Edit affiliation" : "Add affiliation"} />
+      <OverlayContent>
+        <FormContext.Provider value={form}>
+          <Form id={form.state.formId}>
+            <div className={styles.fields}>
+              <Field
+                name="name"
+                required={true}
+                validateOnBlur={true}
+                component={TextFieldComponent}
+                disabled={isNameDisabled}
+              />
+              <Field
+                name="url"
+                validateOnBlur={true}
+                component={TextFieldComponent}
+              />
+            </div>
+          </Form>
+        </FormContext.Provider>
+      </OverlayContent>
+      <OverlayFooter>
+        <OverlayFooter.Primary>
+          <Button kind="secondary" em="low" onClick={onClose}><Button.Label>Cancel</Button.Label></Button>
+          <Button kind="primary" onClick={handleSave}>
+            <Button.Label>{isEditing ? "Save affiliation" : "Add affiliation"}</Button.Label>
+          </Button>
+        </OverlayFooter.Primary>
+      </OverlayFooter>
+    </Overlay>
+  );
+}
