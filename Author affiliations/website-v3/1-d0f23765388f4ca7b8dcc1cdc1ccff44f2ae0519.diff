+import { renderHook, act } from "@testing-library/react-hooks";
+
+import { useRorSearch } from "./useRorSearch";
+
+
+// Mock useLazyQuery — returns a stable executeSearch fn and query result
+const mockExecuteSearch = jest.fn();
+const mockFetchMore = jest.fn();
+
+jest.mock("@apollo/client/react/hooks", () => {
+  return {
+    useLazyQuery: () => [
+      mockExecuteSearch,
+      {
+        data: {
+          searchRorOrganizations: {
+            cursor: "next-cursor",
+            elements: [{ rorId: "041kmwe10", name: "University of Oxford" }],
+          },
+        },
+        loading: false,
+        fetchMore: mockFetchMore,
+      },
+    ],
+  };
+});
+
+// Mock the GQL query import
+jest.mock("./Affiliations.gql", () => {
+  return { searchRorOrganizations: "mocked-query" };
+});
+
+
+describe("useRorSearch", () => {
+  beforeEach(() => {
+    jest.useFakeTimers();
+    mockExecuteSearch.mockClear();
+    mockFetchMore.mockClear();
+  });
+
+  afterEach(() => {
+    jest.useRealTimers();
+  });
+
+  it("returns initial state with empty searchTerm", () => {
+    const { result } = renderHook(() => useRorSearch());
+
+    expect(result.current.searchTerm).toBe("");
+    expect(result.current.loading).toBe(false);
+    expect(result.current.results).toEqual([{ rorId: "041kmwe10", name: "University of Oxford" }]);
+    expect(result.current.hasMore).toBe(true);
+  });
+
+  it("does not execute search when searchTerm has fewer than 3 characters", () => {
+    const { result } = renderHook(() => useRorSearch());
+
+    act(() => {
+      result.current.setSearchTerm("ab");
+    });
+
+    jest.advanceTimersByTime(500);
+    expect(mockExecuteSearch).not.toHaveBeenCalled();
+  });
+
+  it("executes a debounced search when searchTerm has 3+ characters", () => {
+    const { result } = renderHook(() => useRorSearch());
+
+    act(() => {
+      result.current.setSearchTerm("Oxford");
+    });
+
+    // Should not fire immediately
+    expect(mockExecuteSearch).not.toHaveBeenCalled();
+
+    // Advance past the debounce (300ms)
+    jest.advanceTimersByTime(300);
+
+    expect(mockExecuteSearch).toHaveBeenCalledWith({ variables: { searchTerm: "Oxford", pageSize: 10 } });
+  });
+
+  it("calls fetchMore with cursor when handleLoadMore is invoked", () => {
+    mockFetchMore.mockResolvedValue({});
+    const { result } = renderHook(() => useRorSearch());
+
+    act(() => {
+      result.current.handleLoadMore();
+    });
+
+    expect(mockFetchMore).toHaveBeenCalledWith(
+      expect.objectContaining({ variables: expect.objectContaining({ cursor: "next-cursor" }) })
+    );
+  });
+});
diff --git a/src/pages/account/profileEdit/components/affiliations/useRorSearch.ts b/src/pages/account/profileEdit/components/affiliations/useRorSearch.ts
new file mode 100644
index 000000000..0c287b76b
--- /dev/null
+++ b/src/pages/account/profileEdit/components/affiliations/useRorSearch.ts
@@ -0,0 +1,81 @@
+import { useState, useCallback, useEffect, useRef } from "react";
+import { useLazyQuery } from "@apollo/client/react/hooks";
+
+import { searchRorOrganizations } from "./Affiliations.gql";
+
+
+const DEBOUNCE_MS = 300;
+const PAGE_SIZE = 10;
+
+
+/** Encapsulates the debounced ROR search query with cursor-based pagination. */
+export function useRorSearch() {
+  const [searchTerm, setSearchTerm] = useState("");
+  const debounceRef = useRef<ReturnType<typeof setTimeout> | null>(null);
+  const loadingMoreRef = useRef(false);
+
+  const [executeSearch, { data, loading, error, fetchMore }] = useLazyQuery(searchRorOrganizations, { fetchPolicy: "network-only" });
+
+  // Debounced search — fires after user stops typing
+  useEffect(() => {
+    if (debounceRef.current) {
+      clearTimeout(debounceRef.current);
+    }
+
+    if (searchTerm.length < 3) {
+      // Always return a cleanup function for consistent-return compliance
+      return () => undefined;
+    }
+
+    debounceRef.current = setTimeout(() => {
+      loadingMoreRef.current = false;
+      executeSearch({ variables: { searchTerm, pageSize: PAGE_SIZE } });
+    }, DEBOUNCE_MS);
+
+    return () => {
+      if (debounceRef.current) {
+        clearTimeout(debounceRef.current);
+      }
+    };
+  }, [searchTerm, executeSearch]);
+
+  const handleLoadMore = useCallback(() => {
+    const cursor = data?.searchRorOrganizations?.cursor;
+
+    if (!cursor || loadingMoreRef.current || !fetchMore) {
+      return;
+    }
+
+    loadingMoreRef.current = true;
+
+    fetchMore({
+      variables: { searchTerm, pageSize: PAGE_SIZE, cursor },
+      updateQuery: (prev, { fetchMoreResult }) => {
+        loadingMoreRef.current = false;
+
+        if (!fetchMoreResult) {
+          return prev;
+        }
+
+        return {
+          ...prev,
+          searchRorOrganizations: {
+            ...prev.searchRorOrganizations,
+            cursor: fetchMoreResult.searchRorOrganizations.cursor,
+            elements: [
+              ...prev.searchRorOrganizations.elements,
+              ...fetchMoreResult.searchRorOrganizations.elements,
+            ],
+          },
+        };
+      },
+    }).catch(() => {
+      loadingMoreRef.current = false;
+    });
+  }, [data, searchTerm, fetchMore]);
+
+  const results = data?.searchRorOrganizations?.elements || [];
+  const hasMore = !!data?.searchRorOrganizations?.cursor;
+
+  return { searchTerm, setSearchTerm, loading, error, results, hasMore, handleLoadMore };
+}
