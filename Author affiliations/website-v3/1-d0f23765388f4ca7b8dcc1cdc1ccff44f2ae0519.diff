+import React from "react";
+import { render, cleanup, screen, fireEvent } from "@testing-library/react";
+
+import { OrganizationList, OrganizationListItem } from "./OrganizationList";
+
+
+// Stub out the scroll listener — it wires up DOM event listeners that are
+// irrelevant to these unit tests and would require a real scrollable container
+jest.mock(
+  "../../../../itemEdit/main/form/formField/figshareFields/authors/components/userList/useOnScrollToBottomListener",
+  () => {
+    return {
+      useOnScrollToBottomListener: () => {
+        return { elementRef: { current: null } };
+      },
+    };
+  }
+);
+
+
+const sampleOrg = { rorId: "01abc123", name: "Massachusetts Institute of Technology" };
+
+
+describe("OrganizationList", () => {
+  function teardown() {
+    cleanup();
+  }
+
+  it("renders correctly — wraps children in a container", () => {
+    render(
+      <OrganizationList>
+        <div>Child item</div>
+      </OrganizationList>
+    );
+
+    expect(screen.getByText("Child item")).toBeInTheDocument();
+
+    teardown();
+  });
+});
+
+
+describe("OrganizationListItem", () => {
+  function teardown() {
+    cleanup();
+  }
+
+  it("renders correctly — shows organization name and full ROR URL", () => {
+    render(<OrganizationListItem org={sampleOrg} />);
+
+    expect(screen.getByText("Massachusetts Institute of Technology")).toBeInTheDocument();
+    expect(screen.getByText("https://ror.org/01abc123")).toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("calls onSelect with the org when clicked", () => {
+    const onSelect = jest.fn();
+    render(<OrganizationListItem org={sampleOrg} onSelect={onSelect} />);
+
+    fireEvent.click(screen.getByRole("button"));
+
+    expect(onSelect).toHaveBeenCalledTimes(1);
+    expect(onSelect).toHaveBeenCalledWith(sampleOrg);
+
+    teardown();
+  });
+
+  it("calls onSelect with the org when Enter key is pressed", () => {
+    const onSelect = jest.fn();
+    render(<OrganizationListItem org={sampleOrg} onSelect={onSelect} />);
+
+    fireEvent.keyDown(screen.getByRole("button"), { key: "Enter" });
+
+    expect(onSelect).toHaveBeenCalledTimes(1);
+    expect(onSelect).toHaveBeenCalledWith(sampleOrg);
+
+    teardown();
+  });
+
+  it("calls onSelect with the org when Space key is pressed", () => {
+    const onSelect = jest.fn();
+    render(<OrganizationListItem org={sampleOrg} onSelect={onSelect} />);
+
+    fireEvent.keyDown(screen.getByRole("button"), { key: " " });
+
+    expect(onSelect).toHaveBeenCalledTimes(1);
+    expect(onSelect).toHaveBeenCalledWith(sampleOrg);
+
+    teardown();
+  });
+});
diff --git a/src/pages/account/profileEdit/components/affiliations/OrganizationList/OrganizationList.tsx b/src/pages/account/profileEdit/components/affiliations/OrganizationList/OrganizationList.tsx
new file mode 100644
