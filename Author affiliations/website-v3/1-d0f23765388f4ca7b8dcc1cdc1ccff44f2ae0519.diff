+import React from "react";
+import { Button } from "shared/ui/latest/Button";
+import DragAndDropSvg from "@digital-science/figshare-fcl/icons/react/DragDrop";
+import ChevronUpSvg from "@digital-science/figshare-fcl/icons/react/ChevronUp";
+import ChevronDownSvg from "@digital-science/figshare-fcl/icons/react/ChevronDown";
+import EditSvg from "@digital-science/figshare-fcl/icons/react/Edit";
+import DeleteSvg from "@digital-science/figshare-fcl/icons/react/Delete";
+import GoToLinkSvg from "@digital-science/figshare-fcl/icons/react/GoToLink";
+
+import styles from "./AffiliationRow.module.css";
+
+
+interface Affiliation {
+  rorId?: string;
+  name: string;
+  url?: string;
+}
+
+interface AffiliationRowProps {
+  affiliation: Affiliation;
+  reorderable: boolean;
+  isFirst: boolean;
+  isLast: boolean;
+  dragHandleProps?: any;
+  onMoveUp?: () => void;
+  onMoveDown?: () => void;
+  onEdit?: () => void;
+  onDelete?: () => void;
+}
+
+
+export function AffiliationRow({ affiliation, reorderable, isFirst, isLast, dragHandleProps, onMoveUp, onMoveDown, onEdit, onDelete }: AffiliationRowProps) {
+  return (
+    <div className={styles.row}>
+      <div className={styles.reorder}>
+        <div {...dragHandleProps} className={styles.dragHandle}>
+          <Button kind="tertiary" em={reorderable ? "high" : "low"} span="icon" disabled={!reorderable} data-clickable={false} tabIndex={-1}>
+            <Button.Icon><DragAndDropSvg /></Button.Icon>
+            <Button.Label hidden={true}>Drag</Button.Label>
+          </Button>
+        </div>
+        <Button kind="tertiary" em={isFirst ? "low" : "high"} span="icon" disabled={isFirst} onClick={onMoveUp}>
+          <Button.Icon><ChevronUpSvg /></Button.Icon>
+          <Button.Label hidden={true}>Move up</Button.Label>
+        </Button>
+        <Button kind="tertiary" em={isLast ? "low" : "high"} span="icon" disabled={isLast} onClick={onMoveDown}>
+          <Button.Icon><ChevronDownSvg /></Button.Icon>
+          <Button.Label hidden={true}>Move down</Button.Label>
+        </Button>
+      </div>
+      <div className={styles.content}>
+        <span className={styles.name}>{affiliation.name}</span>
+        {affiliation.url && (
+          <a className={styles.link} href={affiliation.url} rel="noopener noreferrer" target="_blank">
+            <span>{affiliation.url}</span>
+            <GoToLinkSvg className={styles.linkIcon} />
+          </a>
+        )}
+      </div>
+      <div className={styles.actions}>
+        <Button tooltip="Edit affiliation" kind="tertiary" em="low" span="icon" onClick={onEdit}>
+          <Button.Icon><EditSvg /></Button.Icon>
+          <Button.Label hidden={true}>Edit</Button.Label>
+        </Button>
+        <Button tooltip="Remove affiliation" kind="tertiary" em="danger" span="icon" onClick={onDelete}>
+          <Button.Icon><DeleteSvg /></Button.Icon>
+          <Button.Label hidden={true}>Delete</Button.Label>
+        </Button>
+      </div>
+    </div>
+  );
+}
