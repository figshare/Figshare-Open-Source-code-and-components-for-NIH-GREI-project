+import React from "react";
+import { render, cleanup, screen } from "@testing-library/react";
+
+import { AffiliationsList } from "./AffiliationsList";
+
+
+// Render icon as a simple span so assertions on link content are unambiguous
+jest.mock("@digital-science/figshare-fcl/icons/react/GoToLink", () => {
+  return {
+    __esModule: true,
+    default: () => <span>icon</span>,
+  };
+});
+
+
+describe("AffiliationsList", () => {
+  function teardown() {
+    cleanup();
+  }
+
+  it("renders correctly when given an empty affiliations array — returns null", () => {
+    const { container } = render(<AffiliationsList affiliations={[]} />);
+
+    expect(container.firstChild).toBeNull();
+
+    teardown();
+  });
+
+  it("renders correctly when affiliations have no URL — shows plain text", () => {
+    render(
+      <AffiliationsList
+        affiliations={[
+          { name: "University of Example" },
+          { name: "Institute of Science" },
+        ]}
+      />
+    );
+
+    expect(screen.getByText("University of Example")).toBeInTheDocument();
+    expect(screen.getByText("Institute of Science")).toBeInTheDocument();
+    // No links should be present
+    expect(screen.queryByRole("link")).not.toBeInTheDocument();
+
+    teardown();
+  });
+
+  it("renders correctly when affiliations have a URL — shows links with correct href", () => {
+    render(
+      <AffiliationsList
+        affiliations={[
+          { name: "MIT", url: "https://mit.edu" },
+          { name: "Harvard", url: "https://harvard.edu" },
+        ]}
+      />
+    );
+
+    const mitLink = screen.getByRole("link", { name: /MIT/ });
+    const harvardLink = screen.getByRole("link", { name: /Harvard/ });
+
+    expect(mitLink).toHaveAttribute("href", "https://mit.edu");
+    expect(harvardLink).toHaveAttribute("href", "https://harvard.edu");
+
+    teardown();
+  });
+
+  it("renders correctly — links have target='_blank' and rel='noopener noreferrer' for security", () => {
+    render(
+      <AffiliationsList
+        affiliations={[{ name: "Stanford", url: "https://stanford.edu" }]}
+      />
+    );
+
+    const link = screen.getByRole("link", { name: /Stanford/ });
+    expect(link).toHaveAttribute("target", "_blank");
+    expect(link).toHaveAttribute("rel", "noopener noreferrer");
+
+    teardown();
+  });
+});
