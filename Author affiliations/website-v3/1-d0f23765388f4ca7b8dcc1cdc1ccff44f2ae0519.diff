@@ -0,0 +1,46 @@
+.container {
+  width: 100%;
+}
+
+/* Duplicate affiliation alert */
+.duplicateAlert {
+  margin-bottom: calc(2 * var(--gridSize));
+}
+
+.duplicateAlert [data-part="alert-icon-margin"] {
+  margin-top: auto;
+  margin-bottom: auto;
+}
+
+.list {
+  display: flex;
+  flex-direction: column;
+  gap: var(--gridSize);
+
+  margin-bottom: calc(3 * var(--gridSize));
+}
+
+.searchColumn {
+  display: grid;
+  grid-template-columns: 1fr auto;
+  gap: 8px;
+
+  width: 100%;
+}
+
+.searchColumn [data-scope="search-input"] {
+  grid-column: 1;
+}
+
+/* Override ContentBox defaults for dropdowns.
+   grid-column: 1 keeps the dropdown aligned with the search input column only. */
+.searchColumn > [class*="box"] {
+  grid-column: 1;
+
+  min-height: unset;
+  margin-top: 0;
+  padding: var(--gridSize) 0;
+
+  border-radius: var(--gridSize);
+  box-shadow: 2px 2px 7px rgba(0, 0, 0, 0.14);
+}
