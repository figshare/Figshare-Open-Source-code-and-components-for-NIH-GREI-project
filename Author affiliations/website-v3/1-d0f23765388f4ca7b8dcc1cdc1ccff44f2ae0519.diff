@@ -0,0 +1,61 @@
+import React from "react";
+
+import { useOnScrollToBottomListener } from "../../../../itemEdit/main/form/formField/figshareFields/authors/components/userList/useOnScrollToBottomListener";
+
+import styles from "./OrganizationList.module.css";
+
+
+const ROR_URL_PREFIX = "https://ror.org/";
+
+
+export interface RorOrganization {
+  rorId: string;
+  name: string;
+}
+
+interface OrganizationListProps {
+  children: React.ReactNode;
+  onScrollToBottom?: () => void;
+}
+
+interface OrganizationListItemProps {
+  org: RorOrganization;
+  onSelect?: (org: RorOrganization) => void;
+}
+
+
+export function OrganizationList({ children, onScrollToBottom }: OrganizationListProps) {
+  const { elementRef } = useOnScrollToBottomListener(onScrollToBottom);
+
+  return (
+    <div ref={elementRef} className={styles.resultsList}>
+      {children}
+    </div>
+  );
+}
+
+
+export function OrganizationListItem({ org, onSelect }: OrganizationListItemProps) {
+  const handleClick = () => {
+    onSelect?.(org);
+  };
+
+  const handleKeyDown = (event: React.KeyboardEvent) => {
+    if (event.key === "Enter" || event.key === " ") {
+      event.preventDefault();
+      onSelect?.(org);
+    }
+  };
+
+  return (
+    <button
+      className={styles.resultItem}
+      type="button"
+      onClick={handleClick}
+      onKeyDown={handleKeyDown}
+    >
+      <span className={styles.resultName}>{org.name}</span>
+      <span className={styles.resultRorId}>{`${ROR_URL_PREFIX}${org.rorId}`}</span>
+    </button>
+  );
+}
