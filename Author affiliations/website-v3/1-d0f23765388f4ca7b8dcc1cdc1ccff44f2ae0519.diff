+import React from "react";
+import GoToLinkIcon from "@digital-science/figshare-fcl/icons/react/GoToLink";
+
+import styles from "./AffiliationsList.module.css";
+
+
+interface Affiliation {
+  rorId?: string;
+  name: string;
+  url?: string;
+}
+
+interface AffiliationsListProps {
+  affiliations: Affiliation[];
+}
+
+
+/**
+ * Read-only list of affiliations, used on the locked edit profile page
+ * and the public user profile page. Affiliations with a URL render as
+ * links with an external-link icon; others render as plain text.
+ */
+export function AffiliationsList({ affiliations }: AffiliationsListProps) {
+  if (affiliations.length === 0) {
+    return null;
+  }
+
+  return (
+    <ul className={styles.list}>
+      {affiliations.map((aff) => (
+        <li key={aff.rorId || aff.name} className={styles.item}>
+          {aff.url ? (
+            <a className={styles.link} href={aff.url} rel="noopener noreferrer" target="_blank">
+              {aff.name}
+              <GoToLinkIcon className={styles.linkIcon} height={12} width={12} />
+            </a>
+          ) : (
+            <span className={styles.plainName}>{aff.name}</span>
+          )}
+        </li>
+      ))}
+    </ul>
+  );
+}
