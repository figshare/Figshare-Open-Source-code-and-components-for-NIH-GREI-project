diff --git a/src/pages/account/profileEdit/components/affiliations/Affiliations.tsx b/src/pages/account/profileEdit/components/affiliations/Affiliations.tsx
new file mode 100644
index 000000000..9ab871d5f
--- /dev/null
+++ b/src/pages/account/profileEdit/components/affiliations/Affiliations.tsx
@@ -0,0 +1,241 @@
+import React, { useState, useCallback, useEffect } from "react";
+import { Button } from "shared/ui/latest/Button";
+import PlusSvg from "@digital-science/figshare-fcl/icons/react/Plus";
+import { SearchInput } from "shared/ui/latest/SearchInput";
+import { Alert } from "shared/ui/latest/Alert";
+import { DragDropContext, Droppable, Draggable } from "react-beautiful-dnd";
+
+import { SearchDropdown } from "./SearchDropdown/SearchDropdown";
+import { AffiliationOverlay } from "./AffiliationOverlay/AffiliationOverlay";
+import { AffiliationRow } from "./AffiliationRow/AffiliationRow";
+import { AffiliationsList } from "./AffiliationsList/AffiliationsList";
+import { useRorSearch } from "./useRorSearch";
+import styles from "./Affiliations.module.css";
+
+
+export function AffiliationsComponent({ name, updateField, value = [], locked = false }) {
+  const [affiliations, setAffiliations] = useState([]);
+  const [isSearching, setIsSearching] = useState(false);
+  const [showOverlay, setShowOverlay] = useState(false);
+  const [showDuplicateAlert, setShowDuplicateAlert] = useState(false);
+  const [selectedOrg, setSelectedOrg] = useState(null);
+  const [editingIndex, setEditingIndex] = useState<number | null>(null);
+
+  const { searchTerm, setSearchTerm, loading, error, results, hasMore, handleLoadMore } = useRorSearch();
+
+  // Sync local state from form field value when it changes (e.g. initial load from API)
+  useEffect(() => {
+    setAffiliations(value);
+  }, [value]);
+
+  const updateAffiliations = useCallback((newAffiliations) => {
+    setAffiliations(newAffiliations);
+    updateField?.(name, { value: newAffiliations });
+  }, [name, updateField]);
+
+  /** Resets overlay and search state back to idle. */
+  const resetToIdle = useCallback(() => {
+    setShowOverlay(false);
+    setEditingIndex(null);
+    setSelectedOrg(null);
+    setIsSearching(false);
+    setSearchTerm("");
+  }, [setSearchTerm]);
+
+  // -- Search handlers --
+
+  const handleAddClick = useCallback(() => {
+    setShowDuplicateAlert(false);
+    setIsSearching(true);
+    setSearchTerm("");
+  }, [setSearchTerm]);
+
+  const handleCancel = useCallback(() => {
+    setIsSearching(false);
+    setSearchTerm("");
+  }, [setSearchTerm]);
+
+  const handleSearchChange = useCallback((event) => {
+    setSearchTerm(event.target.value);
+    // Dismiss the duplicate alert as soon as the user starts a new search
+    setShowDuplicateAlert(false);
+  }, [setSearchTerm]);
+
+  // -- Overlay handlers --
+
+  const handleSelect = useCallback((org) => {
+    setSelectedOrg(org);
+    setEditingIndex(null);
+    setShowOverlay(true);
+  }, []);
+
+  const handleAddManually = useCallback(() => {
+    setEditingIndex(null);
+    setSelectedOrg(null);
+    setShowOverlay(true);
+  }, []);
+
+  const handleEdit = useCallback((index) => {
+    setEditingIndex(index);
+    setSelectedOrg(null);
+    setShowOverlay(true);
+  }, []);
+
+  const handleOverlayClose = useCallback(() => {
+    setShowOverlay(false);
+    setEditingIndex(null);
+    setSelectedOrg(null);
+  }, []);
+
+  const handleOverlaySave = useCallback((affiliation) => {
+    // Check duplicates by rorId (ROR orgs) or case-insensitive name (manual entries),
+    // excluding the item being edited so it doesn't match itself
+    const isDuplicate = affiliations.some((a, i) =>
+      i !== editingIndex &&
+      ((affiliation.rorId && a.rorId === affiliation.rorId) ||
+       (!affiliation.rorId && !a.rorId && a.name.toLowerCase() === affiliation.name.toLowerCase()))
+    );
+
+    if (isDuplicate) {
+      setShowDuplicateAlert(true);
+      setShowOverlay(false);
+      setEditingIndex(null);
+      setSelectedOrg(null);
+
+      return;
+    }
+
+    if (editingIndex !== null) {
+      const next = [...affiliations];
+      next[editingIndex] = affiliation;
+      updateAffiliations(next);
+    } else {
+      updateAffiliations([...affiliations, affiliation]);
+    }
+
+    resetToIdle();
+  }, [editingIndex, affiliations, updateAffiliations, resetToIdle]);
+
+  // -- Reorder / delete handlers --
+
+  const handleReorder = useCallback((index, direction) => {
+    const next = [...affiliations];
+    const targetIndex = direction === "up" ? index - 1 : index + 1;
+    if (targetIndex < 0 || targetIndex >= next.length) {
+      return;
+    }
+    [next[index], next[targetIndex]] = [next[targetIndex], next[index]];
+    updateAffiliations(next);
+  }, [affiliations, updateAffiliations]);
+
+  const handleDelete = useCallback((index) => {
+    updateAffiliations(affiliations.filter((_, i) => i !== index));
+  }, [affiliations, updateAffiliations]);
+
+  const handleDragEnd = useCallback((result) => {
+    if (!result.destination || result.source.index === result.destination.index) {
+      return;
+    }
+    const next = [...affiliations];
+    const [moved] = next.splice(result.source.index, 1);
+    next.splice(result.destination.index, 0, moved);
+    updateAffiliations(next);
+  }, [affiliations, updateAffiliations]);
+
+  // -- Render --
+
+  const reorderable = affiliations.length > 1;
+
+  if (locked) {
+    return <AffiliationsList affiliations={affiliations} />;
+  }
+
+  const getOverlayAffiliation = () => {
+    if (editingIndex !== null) {
+      return affiliations[editingIndex];
+    }
+
+    if (selectedOrg) {
+      return { rorId: selectedOrg.rorId, name: selectedOrg.name, url: "" };
+    }
+
+    return undefined;
+  };
+  const overlayAffiliation = getOverlayAffiliation();
+
+  return (
+    <div className={styles.container}>
+      {showDuplicateAlert && (
+        <Alert
+          className={styles.duplicateAlert}
+          message="This affiliation is already in your list."
+          persistent={false}
+          type="info"
+          onClose={() => setShowDuplicateAlert(false)}
+        />
+      )}
+      <DragDropContext onDragEnd={handleDragEnd}>
+        <Droppable droppableId="affiliations-droppable" isDropDisabled={!reorderable}>
+          {(provided) => (
+            <div ref={provided.innerRef} className={styles.list} {...provided.droppableProps}>
+              {affiliations.map((aff, index) => (
+                <Draggable key={aff.rorId || aff.name} draggableId={aff.rorId || aff.name} index={index} isDragDisabled={!reorderable}>
+                  {(item) => (
+                    <div ref={item.innerRef} {...item.draggableProps}>
+                      <AffiliationRow
+                        affiliation={aff}
+                        dragHandleProps={item.dragHandleProps}
+                        isFirst={index === 0}
+                        isLast={index === affiliations.length - 1}
+                        reorderable={reorderable}
+                        onDelete={() => handleDelete(index)}
+                        onEdit={() => handleEdit(index)}
+                        onMoveUp={() => handleReorder(index, "up")}
+                        onMoveDown={() => handleReorder(index, "down")}
+                      />
+                    </div>
+                  )}
+                </Draggable>
+              ))}
+              {provided.placeholder}
+            </div>
+          )}
+        </Droppable>
+      </DragDropContext>
+      {isSearching ? (
+        <div className={styles.searchColumn}>
+          <SearchInput
+            placeholder="Search the ROR registry or type a name"
+            value={searchTerm}
+            onChange={handleSearchChange}
+          />
+          <Button kind="tertiary" onClick={handleCancel}>
+            <Button.Label>Cancel</Button.Label>
+          </Button>
+          <SearchDropdown
+            error={error}
+            hasMore={hasMore}
+            loading={loading}
+            results={results}
+            searchTerm={searchTerm}
+            onAddManually={handleAddManually}
+            onLoadMore={handleLoadMore}
+            onSelect={handleSelect}
+          />
+        </div>
+      ) : (
+        <Button kind="tertiary" onClick={handleAddClick}>
+          <Button.Icon><PlusSvg /></Button.Icon>
+          <Button.Label>Add another affiliation</Button.Label>
+        </Button>
+      )}
+      <AffiliationOverlay
+        affiliation={overlayAffiliation}
+        isEditing={editingIndex !== null}
+        isVisible={showOverlay}
+        onClose={handleOverlayClose}
+        onSave={handleOverlaySave}
+      />
+    </div>
+  );
+}
