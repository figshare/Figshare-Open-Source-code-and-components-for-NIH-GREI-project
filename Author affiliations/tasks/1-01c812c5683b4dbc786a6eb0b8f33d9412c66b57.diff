+import json
+import zipfile
+import io
+import pytest
+
+from unittest.mock import MagicMock, patch
+
+from figtasks.tasks.ror_import.ror_import import (
+    _strip_ror_prefix,
+    _get_display_name,
+    _get_parent_ror_id,
+    _build_children_map,
+    _transform_org,
+    _fetch_latest_ror_zip_url,
+    _download_and_parse_ror,
+    _bulk_index_to_es,
+    _send_bulk_batch,
+    run_ror_import,
+    ROR_URL_PREFIX,
+    BULK_BATCH_SIZE,
+    STATUS_MAP,
+)
+
+
+# ---------------------------------------------------------------------------
+# Sample data
+# ---------------------------------------------------------------------------
+
+SAMPLE_ORG = {
+    "id": "https://ror.org/041kmwe10",
+    "names": [
+        {"value": "Imperial College London", "types": ["ror_display"]},
+        {"value": "ICL", "types": ["acronym"]},
+    ],
+    "status": "active",
+    "locations": [
+        {
+            "geonames_details": {
+                "country_code": "GB",
+                "country_name": "United Kingdom",
+                "name": "London",
+            }
+        }
+    ],
+    "relationships": [],
+}
+
+# A child org that references a parent
+SAMPLE_CHILD_ORG = {
+    "id": "https://ror.org/02x9ncv92",
+    "names": [{"value": "Imperial College Business School", "types": ["ror_display"]}],
+    "status": "active",
+    "locations": [
+        {
+            "geonames_details": {
+                "country_code": "GB",
+                "country_name": "United Kingdom",
+                "name": "London",
+            }
+        }
+    ],
+    "relationships": [{"type": "parent", "id": "https://ror.org/041kmwe10"}],
+}
+
+# An org with no ror_display name — fallback to first name
+SAMPLE_ORG_NO_DISPLAY = {
+    "id": "https://ror.org/099fake99",
+    "names": [{"value": "Fallback Name", "types": ["label"]}],
+    "status": "inactive",
+    "locations": [],
+    "relationships": [],
+}
+
+
+# ---------------------------------------------------------------------------
+# _strip_ror_prefix
+# ---------------------------------------------------------------------------
+
+
+def test_strip_ror_prefix_removes_url():
+    assert _strip_ror_prefix("https://ror.org/041kmwe10") == "041kmwe10"
+
+
+def test_strip_ror_prefix_keeps_short_id():
+    """Already short IDs pass through unchanged."""
+    assert _strip_ror_prefix("041kmwe10") == "041kmwe10"
+
+
+def test_strip_ror_prefix_handles_none():
+    assert _strip_ror_prefix(None) is None
+
+
+def test_strip_ror_prefix_handles_empty():
+    assert _strip_ror_prefix("") == ""
+
+
+# ---------------------------------------------------------------------------
+# _get_display_name
+# ---------------------------------------------------------------------------
+
+
+def test_get_display_name_prefers_ror_display():
+    names = [
+        {"value": "Acronym", "types": ["acronym"]},
+        {"value": "Display Name", "types": ["ror_display"]},
+    ]
+    assert _get_display_name(names) == "Display Name"
+
+
+def test_get_display_name_falls_back_to_first():
+    """When no ror_display type exists, return the first name."""
+    names = [{"value": "Only Name", "types": ["label"]}]
+    assert _get_display_name(names) == "Only Name"
+
+
+def test_get_display_name_empty_list():
+    assert _get_display_name([]) == ""
+
+
+# ---------------------------------------------------------------------------
+# _get_parent_ror_id
+# ---------------------------------------------------------------------------
+
+
+def test_get_parent_ror_id_returns_parent():
+    rels = [
+        {"type": "related", "id": "https://ror.org/aaa111111"},
+        {"type": "parent", "id": "https://ror.org/041kmwe10"},
+    ]
+    # Should return the full URL
+    assert _get_parent_ror_id(rels) == "https://ror.org/041kmwe10"
+
+
+def test_get_parent_ror_id_returns_none_when_no_parent():
+    rels = [{"type": "related", "id": "https://ror.org/aaa111111"}]
+    assert _get_parent_ror_id(rels) is None
+
+
+def test_get_parent_ror_id_empty():
+    assert _get_parent_ror_id([]) is None
+
+
+# ---------------------------------------------------------------------------
+# _build_children_map
+# ---------------------------------------------------------------------------
+
+
+def test_build_children_map_groups_children():
+    orgs = [SAMPLE_ORG, SAMPLE_CHILD_ORG]
+    children_map = _build_children_map(orgs)
+
+    # The parent should have one child — keyed by full URL
+    assert "https://ror.org/041kmwe10" in children_map
+    assert len(children_map["https://ror.org/041kmwe10"]) == 1
+    assert children_map["https://ror.org/041kmwe10"][0]["ror_id"] == "https://ror.org/02x9ncv92"
+    assert children_map["https://ror.org/041kmwe10"][0]["name"] == "Imperial College Business School"
+
+
+def test_build_children_map_no_parents():
+    """Orgs with no parent relationships produce an empty map."""
+    children_map = _build_children_map([SAMPLE_ORG])
+    assert len(children_map) == 0
+
+
+# ---------------------------------------------------------------------------
+# _transform_org
+# ---------------------------------------------------------------------------
+
+
+def test_transform_org_full():
+    children_map = {"https://ror.org/041kmwe10": [{"ror_id": "https://ror.org/02x9ncv92", "name": "Business School"}]}
+    doc = _transform_org(SAMPLE_ORG, children_map)
+
+    assert doc["ror_id"] == "https://ror.org/041kmwe10"
+    assert doc["name"] == "Imperial College London"
+    assert doc["status"] == 1  # STATUS_MAP["active"]
+    assert doc["country_code"] == "GB"
+    assert doc["country_name"] == "United Kingdom"
+    assert doc["city"] == "London"
+    assert doc["parent_ror_id"] is None
+    assert len(doc["children"]) == 1
+    assert doc["children"][0]["ror_id"] == "https://ror.org/02x9ncv92"
+
+
+def test_transform_org_child_with_parent():
+    doc = _transform_org(SAMPLE_CHILD_ORG, {})
+
+    assert doc["ror_id"] == "https://ror.org/02x9ncv92"
+    assert doc["parent_ror_id"] == "https://ror.org/041kmwe10"
+    assert doc["children"] == []
+
+
+def test_transform_org_no_location():
+    """Org with empty locations should have empty location fields."""
+    doc = _transform_org(SAMPLE_ORG_NO_DISPLAY, {})
+
+    assert doc["country_code"] == ""
+    assert doc["country_name"] == ""
+    assert doc["city"] == ""
+    assert doc["status"] == 2  # STATUS_MAP["inactive"]
+    assert doc["name"] == "Fallback Name"
+
+
+def test_transform_org_unknown_status_defaults_to_active():
+    """Unknown status strings should map to 1 (active) as default."""
+    org = {**SAMPLE_ORG, "status": "unknown_status"}
+    doc = _transform_org(org, {})
+    assert doc["status"] == 1
+
+
+# ---------------------------------------------------------------------------
+# _fetch_latest_ror_zip_url
+# ---------------------------------------------------------------------------
+
+
+def test_fetch_latest_ror_zip_url_success(mocker):
+    """Should extract the zip download URL from the Zenodo API response."""
+    zenodo_response = {
+        "hits": {
+            "hits": [
+                {
+                    "id": 12345,
+                    "metadata": {"title": "ROR v1.58"},
+                    "files": [
+                        {
+                            "key": "v1.58-2025-12-11-ror-data.zip",
+                            "links": {"self": "https://zenodo.org/download.zip"},
+                        },
+                    ],
+                }
+            ]
+        }
+    }
+    mock_response = MagicMock()
+    mock_response.read.return_value = json.dumps(zenodo_response).encode()
+    mock_response.__enter__ = MagicMock(return_value=mock_response)
+    mock_response.__exit__ = MagicMock(return_value=False)
+    mocker.patch("figtasks.tasks.ror_import.ror_import.make_http_request", return_value=mock_response)
+
+    url, title = _fetch_latest_ror_zip_url()
+
+    assert url == "https://zenodo.org/download.zip"
+    assert title == "ROR v1.58"
+
+
+def test_fetch_latest_ror_zip_url_no_hits(mocker):
+    """Should raise RuntimeError when Zenodo returns no hits."""
+    zenodo_response = {"hits": {"hits": []}}
+    mock_response = MagicMock()
+    mock_response.read.return_value = json.dumps(zenodo_response).encode()
+    mock_response.__enter__ = MagicMock(return_value=mock_response)
+    mock_response.__exit__ = MagicMock(return_value=False)
+    mocker.patch("figtasks.tasks.ror_import.ror_import.make_http_request", return_value=mock_response)
+
+    with pytest.raises(RuntimeError, match="No ROR releases found"):
+        _fetch_latest_ror_zip_url()
+
+
+def test_fetch_latest_ror_zip_url_no_zip_file(mocker):
+    """Should raise RuntimeError when the record has no .zip file."""
+    zenodo_response = {
+        "hits": {
+            "hits": [
+                {
+                    "id": 12345,
+                    "metadata": {"title": "ROR v1.58"},
+                    "files": [{"key": "readme.txt", "links": {"self": "https://zenodo.org/readme.txt"}}],
+                }
+            ]
+        }
+    }
+    mock_response = MagicMock()
+    mock_response.read.return_value = json.dumps(zenodo_response).encode()
+    mock_response.__enter__ = MagicMock(return_value=mock_response)
+    mock_response.__exit__ = MagicMock(return_value=False)
+    mocker.patch("figtasks.tasks.ror_import.ror_import.make_http_request", return_value=mock_response)
+
+    with pytest.raises(RuntimeError, match="No zip file found"):
+        _fetch_latest_ror_zip_url()
+
+
+# ---------------------------------------------------------------------------
+# _download_and_parse_ror
+# ---------------------------------------------------------------------------
+
+
+def _make_ror_zip(orgs):
+    """Helper: create an in-memory zip containing a JSON file with the given orgs list."""
+    buf = io.BytesIO()
+    with zipfile.ZipFile(buf, "w") as zf:
+        zf.writestr("v1.58-2025-12-11-ror-data.json", json.dumps(orgs))
+    buf.seek(0)
+    return buf
+
+
+def test_download_and_parse_ror_success(mocker):
+    """Should download a zip, extract the JSON, and return the org list."""
+    orgs = [SAMPLE_ORG, SAMPLE_CHILD_ORG]
+    zip_bytes = _make_ror_zip(orgs)
+
+    # Mock make_http_request to return our in-memory zip bytes in chunks
+    mock_response = MagicMock()
+    zip_data = zip_bytes.read()
+    # Simulate chunked reads: first call returns all data, second returns empty
+    mock_response.read.side_effect = [zip_data, b""]
+    mock_response.__enter__ = MagicMock(return_value=mock_response)
+    mock_response.__exit__ = MagicMock(return_value=False)
+    mocker.patch("figtasks.tasks.ror_import.ror_import.make_http_request", return_value=mock_response)
+
+    result = _download_and_parse_ror("https://zenodo.org/download.zip")
+
+    assert len(result) == 2
+    assert result[0]["id"] == "https://ror.org/041kmwe10"
+
+
+def test_download_and_parse_ror_no_json_in_zip(mocker):
+    """Should raise RuntimeError when the zip has no JSON file."""
+    buf = io.BytesIO()
+    with zipfile.ZipFile(buf, "w") as zf:
+        zf.writestr("readme.txt", "no json here")
+    buf.seek(0)
+    zip_data = buf.read()
+
+    mock_response = MagicMock()
+    mock_response.read.side_effect = [zip_data, b""]
+    mock_response.__enter__ = MagicMock(return_value=mock_response)
+    mock_response.__exit__ = MagicMock(return_value=False)
+    mocker.patch("figtasks.tasks.ror_import.ror_import.make_http_request", return_value=mock_response)
+
+    with pytest.raises(RuntimeError, match="No JSON file found"):
+        _download_and_parse_ror("https://zenodo.org/download.zip")
+
+
+# ---------------------------------------------------------------------------
+# _send_bulk_batch
+# ---------------------------------------------------------------------------
+
+
+def test_send_bulk_batch_success(mocker):
+    """Should POST NDJSON to ES and not raise on success."""
+    mock_response = MagicMock()
+    mock_response.read.return_value = json.dumps({"errors": False, "items": []})
+    mock_response.__enter__ = MagicMock(return_value=mock_response)
+    mock_response.__exit__ = MagicMock(return_value=False)
+    mock_http = mocker.patch("figtasks.tasks.ror_import.ror_import.make_http_request", return_value=mock_response)
+
+    batch = ['{"index": {"_index": "ror", "_id": "abc"}}', '{"ror_id": "abc", "name": "Test"}']
+    _send_bulk_batch("https://es:9200/ror/_bulk", {"Content-Type": "application/x-ndjson"}, batch)
+
+    # Verify the NDJSON format (lines joined with \n, trailing \n)
