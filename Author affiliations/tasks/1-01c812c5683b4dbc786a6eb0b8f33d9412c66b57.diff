+import json
+import tempfile
+import zipfile
+from collections import defaultdict
+
+from figcore.lib.data.institution_static import InstitutionStatic
+from figcore.lib.logs import FigcoreLogger
+
+from figtasks.config import tasks_config
+from figtasks.lib.shared import make_http_request
+
+from .task_definitions import RORImportTask
+
+# Zenodo community API endpoint for ROR data releases
+ZENODO_ROR_API = "https://zenodo.org/api/communities/ror-data/records?sort=mostrecent&size=1"
+
+# ES bulk request size — number of orgs per bulk request
+BULK_BATCH_SIZE = 5000
+
+# Map ROR status strings to the byte values used in the ES schema
+STATUS_MAP = InstitutionStatic.ROR_STATUS_MAP
+
+# ROR IDs come as full URLs (e.g. "https://ror.org/046fa4y88") — strip the prefix
+ROR_URL_PREFIX = "https://ror.org/"
+
+
+def _strip_ror_prefix(ror_url):
+    """Strip the https://ror.org/ prefix, keeping just the ID (e.g. '046fa4y88')."""
+    if ror_url and ror_url.startswith(ROR_URL_PREFIX):
+        return ror_url[len(ROR_URL_PREFIX) :]
+    return ror_url
+
+
+def _get_display_name(names):
+    """Extract the primary display name from a ROR names list.
+
+    ROR v2 names have types like 'ror_display', 'label', 'acronym', 'alias'.
+    We prefer the 'ror_display' name, then fall back to the first name.
+    """
+    for name_entry in names:
+        if "ror_display" in name_entry.get("types", []):
+            return name_entry["value"]
+    return names[0]["value"] if names else ""
+
+
+def _get_parent_ror_id(relationships):
+    """Extract the parent organization ROR ID (full URL) from relationships, if any."""
+    for rel in relationships:
+        if rel.get("type") == "parent":
+            return rel["id"]
+    return None
+
+
+def _build_children_map(orgs):
+    """Build a map of parent_ror_id (full URL) -> list of child {ror_id, name} dicts.
+
+    Used to denormalize children onto parent documents so the search UI
+    can display departments/sub-orgs alongside a parent match.
+    """
+    children = defaultdict(list)
+    for org in orgs:
+        parent_id = _get_parent_ror_id(org.get("relationships", []))
+        if parent_id:
+            children[parent_id].append(
+                {
+                    "ror_id": org["id"],
+                    "name": _get_display_name(org.get("names", [])),
+                }
+            )
+    return children
+
+
+def _transform_org(org, children_map):
+    """Transform a single ROR org dict into the ES document format.
+
+    All ror_id fields store the full URL (e.g. "https://ror.org/02bfwt286").
+    The ES _id uses only the stripped identifier for cleaner document IDs.
+    """
+    location = {}
+    locations = org.get("locations", [])
+    if locations:
+        geo = locations[0].get("geonames_details", {})
+        location = {
+            "country_code": geo.get("country_code", ""),
+            "country_name": geo.get("country_name", ""),
+            "city": geo.get("name", ""),
+        }
+
+    ror_id = org["id"]  # full URL
+    return {
+        "ror_id": ror_id,
+        "name": _get_display_name(org.get("names", [])),
+        "status": STATUS_MAP.get(org.get("status", "active"), 1),
+        "country_code": location.get("country_code", ""),
+        "country_name": location.get("country_name", ""),
+        "city": location.get("city", ""),
+        "parent_ror_id": _get_parent_ror_id(org.get("relationships", [])),
+        "children": children_map.get(ror_id, []),
+    }
+
+
+def _fetch_latest_ror_zip_url():
+    """Query the Zenodo API to find the download URL for the latest ROR release."""
+    FigcoreLogger.info("Fetching latest ROR release metadata from Zenodo")
+    with make_http_request(ZENODO_ROR_API, "GET", timeout=30) as response:
+        data = json.loads(response.read())
+
+    hits = data.get("hits", {}).get("hits", [])
+    if not hits:
+        raise RuntimeError("No ROR releases found on Zenodo")
+
+    record = hits[0]
+    release_title = record.get("metadata", {}).get("title", "unknown")
+    FigcoreLogger.info("Latest ROR release: %s (record %s)", release_title, record.get("id"))
+
+    # Find the zip file in the record's files
+    for file_entry in record.get("files", []):
+        if file_entry["key"].endswith(".zip"):
+            return file_entry["links"]["self"], release_title
+
+    raise RuntimeError(f"No zip file found in ROR release {record.get('id')}")
+
+
+def _download_and_parse_ror(zip_url):
+    """Download the ROR zip and parse the JSON file inside it.
+
+    Returns the list of org dicts from the ROR JSON.
+    """
+    FigcoreLogger.info("Downloading ROR data from %s", zip_url)
+
+    with tempfile.NamedTemporaryFile(suffix=".zip") as tmp:
+        # Stream download to temp file to avoid holding ~36MB in memory
+        with make_http_request(zip_url, "GET", timeout=120) as response:
+            while True:
+                chunk = response.read(8192)
+                if not chunk:
+                    break
+                tmp.write(chunk)
+        tmp.flush()
+
+        # Parse the JSON file inside the zip
+        with zipfile.ZipFile(tmp.name) as zf:
+            json_files = [n for n in zf.namelist() if n.endswith(".json")]
+            if not json_files:
+                raise RuntimeError("No JSON file found in ROR zip archive")
+
+            FigcoreLogger.info("Parsing %s", json_files[0])
+            with zf.open(json_files[0]) as f:
+                orgs = json.load(f)
+
+    FigcoreLogger.info("Parsed %d organizations from ROR data", len(orgs))
+    return orgs
+
+
+def _bulk_index_to_es(orgs, children_map):
+    """Bulk-index all ROR organizations into Elasticsearch.
+
+    Uses the _bulk API with index actions, batched to avoid oversized requests.
+    Indexes into the 'ror' alias so it hits the active underlying index.
+    """
+    es_url = tasks_config.get("search", {}).get("new_search")
+    if not es_url:
+        raise RuntimeError("search.new_search not configured in tasks_config")
+
+    bulk_endpoint = f"{es_url}/ror/_bulk"
+    headers = {"Content-Type": "application/x-ndjson"}
+
+    total_indexed = 0
+    batch = []
+
+    for org in orgs:
+        doc = _transform_org(org, children_map)
+
+        # NDJSON: action line + document line
+        # Use stripped ID for _id (e.g. "02bfwt286"), full URL stays in the document
+        action = json.dumps({"index": {"_index": "ror", "_id": _strip_ror_prefix(doc["ror_id"])}})
+        body = json.dumps(doc)
+        batch.append(action)
+        batch.append(body)
+
+        if len(batch) >= BULK_BATCH_SIZE * 2:
+            _send_bulk_batch(bulk_endpoint, headers, batch)
+            total_indexed += len(batch) // 2
+            FigcoreLogger.info("Indexed %d / %d organizations", total_indexed, len(orgs))
+            batch = []
+
+    # Final batch
+    if batch:
+        _send_bulk_batch(bulk_endpoint, headers, batch)
+        total_indexed += len(batch) // 2
+
+    FigcoreLogger.info("Finished indexing %d organizations to ES", total_indexed)
+
+
+def _send_bulk_batch(url, headers, batch):
+    """Send a single bulk batch to ES and raise on errors."""
+    ndjson = "\n".join(batch) + "\n"
+    with make_http_request(url, "POST", headers=headers, data=ndjson, timeout=60) as response:
+        result = json.loads(response.read())
+
+    if result.get("errors"):
+        error_items = [item for item in result.get("items", []) if "error" in item.get("index", {})]
+        for item in error_items[:5]:
+            FigcoreLogger.error("ES bulk error: %s", json.dumps(item["index"]["error"]))
+        raise RuntimeError(f"ES bulk indexing failed: {len(error_items)} errors in batch")
+
+
+def run_ror_import():
+    """Main entry point: download latest ROR release and index to ES.
+
+    Can be called from the Celery task or directly from a script.
+    """
+    zip_url, release_title = _fetch_latest_ror_zip_url()
+    orgs = _download_and_parse_ror(zip_url)
+
+    # Build parent->children map before indexing
+    children_map = _build_children_map(orgs)
+    FigcoreLogger.info("Built children map: %d parent orgs have children", len(children_map))
+
+    _bulk_index_to_es(orgs, children_map)
+    FigcoreLogger.info("ROR import complete: %s (%d orgs)", release_title, len(orgs))
+
+
+@RORImportTask.register_task
+class RORImportTaskImplementation(RORImportTask):
+    """Celery task that imports the latest ROR data release into Elasticsearch.
+
+    Scheduled to run monthly via Celery Beat. Downloads the latest ROR
+    data dump from Zenodo, parses the JSON, and bulk-indexes all ~137k
+    organizations into the 'ror' ES index.
+    """
+
+    def run(self):
+        FigcoreLogger.info("Running task %s", self.__class__.__name__)
+        run_ror_import()
+        FigcoreLogger.info("Task %s finished", self.__class__.__name__)
