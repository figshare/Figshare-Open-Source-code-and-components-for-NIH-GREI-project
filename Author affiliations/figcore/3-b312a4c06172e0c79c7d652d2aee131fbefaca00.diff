+    def test_account_update_profile_ror_ids_empty_list(self):
+        """Test that ror_ids can be cleared by sending an empty list"""
+        gql_parser = get_graphql_parser(options={"camel_case": True})
+
+        # First set some affiliations
+        data = {"rorIds": [{"rorId": "041kmwe10", "name": "University of Oxford", "url": "", "order": 0}]}
+        gql_parser.mutate("updateUserProfile", params={"userData": data}, fields=["ok"], account_id=self.account1.id)
+
+        account = Account.find(self.account1.id)
+        self.assertEqual(len(account.user.ror_ids), 1)
+
+        # Now clear them
+        data = {"rorIds": []}
+        gql_parser.mutate("updateUserProfile", params={"userData": data}, fields=["ok"], account_id=self.account1.id)
+
+        account = Account.find(self.account1.id)
+        self.assertEqual(account.user.ror_ids, [])
+
+    def test_account_update_profile_ror_ids_manual_entry(self):
+        """Test that manual affiliations (no rorId) are stored correctly"""
+        gql_parser = get_graphql_parser(options={"camel_case": True})
+
+        data = {"rorIds": [{"rorId": "", "name": "My Custom Lab", "url": "https://mylab.org", "order": 0}]}
+        gql_parser.mutate("updateUserProfile", params={"userData": data}, fields=["ok"], account_id=self.account1.id)
+
+        account = Account.find(self.account1.id)
+        self.assertEqual(
+            account.user.ror_ids,
+            [{"ror_id": "", "name": "My Custom Lab", "url": "https://mylab.org", "order": 0}],
+        )
+
+    def test_account_query_ror_ids(self):
+        """Test that ror_ids are returned via GraphQL query with camelCase keys"""
+        gql_parser = get_graphql_parser(options={"camel_case": True})
+
+        # Set affiliations first
+        data = {
+            "rorIds": [
+                {"rorId": "041kmwe10", "name": "University of Oxford", "url": "https://ox.ac.uk", "order": 0},
+            ]
+        }
+        gql_parser.mutate("updateUserProfile", params={"userData": data}, fields=["ok"], account_id=self.account1.id)
+
+        # Query the account and verify rorIds are returned with correct structure
+        result = gql_parser.query(
+            "account",
+            params={"id": self.account1.id},
+            fields=["user { rorIds { rorId name url order } }"],
+            account_id=self.account1.id,
+            get_url_details=self.mock_get_url_details,
+        )
+
+        ror_ids = result["user"]["rorIds"]
+        self.assertEqual(len(ror_ids), 1)
+        self.assertEqual(ror_ids[0]["rorId"], "041kmwe10")
+        self.assertEqual(ror_ids[0]["name"], "University of Oxford")
+        self.assertEqual(ror_ids[0]["url"], "https://ox.ac.uk")
+        self.assertEqual(ror_ids[0]["order"], 0)
 
