+            with self.subTest(name=name), mock.patch.object(User, "find_all", return_value=[_user(7, 2, name)]):
+                output = citations.create(_itbm_article(entries=[{"user_id": 7}]), "bibtex").output
+            # no spaces or delimiters in the key; the author keeps the full name
+            self.assertIn("@article{{{}2015,".format(key), output)
