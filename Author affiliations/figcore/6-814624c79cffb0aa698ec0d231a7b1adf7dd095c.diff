+class TestPersonListsDiffer(PersonListUsersTestCase):
+    def test_what_makes_a_new_version(self):
+        user, other = self.make_user(), self.make_user(first_name="Bob", last_name="Ray", email="bob@uni.edu")
+        organization = self.make_organization()
+        base = [{"user_id": user.id}, {"user_id": other.id}, {"user_id": organization.id}]
+
+        unchanged = (
+            list(reversed(base)),  # reordering
+            [dict(base[0], affiliations=[{"name": "Lab"}], is_corresponding=True), base[1], base[2]],
+            [base[0], base[1], dict(base[2], contributors="Jane")],
+            [dict(base[0], email="ANN.LEE@uni.edu"), base[1], base[2]],  # same merged value
+        )
+        for entries in unchanged:
+            self.assertFalse(person_lists_differ(entries, base), entries)
+
+        changed = (
+            base[:2],  # removed
+            base + [{"user_id": self.account_user.id}],  # added
+            [dict(base[0], last_name="Lee-Brown"), base[1], base[2]],
+            [dict(base[0], orcid_id=None), base[1], base[2]],
+            [base[0], base[1], dict(base[2], email="press@sanger.ac.uk")],
+        )
+        for entries in changed:
+            self.assertTrue(person_lists_differ(entries, base), entries)
+
+    def test_does_not_look_up_accounts(self):
+        # has_account isn't part of what makes a new version, so its query is skipped
+        user = self.make_user()
+        with patch.object(User, "ids_with_account") as ids_with_account:
+            self.assertTrue(person_lists_differ([{"user_id": user.id, "last_name": "X"}], [{"user_id": user.id}]))
+        ids_with_account.assert_not_called()
+
+
+class TestProcessPersonListFields(TestCase):
+    def setUp(self):
+        patcher = patch.object(User, "create_without_account", side_effect=lambda *args: Mock(id=5000))
+        patcher.start()
+        self.addCleanup(patcher.stop)
+
+    def field(self, name, value, field_id=1, field_type="person_list", internal_type=None):
+        # `authors` is the core field unless said otherwise
+        internal_type = internal_type or ("core" if name == "authors" else "custom")
+        field = Mock(id=field_id, field_type=field_type, value=value, internal_type=internal_type)
+        field.name = name
+        return field
+
+    def test_processes_sent_person_lists_only(self):
+        authors = self.field("authors", [PERSON], 1)
+        supervisors = self.field("supervisors", None, 2)
+        title = self.field("title", "  t ", 3, "text")
+        process_person_list_fields({"authors": authors, "supervisors": supervisors, "title": title})
+
+        authors.set_value.assert_called_once_with([{"user_id": 5000}])
+        supervisors.set_value.assert_not_called()
+        title.set_value.assert_not_called()
+
+    def test_empty_list_clears(self):
+        authors = self.field("authors", [])
+        process_person_list_fields({"authors": authors})
+        authors.set_value.assert_called_once_with([])
+
+    def test_uses_group_mandatory_fields_when_publishing(self):
+        group = Mock()
+        group.get_mandatory_author_fields.return_value = ["first_name"]
+        authors = self.field("authors", [{"type": 1, "last_name": "S"}], 5)
+        with self.assertRaises(fig_exc.MissingMandatoryField):
+            process_person_list_fields({"authors": authors}, group=group, enforce_mandatory_authors=True)
+
+        # not enforced on draft
+        process_person_list_fields({"authors": authors}, group=group)
+
+    @patch("figcore.api.underlying_field.person_list.resolve_person_list")
+    def test_checks_stored_authors_when_not_sent(self, resolve):
+        resolve.return_value = [{"type": 1, "first_name": None, "last_name": "S"}]
+        group = Mock()
+        group.get_mandatory_author_fields.return_value = ["first_name"]
+        authors = self.field("authors", None, 5)
+        stored_fields = {"5": {"value": [{"user_id": 3}]}}
+
+        process_person_list_fields({"authors": authors}, stored_fields=stored_fields, group=group)
+        resolve.assert_not_called()
+        with self.assertRaises(fig_exc.MissingMandatoryField):
+            process_person_list_fields(
+                {"authors": authors}, stored_fields=stored_fields, group=group, enforce_mandatory_authors=True
+            )
+        resolve.assert_called_once_with([{"user_id": 3}], mask_emails=False, with_has_account=False)
+        authors.set_value.assert_not_called()
+
+    def test_passes_stored_entries(self):
+        authors = self.field("authors", [{"user_id": 3}], 5)
+        stored_fields = {"5": {"value": [{"user_id": 3, "last_name": "S"}]}}
+        with patch("figcore.api.underlying_field.person_list.PersonListProcessor") as processor:
+            process_person_list_fields({"authors": authors}, stored_fields=stored_fields, account_id=9, owner_id=3)
+        processor.assert_called_once_with(
+            "authors",
+            stored_entries=stored_fields["5"]["value"],
+            mandatory_author_fields=None,
+            enforce_mandatory_authors=False,
+            account_id=9,
+            is_authors=True,
+            owner_id=3,
+        )
+
+    def test_owner_id_only_for_the_authors_field(self):
+        editors = self.field("editors", [{"user_id": 3}], 6)
+        with patch("figcore.api.underlying_field.person_list.PersonListProcessor") as processor:
+            process_person_list_fields({"editors": editors}, owner_id=3)
+        self.assertEqual(processor.call_args.kwargs["owner_id"], None)
+        self.assertFalse(processor.call_args.kwargs["is_authors"])
+
+    def test_custom_field_named_authors_gets_no_authors_rules(self):
+        # e.g. a custom project person_list named `authors`: projects have no core authors field
+        authors = self.field("authors", [dict(ORG, is_corresponding=True)], internal_type="custom")
+        with self.assertRaises(fig_exc.InvalidFormat) as ctx:
+            process_person_list_fields({"authors": authors})
+        self.assertEqual(ctx.exception.field, "authors[0].is_corresponding")
+
+        authors = self.field("authors", [dict(PERSON, is_corresponding=True)], internal_type="custom")
+        with self.assertRaises(fig_exc.InvalidFormat):
+            process_person_list_fields({"authors": authors})
