+def keys_to_camel(content):
+    """Convert the keys of `content` (a dict or list of dicts, nested at any depth) to ``camelCase``.
+
+    Values that aren't dicts or lists of dicts are returned unchanged.
+    """
+    return _convert_keys(content, camelcase)
+
+
+def keys_to_snake(content):
+    """Convert the keys of `content` (a dict or list of dicts, nested at any depth) to ``snake_case``.
+
+    Values that aren't dicts or lists of dicts are returned unchanged.
+    """
+    return _convert_keys(content, snakecase)
+
+
+def _is_list_of_dicts(content):
+    # only lists made entirely of objects (person_list entries, affiliations) are converted; any other list,
+    # mixed ones included, is a plain value and is left as is
+    return isinstance(content, list) and all(isinstance(element, dict) for element in content)
+
+
+def _convert_keys(content, convert):
+    if isinstance(content, dict):
+        return {convert(key): _convert_keys(value, convert) for key, value in content.items()}
+    if _is_list_of_dicts(content):
+        return [_convert_keys(element, convert) for element in content]
+    return content
+
+
 def pascalcase(string):
     """Convert a string to ``PascalCase`` (capitalised camelCase)."""
