diff --git a/src/figcore/api/underlying_field/person_list.py b/src/figcore/api/underlying_field/person_list.py
new file mode 100644
index 000000000..9c494a182
--- /dev/null
+++ b/src/figcore/api/underlying_field/person_list.py
@@ -0,0 +1,712 @@
+"""Shared handling of ITBM `person_list` field values, for items, collections and projects.
+
+Every entry references a user: an account user, a ghost user (no account) or an organization user
+(`user.type`). The stored entry (`.fields[<id>].value`, in array order) holds the `user_id` and only what
+differs on this item:
+
+- people: overrides of ``first_name``, ``last_name``, ``email``, ``orcid_id`` (``None`` = cleared on this item),
+  ``is_corresponding`` (authors only) and ``affiliations`` (``[{ror_id?, name}]``);
+- organizations: an ``email`` override, ``contributors`` and ``is_corresponding`` (authors only).
+
+Anything not overridden is read from the user and profile at read time (`resolve_person_list`).
+"""
+
+import re
+
+from figcore import exc
+from figcore.internals import AccountLimitsInternals
+from figcore.lib.api_entity import APIEntity
+from figcore.lib.data.underlying_field_static import UnderlyingFieldStatic
+from figcore.lib.data.user_static import UserStatic
+from figcore.lib.text import is_masked_email, mask_email
+from figcore.lib.validator import Validator
+
+ROR_ID_REGEX = re.compile(r"^0[a-hj-km-np-tv-z0-9]{6}[0-9]{2}$")
+ROR_URL_PREFIX = "https://ror.org/"
+AFFILIATION_KEYS = ("ror_id", "name")
+PERSON = UnderlyingFieldStatic.PERSON_TYPE_PERSONAL
+ORGANIZATION = UnderlyingFieldStatic.PERSON_TYPE_ORGANIZATIONAL
+
+
+def is_person_list(field_api):
+    return field_api.field_type == UnderlyingFieldStatic.FIELD_TYPES[UnderlyingFieldStatic.TYPE_PERSON_LIST]
+
+
+def is_authors_field(field_api):
+    """Whether `field_api` is the core `authors` field. A custom person_list may share the name in a context with
+    no core authors field (projects), but doesn't get the authors-only rules."""
+    return (
+        field_api.name == UnderlyingFieldStatic.AUTHORS_FIELD_NAME
+        and field_api.internal_type == UnderlyingFieldStatic.INTERNAL_TYPE_CORE
+    )
+
+
+def is_empty(value):
+    return value is None or value == "" or value == [] or value is False
+
+
+def omit_empty(entry):
+    return {key: value for key, value in entry.items() if not is_empty(value)}
+
+
+def linked_user_ids(entries):
+    """`user_id`s of the entries, in order."""
+    return [entry["user_id"] for entry in entries or () if isinstance(entry, dict) and entry.get("user_id")]
+
+
+def normalize_ror_id(value, path):
+    """Accept a short ROR ID or a ``https://ror.org/<id>`` URL; return the short ID."""
+    if not isinstance(value, str):
+        raise exc.InvalidFormat(f"Invalid ROR ID for '{path}', expected string.", field=path)
+    ror_id = value.strip()
+    if ror_id.lower().startswith(ROR_URL_PREFIX):
+        ror_id = ror_id[len(ROR_URL_PREFIX) :].rstrip("/")
+    ror_id = ror_id.lower()
+    if not ROR_ID_REGEX.match(ror_id):
+        raise exc.InvalidFormat(f"Invalid ROR ID for '{path}'.", field=path)
+    return ror_id
+
+
+def _clean_string(value, path, max_length=UnderlyingFieldStatic.MAX_PERSON_STRING_LENGTH, sanitize=True):
+    """A string value HTML/URL-sanitised (`Validator.sanitize_string`, skipped with `sanitize=False`, e.g. for
+    emails), stripped and length-checked; None stays None."""
+    if value is None:
+        return None
+    if not isinstance(value, str):
+        raise exc.InvalidFormat(f"Invalid value for '{path}', expected string.", field=path)
+    value = (Validator.sanitize_string(value) if sanitize else value).strip()
+    if len(value) > max_length:
+        raise exc.InvalidLength(f"'{path}' must be at most {max_length} characters.", field=path)
+    return value
+
+
+def _normalize_orcid(orcid):
+    # ORCID's checksum digit X may come in lowercase
+    return orcid.upper() if orcid else orcid
+
+
+def _same_value(key, value, user_value):
+    """Whether a sent value equals the user's, so it isn't an override (emails compare case-insensitively)."""
+    value, user_value = value or "", user_value or ""
+    if key == "email":
+        return value.lower() == user_value.lower()
+    return value == user_value
+
+
+def _same_name(value, user_value):
+    return (value or "").strip().casefold() == (user_value or "").strip().casefold()
+
+
+def _profile_ror_id(user):
+    """An organization user's ROR id: the first ROR affiliation on its profile."""
+    for affiliation in user.affiliations if user else ():
+        if isinstance(affiliation, dict) and affiliation.get("ror_id"):
+            return affiliation["ror_id"]
+    return None
+
+
+def _user_value(user, key):
+    return (getattr(user, key, None) or None) if user else None
+
+
+def check_person_list_limit(account_id, count):
+    """The account's `max_authors` limit applies to every person_list, people and organizations together.
+
+    :raises figcore.exc.AccountLimitsReachedAuthors:
+    """
+    if account_id and count:
+        AccountLimitsInternals.check_limits({"authors"}, account_id, overhead={"authors": count})
+
+
+def check_mandatory_author_fields(entries, mandatory_fields=None, field_name=UnderlyingFieldStatic.AUTHORS_FIELD_NAME):
+    """Every person must have the base and the group's mandatory author fields, in `entries` given as merged
+    values (`resolve_person_list` read shape). Organizations only need a name, which is always set.
+
+    :raises figcore.exc.MissingMandatoryField:
+    """
+    fields = list(UserStatic.MANDATORY_AUTHOR_FIELDS)
+    fields += [field for field in mandatory_fields or () if field not in fields]
+    for index, entry in enumerate(entries or ()):
+        if not isinstance(entry, dict) or entry.get("type") != PERSON:
+            continue
+        for field in fields:
+            if is_empty(entry.get(field)):
+                path = f"{field_name}[{index}].{field}"
+                raise exc.MissingMandatoryField(f"Missing mandatory author field '{field}' for '{path}'.", field=path)
+
+
+def check_stored_mandatory_authors(entries, group):
+    """Check stored authors entries (e.g. when publishing without sending them) for the group's mandatory author
+    fields, on their merged values.
+
+    :raises figcore.exc.MissingMandatoryField:
+    """
+    mandatory_fields = group.get_mandatory_author_fields() if group else None
+    # mandatory author fields never include has_account, so skip its lookup
+    check_mandatory_author_fields(
+        resolve_person_list(entries, mask_emails=False, with_has_account=False), mandatory_fields
+    )
+
+
+class PersonListProcessor:
+    """Validate one sent person_list field value and turn it into the stored entries.
+
+    Entries with a `user_id` keep it and store only what differs from the user. Entries without one are typed
+    people or organizations: matched exactly to an existing user, or saved as a new ghost / organization user.
+
+    :param field_name: the underlying field name, used in error paths.
+    :param stored_entries: the currently stored value, whose overrides are kept for keys that aren't sent.
+    :param mandatory_author_fields: the group's extra mandatory author fields.
+    :param enforce_mandatory_authors: check mandatory author fields (only applies to the authors field).
+    :param account_id: when set, the account's person_list length limit is enforced.
+    :param is_authors: whether this is the core authors field (`is_corresponding`, mandatory author fields); by default,
+        whether `field_name` is `authors`.
+    :param owner_id: the owner `ensure_owner` added to the authors, if any: when a typed entry turns out to be the
+        owner, the added `{"user_id": owner_id}` entry is dropped instead of being a duplicate.
+    """
+
+    def __init__(
+        self,
+        field_name,
+        stored_entries=None,
+        mandatory_author_fields=None,
+        enforce_mandatory_authors=False,
+        account_id=None,
+        is_authors=None,
+        owner_id=None,
+    ):
+        self.field_name = field_name
+        self.is_authors = field_name == UnderlyingFieldStatic.AUTHORS_FIELD_NAME if is_authors is None else is_authors
+        self.owner_id = owner_id
+        self.stored_by_user_id = {
+            entry["user_id"]: entry
+            for entry in stored_entries or ()
+            if isinstance(entry, dict) and entry.get("user_id")
+        }
+        self.mandatory_author_fields = mandatory_author_fields
+        self.enforce_mandatory_authors = enforce_mandatory_authors and self.is_authors
+        self.account_id = account_id
+
+    def _path(self, index, key=None):
+        path = f"{self.field_name}[{index}]"
+        return f"{path}.{key}" if key else path
+
+    def process(self, entries):
+        if not isinstance(entries, list):
+            raise exc.InvalidFormat(f"Invalid value for '{self.field_name}', expected list.", field=self.field_name)
+
+        parsed = [self._parse_entry(index, entry) for index, entry in enumerate(entries)]
+        self._load_linked_users(parsed)
+        self._match_typed_entries(parsed)
+        parsed = self._without_added_owner(parsed)
+        # counted once the owner can't appear twice; still before any ghost user is created
+        check_person_list_limit(self.account_id, len(parsed))
+        self._check_list_rules(parsed)
+        if self.enforce_mandatory_authors:
+            check_mandatory_author_fields(
+                [item["merged"] for item in parsed], self.mandatory_author_fields, self.field_name
+            )
+        # users are only created once the whole value is valid, so a rejected save leaves no new ghost users
+        self._create_unmatched_users(parsed)
+        return [self._stored_entry(item) for item in parsed]
+
+    # -- parsing ---------------------------------------------------------------------------------------------
+
+    def _parse_entry(self, index, entry):
+        if not isinstance(entry, dict):
+            raise exc.InvalidFormat(f"Invalid value for '{self._path(index)}', expected object.", self._path(index))
+
+        user_id = entry.get("user_id")
+        if user_id is not None and (isinstance(user_id, bool) or not isinstance(user_id, int) or user_id <= 0):
+            path = self._path(index, "user_id")
+            raise exc.InvalidFormat(f"'{path}' must be a positive integer.", field=path)
+
+        person_type = entry.get("type")
+        if user_id is None or person_type is not None:
+            if isinstance(person_type, bool) or person_type not in UnderlyingFieldStatic.PERSON_TYPES:
+                raise exc.InvalidFormat(
+                    f"'{self._path(index, 'type')}' must be {PERSON} (person) or {ORGANIZATION} (organization).",
+                    field=self._path(index, "type"),
+                )
+
+        is_corresponding = entry.get("is_corresponding")
+        if is_corresponding is not None and not isinstance(is_corresponding, bool):
+            path = self._path(index, "is_corresponding")
+            raise exc.InvalidFormat(f"'{path}' must be a boolean.", field=path)
+
+        # for a linked entry the type is only known once the user is loaded; until then, its keys are checked
+        # against both types and narrowed in `_load_linked_users`
+        allowed = set()
+        for entry_type, keys in (
+            (PERSON, UnderlyingFieldStatic.PERSONAL_ENTRY_KEYS),
+            (ORGANIZATION, UnderlyingFieldStatic.ORGANIZATIONAL_ENTRY_KEYS),
+        ):
+            if person_type in (None, entry_type):
+                allowed.update(keys)
+        if user_id is None:
+            allowed.discard("user_id")
+        if not self.is_authors:
+            allowed.discard("is_corresponding")
+        unknown = sorted(set(entry) - allowed)
+        if unknown:
+            raise exc.InvalidFormat(
+                f"Unknown keys {unknown} for '{self._path(index)}'.", field=self._path(index, unknown[0])
+            )
+
+        values = {}
+        for key in ("first_name", "last_name", "name"):
+            if key in entry:
+                values[key] = _clean_string(entry[key], self._path(index, key))
+        if "email" in entry and not is_masked_email(entry["email"]):
+            # a masked email is what a read returned: the client didn't change it, so it isn't sent at all.
+            # Emails aren't HTML/URL sanitised (like `UserValidator.sanitize_input`), only format checked.
+            values["email"] = _clean_string(entry["email"], self._path(index, "email"), sanitize=False)
+            if values["email"] and not Validator.validate_email(values["email"]):
+                path = self._path(index, "email")
+                raise exc.InvalidFormat(f"Invalid email for '{path}'.", field=path)
+        if "orcid_id" in entry:
+            values["orcid_id"] = _normalize_orcid(_clean_string(entry["orcid_id"], self._path(index, "orcid_id")))
+            if values["orcid_id"] and not Validator.validate_orcid(values["orcid_id"]):
+                path = self._path(index, "orcid_id")
+                raise exc.InvalidFormat(f"Invalid ORCID for '{path}'.", field=path)
+        if not is_empty(entry.get("ror_id")):
+            values["ror_id"] = normalize_ror_id(entry["ror_id"], self._path(index, "ror_id"))
+
+        return {
+            "index": index,
+            "entry": entry,
+            "user_id": user_id,
+            "type": person_type,
+            "values": values,
+            "is_corresponding": is_corresponding,
+            "affiliations": self._process_affiliations(index, entry.get("affiliations")),
+            "contributors": _clean_string(
+                entry.get("contributors"),
+                self._path(index, "contributors"),
+                max_length=UnderlyingFieldStatic.MAX_CONTRIBUTORS_LENGTH,
+            ),
+            "user": None,
+        }
+
+    def _process_affiliations(self, index, affiliations):
+        path = self._path(index, "affiliations")
+        if affiliations is None:
+            return []
+        if not isinstance(affiliations, list):
+            raise exc.InvalidFormat(f"Invalid value for '{path}', expected list.", field=path)
+        if len(affiliations) > UnderlyingFieldStatic.MAX_AFFILIATIONS:
+            raise exc.InvalidLength(
+                f"'{path}' can have at most {UnderlyingFieldStatic.MAX_AFFILIATIONS} entries.", field=path
+            )
+
+        result = []
+        seen = set()
+        for position, affiliation in enumerate(affiliations):
+            item_path = f"{path}[{position}]"
+            if not isinstance(affiliation, dict):
+                raise exc.InvalidFormat(f"Invalid value for '{item_path}', expected object.", field=item_path)
+            unknown = sorted(set(affiliation) - set(AFFILIATION_KEYS))
+            if unknown:
+                raise exc.InvalidFormat(f"Unknown keys {unknown} for '{item_path}'.", field=f"{item_path}.{unknown[0]}")
+
+            name = _clean_string(affiliation.get("name"), f"{item_path}.name")
+            if not name:
+                raise exc.MissingMandatoryValue(
+                    f"Missing mandatory value for '{item_path}.name'.", field=f"{item_path}.name"
+                )
+            ror_id = affiliation.get("ror_id")
+            ror_id = normalize_ror_id(ror_id, f"{item_path}.ror_id") if not is_empty(ror_id) else None
+
+            key = ("ror", ror_id) if ror_id else ("name", name.lower())
+            if key in seen:
+                raise exc.DuplicateEntry(f"Duplicate affiliation '{item_path}'.", item_path)
+            seen.add(key)
+            result.append(omit_empty({"ror_id": ror_id, "name": name}))
+        return result
+
+    # -- users -----------------------------------------------------------------------------------------------
+
+    def _load_linked_users(self, parsed):
+        """Load the users of the entries sent with a `user_id` and check each entry against its user's type."""
+        user_ids = [item["user_id"] for item in parsed if item["user_id"]]
+        if not user_ids:
+            return
+        users = {user.id: user for user in APIEntity.ENTITIES.User.find_all(user_ids, load_profile=True)}
+        for item in parsed:
+            if not item["user_id"]:
+                continue
+            path = self._path(item["index"], "user_id")
+            user = users.get(item["user_id"])
+            if user is None:
+                raise exc.InvalidValue(f"User {item['user_id']} for '{path}' does not exist.", field=path)
+            item["user"] = user
+            item["type"] = ORGANIZATION if user.type == UserStatic.TYPE_ORGANIZATION else PERSON
+
+            entry_keys = (
+                UnderlyingFieldStatic.PERSONAL_ENTRY_KEYS
+                if item["type"] == PERSON
+                else UnderlyingFieldStatic.ORGANIZATIONAL_ENTRY_KEYS
+            )
+            unknown = sorted(set(item["entry"]) - set(entry_keys))
+            if unknown:
+                raise exc.InvalidFormat(
+                    f"Unknown keys {unknown} for '{self._path(item['index'])}'.",
+                    field=self._path(item["index"], unknown[0]),
+                )
+
+    def _match_typed_entries(self, parsed):
+        """Find the existing user each typed entry matches exactly; unmatched ones get a new user later."""
+        typed = [item for item in parsed if not item["user_id"]]
+        for item in typed:
+            values = item["values"]
+            if item["type"] == PERSON and not values.get("last_name"):
+                path = self._path(item["index"], "last_name")
+                raise exc.MissingMandatoryValue(f"Missing mandatory value for '{path}'.", field=path)
+            if item["type"] == ORGANIZATION and not values.get("name"):
+                path = self._path(item["index"], "name")
+                raise exc.MissingMandatoryValue(f"Missing mandatory value for '{path}'.", field=path)
+
+        # only entries with every matching value can match: people on name + email + ORCID, organizations on
+        # name + ROR id + email
+        candidates = [item for item in typed if self._match_values(item)]
+        users = APIEntity.ENTITIES.User.find_by_emails([item["values"]["email"] for item in candidates])
+        for item in candidates:
+            matches = [user for user in users if self._matches(item, user)]
+            if matches:
+                item["user"] = min(matches, key=lambda user: user.id)
+                item["user_id"] = item["user"].id
+
+    def _without_added_owner(self, parsed):
+        """Drop the `{"user_id": owner}` entry `ensure_owner` added when a typed entry already resolved to the owner,
+        keeping the typed one where it was sent."""
+        if not self.owner_id:
+            return parsed
+        typed_owner = any(item["entry"].get("user_id") is None and item["user_id"] == self.owner_id for item in parsed)
+        if not typed_owner:
+            return parsed
+        return [
+            item
+            for item in parsed
+            if not (item["entry"].get("user_id") == self.owner_id and set(item["entry"]) <= {"user_id"})
+        ]
+
+    @staticmethod
+    def _match_values(item):
+        values = item["values"]
+        keys = (
+            ("first_name", "last_name", "email", "orcid_id") if item["type"] == PERSON else ("name", "ror_id", "email")
+        )
+        return all(values.get(key) for key in keys)
+
+    @staticmethod
+    def _matches(item, user):
+        values = item["values"]
+        if (user.email or "").lower() != values["email"].lower():
+            return False
+        if item["type"] == PERSON:
+            return (
+                user.type != UserStatic.TYPE_ORGANIZATION
+                and _same_name(values["first_name"], user.first_name)
+                and _same_name(values["last_name"], user.last_name)
+                and _normalize_orcid(user.orcid_id) == values["orcid_id"]
+            )
+        return (
+            user.type == UserStatic.TYPE_ORGANIZATION
+            and _same_name(values["name"], user.name)
+            and _profile_ror_id(user) == values["ror_id"]
+        )
+
+    def _create_unmatched_users(self, parsed):
+        for item in parsed:
+            if item["user_id"]:
+                continue
+            values = item["values"]
+            if item["type"] == PERSON:
+                data = {
+                    "name": " ".join(part for part in (values.get("first_name"), values.get("last_name")) if part),
+                    "first_name": values.get("first_name") or "",
+                    "last_name": values["last_name"],
+                    "email": values.get("email") or "",
+                    "orcid_id": values.get("orcid_id") or "",
+                    "type": UserStatic.TYPE_PERSON,
+                }
+            else:
+                ror_id = values.get("ror_id")
+                data = {
+                    "name": values["name"],
+                    "first_name": "",
+                    "last_name": "",
+                    "email": values.get("email") or "",
+                    "orcid_id": "",
+                    "type": UserStatic.TYPE_ORGANIZATION,
+                    # the organization's ROR id lives with its profile affiliations, in the profile entry shape
+                    "profile_affiliations": (
+                        [{"ror_id": ror_id, "name": values["name"], "url": "", "order": 0}] if ror_id else []
+                    ),
+                }
+            item["user"] = APIEntity.ENTITIES.User.create_without_account(data)
+            item["user_id"] = item["user"].id
+
+    # -- list rules and stored shape -------------------------------------------------------------------------
+
+    def _check_list_rules(self, parsed):
+        seen_user_ids = set()
+        corresponding = 0
+        for item in parsed:
+            index = item["index"]
+            user_id = item["user_id"]
+            if user_id:
+                if user_id in seen_user_ids:
+                    path = self._path(index, "user_id")
+                    raise exc.DuplicateEntry(f"User {user_id} is listed more than once in '{self.field_name}'.", path)
+                seen_user_ids.add(user_id)
+            if item["is_corresponding"]:
+                corresponding += 1
+                if corresponding > UnderlyingFieldStatic.MAX_CORRESPONDING_AUTHORS:
+                    path = self._path(index, "is_corresponding")
+                    raise exc.InvalidValue(
+                        f"At most {UnderlyingFieldStatic.MAX_CORRESPONDING_AUTHORS} corresponding authors are allowed.",
+                        field=path,
+                    )
+            item["overrides"] = self._overrides(item)
+            item["merged"] = self._merged(item)
+
+    def _overrides(self, item):
+        """The values that differ from the user's: sent ones, or the stored ones for keys that weren't sent.
+
+        An organization's `name` and `ror_id` stay the user's: a per-item override for them isn't decided yet.
+        """
+        if not item["user"]:
+            return {}
+        keys = (
+            UnderlyingFieldStatic.PERSONAL_OVERRIDE_KEYS
+            if item["type"] == PERSON
+            else UnderlyingFieldStatic.ORGANIZATIONAL_OVERRIDE_KEYS
+        )
+        stored = self.stored_by_user_id.get(item["user_id"]) or {}
+        overrides = {}
+        for key in keys:
+            user_value = _user_value(item["user"], key)
+            if key in item["values"]:
+                value = item["values"][key] or None
+                if value is None:
+                    # cleared on this item; nothing to store if the user has no value either
+                    if user_value is not None:
+                        overrides[key] = None
+                elif not _same_value(key, value, user_value):
+                    overrides[key] = value
+            elif key in stored:
+                overrides[key] = stored[key]
+        return overrides
+
+    def _merged(self, item):
+        """The entry's values as readers see them, for the mandatory author fields check."""
+        if item["user"]:
+            merged = {
+                key: item["overrides"][key] if key in item["overrides"] else _user_value(item["user"], key)
+                for key in UnderlyingFieldStatic.PERSONAL_OVERRIDE_KEYS
+            }
+        else:
+            merged = {key: item["values"].get(key) for key in UnderlyingFieldStatic.PERSONAL_OVERRIDE_KEYS}
+        return {"type": item["type"], **merged}
+
+    def _stored_entry(self, item):
+        # a new user holds exactly the typed values, so its entry has no overrides
+        entry = {"user_id": item["user_id"], **item["overrides"]}
+        entry.update(
+            omit_empty(
+                {
+                    "is_corresponding": item["is_corresponding"],
+                    "affiliations": item["affiliations"] if item["type"] == PERSON else None,
+                    "contributors": item["contributors"] if item["type"] == ORGANIZATION else None,
+                }
+            )
+        )
+        return entry
+
+
+def process_person_list_fields(
+    underlying_fields,
+    stored_fields=None,
+    group=None,
+    enforce_mandatory_authors=False,
+    account_id=None,
+    owner_id=None,
+):
+    """Process every sent person_list field in `underlying_fields` (``{name: UnderlyingField}``) in place.
+
+    Fields whose value is ``None`` were not sent and are left alone (the transformer keeps the stored
+    value); ``[]`` clears the field. When publishing and `authors` wasn't sent, the stored authors are
+    checked for the mandatory author fields instead.
+
+    :param stored_fields: the entity's current `.fields` blob (``{str(field_id): {"value": ...}}``).
+    :param owner_id: the owner `ensure_owner` added to the authors, if any (see `PersonListProcessor`).
+    """
+    stored_fields = stored_fields or {}
+    mandatory_author_fields = group.get_mandatory_author_fields() if group and enforce_mandatory_authors else None
+    for field_name, field_api in underlying_fields.items():
+        if not is_person_list(field_api):
+            continue
+        is_authors = is_authors_field(field_api)
+        stored_entries = (stored_fields.get(str(field_api.id)) or {}).get("value") or []
+        if field_api.value is None:
+            if enforce_mandatory_authors and is_authors:
+                check_stored_mandatory_authors(stored_entries, group)
+            continue
+        processor = PersonListProcessor(
+            field_name,
+            stored_entries=stored_entries,
+            mandatory_author_fields=mandatory_author_fields,
+            enforce_mandatory_authors=enforce_mandatory_authors,
+            account_id=account_id,
+            is_authors=is_authors,
+            owner_id=owner_id if is_authors else None,
+        )
+        field_api.set_value(processor.process(field_api.value))
+
+
+def process_person_list_blob(fields_blob, account_id=None):
+    """Process person_list values in a raw `.fields`-shaped blob (``{field_id: {"value", "field_type", ...}}``),
+    e.g. batch fields that aren't assigned to the item type. Returns the blob, modified in place."""
+    for field_data in (fields_blob or {}).values():
+        if not isinstance(field_data, dict):
+            continue
+        if field_data.get("field_type") != UnderlyingFieldStatic.FIELD_TYPES[UnderlyingFieldStatic.TYPE_PERSON_LIST]:
+            continue
+        if field_data.get("value") is None:
+            continue
+        # unassigned fields are never the core authors field, which every item type has
+        processor = PersonListProcessor(
+            field_data.get("field_name") or "person_list", account_id=account_id, is_authors=False
+        )
+        field_data["value"] = processor.process(field_data["value"])
+    return fields_blob
+
+
+def ensure_owner(entries, user, prepend):
+    """Return `entries` with the owner added (first or last) unless they're already in it.
+
+    Run this before `process_person_list_fields` so the owner is validated like any other author.
+    """
+    entries = list(entries or [])
+    if user is None or user.id in linked_user_ids(entries):
+        return entries
+    entry = {"user_id": user.id}
+    return [entry] + entries if prepend else entries + [entry]
+
+
+def replace_linked_user(entries, old_user_id, new_user):
+    """Return `entries` with the entry of `old_user_id` moved to `new_user`, e.g. when an item moves to another
+    account.
+
+    The entry keeps its per-item data (affiliations, `is_corresponding`) but not its overrides, which described the
+    old user. If the new user is already in the list, the old entry is dropped instead, so the list has no
+    duplicate. With the same user on both sides, the entries are returned unchanged.
+    """
+    entries = list(entries or [])
+    # the same user on both sides (e.g. a move between two accounts of one user): nothing to relink
+    if new_user is None or new_user.id == old_user_id:
+        return entries
+    already_linked = new_user.id in linked_user_ids(entries)
+    result = []
+    for entry in entries:
+        if isinstance(entry, dict) and entry.get("user_id") == old_user_id:
+            if already_linked:
+                continue
+            kept = {key: entry[key] for key in ("affiliations", "is_corresponding") if key in entry}
+            entry = {"user_id": new_user.id, **kept}
+        result.append(entry)
+    return result
+
+
+def resolve_person_list_with_users(entries, mask_emails=True, with_has_account=True):
+    """Merge each stored entry with its user and profile. Returns ``(read entry, user)`` pairs, the user being
+    ``None`` when it no longer exists; see `resolve_person_list` for the read entry.
+
+    :param with_has_account: look up which users have an account (one extra query). Callers that don't read
+        `has_account` (validation, version diffs, exports) pass false; `has_account` is then ``None``, so a
+        caller that reads it (e.g. a truthiness check for the account badge) must keep the default.
+    """
+    entries = [entry for entry in entries or () if isinstance(entry, dict)]
+    user_ids = linked_user_ids(entries)
+    users = (
+        {user.id: user for user in APIEntity.ENTITIES.User.find_all(user_ids, load_profile=True)} if user_ids else {}
+    )
+    with_account = APIEntity.ENTITIES.User.ids_with_account(user_ids) if with_has_account else None
+    return [_read_entry(entry, users.get(entry.get("user_id")), with_account, mask_emails) for entry in entries]
+
+
+def resolve_person_list(entries, mask_emails=True, with_has_account=True):
+    """Stored entries as readers see them: the user's values with this item's overrides applied, every key
+    present, in stored order.
+
+    Keys: `type` (from `user.type`), `user_id`, `has_account`, `first_name`, `last_name`, `name` (derived for
+    people), `email` (masked unless `mask_emails` is false, for callers that send it on), `orcid_id`,
+    `is_corresponding`, `affiliations` (``[{ror_id, name}]``), `ror_id` (organizations), `contributors`. This is a
+    read shape only: clients save `{user_id}` plus what they changed. With `with_has_account` false, `has_account`
+    is ``None`` and the account lookup is skipped.
+    """
+    return [
+        entry
+        for entry, _ in resolve_person_list_with_users(
+            entries, mask_emails=mask_emails, with_has_account=with_has_account
+        )
+    ]
+
+
+def person_lists_differ(entries, other_entries):
+    """Whether two person_list values differ in what makes a new version, compared on merged values, order ignored:
+    a user added or removed, a person's name, email or ORCID, or an organization's name, email or ROR id.
+    Affiliations, `is_corresponding` and `contributors` don't count."""
+
+    def key_values(entries_):
+        result = {}
+        # has_account isn't compared, so skip its lookup
+        for entry in resolve_person_list(entries_, mask_emails=False, with_has_account=False):
+            keys = (
+                ("name", "email", "ror_id")
+                if entry["type"] == ORGANIZATION
+                else ("first_name", "last_name", "email", "orcid_id")
+            )
+            result[entry["user_id"]] = tuple(
+                (entry[key] or "").lower() if key == "email" else entry[key] for key in keys
+            )
+        return result
+
+    return key_values(entries) != key_values(other_entries)
+
+
+def _read_entry(entry, user, with_account, mask_emails):
+    def value(key):
+        # an override (including a `None` that clears it) wins over the user's value
+        return (entry[key] or None) if key in entry else _user_value(user, key)
+
+    is_organization = bool(user) and user.type == UserStatic.TYPE_ORGANIZATION
+    email = value("email")
+    if is_organization:
+        first_name = last_name = orcid_id = None
+        name = user.name or None
+        ror_id = _profile_ror_id(user)
+    else:
+        first_name, last_name, orcid_id = value("first_name"), value("last_name"), value("orcid_id")
+        name = " ".join(part for part in (first_name, last_name) if part) or None
+        ror_id = None
+    read = {
+        "type": ORGANIZATION if is_organization else PERSON,
+        "user_id": entry.get("user_id"),
+        # None when the caller skipped the account lookup (with_has_account=False)
+        "has_account": None if with_account is None else bool(user) and user.id in with_account,
+        "first_name": first_name,
+        "last_name": last_name,
+        "name": name,
+        "email": mask_email(email) if mask_emails else email,
+        "orcid_id": orcid_id,
+        "is_corresponding": bool(entry.get("is_corresponding")),
+        "affiliations": [
+            {"ror_id": affiliation.get("ror_id"), "name": affiliation.get("name")}
+            for affiliation in entry.get("affiliations") or ()
+        ],
+        "ror_id": ror_id,
+        "contributors": entry.get("contributors"),
+    }
+    return read, user
