index 000000000..8210a69ef
--- /dev/null
+++ b/src/figcore/lib/citations/authors.py
@@ -0,0 +1,42 @@
+"""The authors of an entity, in the shape the citation formats need."""
+
+from collections import namedtuple
+
+from figcore.api.underlying_field.person_list import resolve_person_list
+from figcore.lib.data.underlying_field_static import UnderlyingFieldStatic
+from figcore.lib.data.user_static import UserStatic
+
+# `type` is the user's `user.type` (`UserStatic.TYPE_PERSON` / `TYPE_ORGANIZATION`)
+CitationAuthor = namedtuple("CitationAuthor", ["name", "first_name", "last_name", "type"])
+
+
+def get_citation_authors(entity):
+    """The entity's authors, in order.
+
+    ITBM entities keep their authors only in the `authors` person_list field (the legacy authors column is
+    empty for them): each entry is merged with its user (account, ghost or organization user), the item's
+    overrides applied. Other entities use `entity.authors`.
+
+    :param entity: an Article, ArticleVersion, Collection or CollectionVersion API object
+    :returns: list of :class:`CitationAuthor`
+    """
+    if entity.has_itbm:
+        entries = entity.get_field_value(UnderlyingFieldStatic.AUTHORS_FIELD_NAME) or []
+        # citations only need names and type, so skip the has_account lookup
+        return [_from_read_entry(entry) for entry in resolve_person_list(entries, with_has_account=False)]
+
+    return [CitationAuthor(user.name, user.first_name, user.last_name, user.type) for user in entity.authors]
+
+
+def _from_read_entry(entry):
+    # the read entry's `type` comes from `user.type`; organizations have no first / last name
+    return CitationAuthor(entry["name"] or "", entry["first_name"] or "", entry["last_name"] or "", entry["type"])
+
+
+def format_family_given(author, separator=", "):
+    """The author as "Family, Given"; an organization (or a person without both names) gets a single name."""
+    if author.type == UserStatic.TYPE_ORGANIZATION:
+        return author.name
+    if author.first_name and author.last_name:
+        return "{}{}{}".format(author.last_name, separator, author.first_name)
+    return author.last_name or author.first_name or author.name
