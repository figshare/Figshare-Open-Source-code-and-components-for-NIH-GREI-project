--- /dev/null
+++ b/tests/graphql/api/item/test_hydrate_person_list.py
@@ -0,0 +1,103 @@
+import unittest
+
+from mock import Mock, patch
+
+from figcore.api import User
+from figcore.graphql.resolvers_v2.generic import hydrate_person_list
+from figcore.lib.data.user_static import UserStatic
+
+# stored entries: the user id plus only what differs on this item
+ACCOUNT_USER = {"user_id": 42, "last_name": "Doe-Smith"}
+GHOST = {
+    "user_id": 43,
+    "is_corresponding": True,
+    "affiliations": [{"ror_id": "041kmwe10", "name": "Imperial"}, {"name": "Free text"}],
+}
+ORGANIZATION = {"user_id": 44, "contributors": "A, B"}
+ACCOUNT_FLAGS = ("isActive", "isPublic", "publicUrl")
+
+
+def user(user_id, user_type=UserStatic.TYPE_PERSON, **values):
+    attributes = {"first_name": "", "last_name": "", "name": "", "email": "", "orcid_id": "", "affiliations": []}
+    attributes.update(values, id=user_id, type=user_type, url_name="url-name", is_active=False, is_public=True)
+    mock = Mock(photo_url="https://test.com/p.png")
+    # set after creation: `name` is a `Mock()` argument, not an attribute
+    for key, value in attributes.items():
+        setattr(mock, key, value)
+    return mock
+
+
+class TestHydratePersonList(unittest.TestCase):
+    def setUp(self):
+        self.info = Mock()
+        self.info.context.get_url_details = Mock(return_value={"url": "https://test.com/profile"})
+        users = [
+            # an inactive user with an account is still listed with its account flags
+            user(42, first_name="Jane", last_name="Doe", email="jane.doe@example.org"),
+            user(43, first_name="", last_name="Smith", email="smith@example.org"),
+            user(
+                44,
+                UserStatic.TYPE_ORGANIZATION,
+                name="ACME",
+                email="info@acme.org",
+                affiliations=[{"ror_id": "041kmwe10", "name": "ACME", "url": "", "order": 0}],
+            ),
+        ]
+        self.find_all = patch.object(User, "find_all", return_value=users).start()
+        patch.object(User, "ids_with_account", return_value={42}).start()
+        self.addCleanup(patch.stopall)
+
+    def hydrate(self, **kwargs):
+        return hydrate_person_list([ACCOUNT_USER, GHOST, ORGANIZATION], 1, self.info, **kwargs)
+
+    def test_entries_are_merged_with_their_user_with_camel_case_keys(self):
+        account_user, ghost, organization = self.hydrate()
+
+        self.find_all.assert_called_once_with([42, 43, 44], load_profile=True)
+        self.assertEqual(
+            account_user,
+            {
+                "type": 1,
+                "userId": 42,
+                "hasAccount": True,
+                "firstName": "Jane",
+                "lastName": "Doe-Smith",
+                "name": "Jane Doe-Smith",
+                "email": "j******e@example.org",
+                "orcidId": None,
+                "isCorresponding": False,
+                "affiliations": [],
+                "rorId": None,
+                "contributors": None,
+                "isActive": False,
+                "isPublic": True,
+                "publicUrl": "https://test.com/profile",
+            },
+        )
+        self.assertEqual((ghost["name"], ghost["hasAccount"], ghost["isCorresponding"]), ("Smith", False, True))
+        self.assertEqual(
+            ghost["affiliations"], [{"rorId": "041kmwe10", "name": "Imperial"}, {"rorId": None, "name": "Free text"}]
+        )
+        self.assertEqual(
+            {key: organization[key] for key in ("type", "userId", "hasAccount", "name", "rorId", "contributors")},
+            {
+                "type": 2,
+                "userId": 44,
+                "hasAccount": False,
+                "name": "ACME",
+                "rorId": "041kmwe10",
+                "contributors": "A, B",
+            },
+        )
+        # ghost and organization users have no public profile, so no account flags
+        for entry in (ghost, organization):
+            self.assertFalse(set(ACCOUNT_FLAGS) & set(entry))
+
+    def test_photo_url_only_when_asked(self):
+        self.assertNotIn("photoUrl", self.hydrate()[0])
+        self.assertEqual(self.hydrate(options={"author.add_photo_url": True})[0]["photoUrl"], "https://test.com/p.png")
+
+    def test_emails_are_masked(self):
+        self.assertEqual(
+            [entry["email"] for entry in self.hydrate()], ["j******e@example.org", "s***h@example.org", "i**o@acme.org"]
+        )
