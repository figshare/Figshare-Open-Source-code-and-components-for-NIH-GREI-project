+import unittest
+
+from mock import patch
+
+from figcore.api import UnderlyingField
+from figcore.graphql.utils.itbm_utils import person_lists_to_snake
+
+
+class TestPersonListsToSnake(unittest.TestCase):
+    def setUp(self):
+        patcher = patch.object(UnderlyingField, "get_person_list_field_ids", return_value=frozenset({"10", "11"}))
+        self.get_person_list_field_ids = patcher.start()
+        self.addCleanup(patch.stopall)
+
+    def test_only_person_list_values_are_converted(self):
+        underlying_fields = {
+            "10": [{"type": 1, "userId": 5, "affiliations": [{"rorId": "041kmwe10", "name": "Imperial"}]}],
+            11: [{"type": 1, "lastName": "Smith"}],
+            # funding entries keep their GraphQL keys: they aren't person_lists
+            "20": [{"title": "Grant", "grantCode": "G1"}],
+        }
+
+        result = person_lists_to_snake(underlying_fields, 1)
+
+        self.assertIs(result, underlying_fields)
+        self.assertEqual(
+            underlying_fields,
+            {
+                "10": [{"type": 1, "user_id": 5, "affiliations": [{"ror_id": "041kmwe10", "name": "Imperial"}]}],
+                11: [{"type": 1, "last_name": "Smith"}],
+                "20": [{"title": "Grant", "grantCode": "G1"}],
+            },
+        )
+        self.get_person_list_field_ids.assert_called_once_with(1, "items")
+
+    def test_nothing_sent(self):
+        self.assertIsNone(person_lists_to_snake(None, 1))
+        self.assertEqual(person_lists_to_snake({}, 1), {})
+        self.get_person_list_field_ids.assert_not_called()
