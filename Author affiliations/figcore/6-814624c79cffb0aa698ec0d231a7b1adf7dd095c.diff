+        self.assertIn(
+            "<dc:creator>Jane Smith</dc:creator>\n<dc:creator>Doe</dc:creator>\n"
+            "<dc:creator>Wellcome Sanger Institute</dc:creator>",
+            output,
+        )
+
+    def test_default_citation(self):
+        citation = citations.get_citation_string(_itbm_article(), "figshare-datacite")
+
+        self.assertTrue(citation.startswith("Smith, Jane; Doe; Wellcome Sanger Institute (2015)."), citation)
+
+    def test_citeproc_keeps_organization_names_whole(self):
+        citation = citations.get_citation_string(_itbm_article(), "apa")
