+class TestCollectionITBMPersonLists(BaseTestTransactioned):
+    """ITBM collections store person_lists in the agreed entry format; `.fields` is the only source of truth."""
+
+    @classmethod
+    def setUpClass(cls):
+        super(TestCollectionITBMPersonLists, cls).setUpClass()
+        cls.setup_environment()
+        ensure_fields_column(DBConnection)
+        cls.create_complete_environment()
+        cls.feature_flag_overrides = {
+            "itbm_config": Mock(is_active=True, options={"allowed_portals": [0, 1]}),
+            "itbm_enabled": Mock(is_active=True, options={"allowed_portals": [0, 1]}),
+        }
+        cls.create_itbm_fields()
+        create_collection_underlying_fields(DBConnection, institution_id=1)
+        cls.underlying_fields = {
+            f.name: str(f.id) for f in UnderlyingField.get_underlying_fields(institution_id=1, context="collections")
+        }
+        cls.authors_id = cls.underlying_fields["authors"]
+        cls.owner = Account.find(1).user
+        cls.other_user = User.find_by_account_id(2)
+
+    def _data(self, authors=None):
+        fields = {
+            self.underlying_fields["title"]: "Person list collection",
+            self.underlying_fields["description"]: "Person list description",
+            self.underlying_fields["keywords"]: ["person", "list"],
+        }
+        if authors is not None:
+            fields[self.authors_id] = authors
+        return {"account_id": 1, "institution_id": 1, "group_id": 1, "fields": fields}
+
+    def _authors(self, collection, version=False):
+        collection = Collection.find(collection.id)
+        return (collection.last_version if version else collection).get_field_value("authors") or []
+
+    def _names(self, collection):
+        return [entry["name"] for entry in resolve_person_list(self._authors(collection))]
+
+    def _assert_no_legacy_authors(self, collection):
+        self.assertEqual(CollectionInternals.get_authors(collection.id), [])
+        self.assertFalse(Collection.find(collection.id).metadata.authors)
+
+    def _publish_collection(self, collection):
+        self._add_published_article(collection)
+        Account.find(1).actions_for(collection).update({"status": "public"})
+        collection._instantiate_defaults()
+
+    def _add_published_article(self, collection):
+        account = Account.find(1)
+        item_ufs = {f.name: str(f.id) for f in UnderlyingField.get_underlying_fields(institution_id=1, context="items")}
+        article = Article.create_itbm_article(
+            {
+                "item_type_id": 3,
+                "account_id": 1,
+                "institution_id": 1,
+                "group_id": 1,
+                "underlying_fields": {
+                    item_ufs["title"]: "Article for person list collection",
+                    item_ufs["description"]: "Article description",
+                    item_ufs["keywords"]: ["test"],
+                    item_ufs["licence"]: 1,
+                    item_ufs["categories"]: [2],
+                },
+            }
+        )
+        self.add_file_to_article(article_id=article.id)
+        account.actions_for(article).publish()
+        account.add_articles_to_collection(collection.id, [article.id])
+        collection._instantiate_defaults()
+
+    def _update(self, collection, authors, **data):
+        Collection.find(collection.id).update(dict(data, fields={self.authors_id: authors}))
+
+    def test_create_owner_appended_and_typed_entries_become_users(self):
+        collection = Collection.create(self._data([JANE, JOHN, ORG]))
+
+        jane, john, org, owner = self._authors(collection)
+        self.assertEqual(set(jane), {"user_id"})
+        self.assertEqual(john, {"user_id": john["user_id"], "affiliations": [{"ror_id": "041kmwe10", "name": "X"}]})
+        self.assertEqual(org, {"user_id": org["user_id"], "is_corresponding": True})
+        self.assertEqual(owner, {"user_id": self.owner.id})
+        self.assertEqual(self._names(collection), ["Jane Doe", "John Doe", "Some Consortium", self.owner.name])
+        # new ghost and organization users, without an account
+        self.assertFalse(User.ids_with_account([jane["user_id"], john["user_id"], org["user_id"]]))
+        self.assertEqual(User.find(org["user_id"]).type, UserStatic.TYPE_ORGANIZATION)
+        self._assert_no_legacy_authors(collection)
+
+    def test_create_owner_kept_in_place_when_sent(self):
+        collection = Collection.create(self._data([{"user_id": self.owner.id, "is_corresponding": True}, JANE]))
+
+        authors = self._authors(collection)
+        self.assertEqual(authors[0], {"user_id": self.owner.id, "is_corresponding": True})
+        self.assertEqual(len(authors), 2)
+
+    def test_create_without_owner(self):
+        collection = Collection.create(self._data([JANE]), owner_is_author=False)
+        self.assertEqual(self._names(collection), ["Jane Doe"])
+
+        collection = Collection.create(self._data(), owner_is_author=False)
+        self.assertEqual(Collection.find(collection.id).fields[self.authors_id]["value"], [])
+
+    def test_create_old_shape_rejected(self):
+        # a value that isn't a list is rejected as is, not turned into a list with the owner added
+        for authors in ("wrong", ["wrong"], [{"name": "Test author"}], [{"id": 1}], [{"user_id": 0}]):
+            with self.subTest(authors=authors), self.assertRaises((exc.InvalidFormat, exc.InvalidValue)):
+                Collection.create(self._data(authors))
+
+    def test_create_ghost_user_accepted(self):
+        ghost = User.create_author({"name": "Foo Bar", "first_name": "Foo", "last_name": "Bar"})
+        collection = Collection.create(self._data([{"user_id": ghost.id}]))
+        self.assertEqual(self._authors(collection)[0], {"user_id": ghost.id})
+
+    def test_create_limit_counts_the_owner(self):
+        authors = [dict(JANE, last_name=str(i)) for i in range(100)]
+        with self.assertRaises(exc.AccountLimitsReachedAuthors):
+            Collection.create(self._data(authors))
+        Collection.create(self._data(authors), owner_is_author=False)
+
+    def test_update_stores_in_order_and_only_differences(self):
+        collection = Collection.create(self._data([JANE]), owner_is_author=False)
+
+        self._update(collection, [JOHN, {"user_id": self.other_user.id}, ORG])
+        self.assertEqual(self._names(collection), ["John Doe", self.other_user.name, "Some Consortium"])
+        self.assertEqual(self._authors(collection)[1], {"user_id": self.other_user.id})
+
+        override = {"user_id": self.other_user.id, "last_name": "Override"}
+        self._update(collection, [override])
+        self.assertEqual(self._authors(collection), [override])
+
+        # what a read returns (merged, email masked) sent back unchanged keeps the stored entry
+        read = resolve_person_list(self._authors(collection))[0]
+        sent = {key: read[key] for key in ("user_id", "first_name", "last_name", "email", "orcid_id")}
+        self._update(collection, [sent])
+        self.assertEqual(self._authors(collection), [override])
+
+        self._update(collection, [])
+        self.assertEqual(self._authors(collection), [])
+        self._assert_no_legacy_authors(collection)
+
+    def test_partial_update_does_not_reprocess_stored_person_lists(self):
+        collection = Collection.create(self._data([JANE]))
+        stored = self._authors(collection)
+
+        with patch("figcore.api.underlying_field.person_list.PersonListProcessor.process") as process:
+            collection.update({"fields": {self.underlying_fields["title"]: "Only the title changes"}})
+
+        process.assert_not_called()
+        self.assertEqual(self._authors(collection), stored)
+
+    def test_validator_falls_back_to_stored_authors(self):
+        collection = Collection.create(self._data([JANE]), owner_is_author=False)
+        authors_field = UnderlyingField.find(int(self.authors_id))
+
+        validator = CollectionITBMValidator(collection, {"underlying_fields": {}}, [])
+        validator._validate_authors(authors_field, validate_for="publish")
+
+        collection.update({"fields": {self.authors_id: []}})
+        validator = CollectionITBMValidator(Collection.find(collection.id), {"underlying_fields": {}}, [])
+        with self.assertRaises(exc.MissingMandatoryValue):
+            validator._validate_authors(authors_field, validate_for="publish")
+
+    def test_new_version_on_author_changes(self):
+        collection = Collection.create(self._data([JANE, JOHN]), owner_is_author=False)
+        self._publish_collection(collection)
+        jane, john = self._authors(collection)
+
+        for authors in ([jane], [jane, john], [dict(jane, last_name="Smith"), john]):
+            version = Collection.find(collection.id).version
+            self._update(collection, authors, status=collection.STATUS_PUBLIC)
+            self.assertEqual(Collection.find(collection.id).version, version + 1, authors)
+            self.assertEqual(self._authors(collection, version=True), authors)
+
+    def test_no_new_version_for_order_affiliations_or_corresponding(self):
+        collection = Collection.create(self._data([JANE, JOHN]), owner_is_author=False)
+        self._publish_collection(collection)
+        version = Collection.find(collection.id).version
+        jane, john = self._authors(collection)
+
+        for authors in ([john, jane], [dict(jane, is_corresponding=True), dict(john, affiliations=[{"name": "Lab"}])]):
+            self._update(collection, authors, status=collection.STATUS_PUBLIC)
+            self.assertEqual(Collection.find(collection.id).version, version, authors)
+
+    def test_create_typed_owner_not_duplicated(self):
+        orcid_id = "0000-0002-1825-0097"
+        with DBConnection.get_session() as session:
+            session.execute(
+                "UPDATE user_profile SET orcid_id = :orcid WHERE user_id = :id",
+                {"orcid": orcid_id, "id": self.owner.id},
+            )
+            session.commit()
+        owner = User.find(self.owner.id)
+        typed_owner = {
+            "type": 1,
+            "first_name": owner.first_name,
+            "last_name": owner.last_name,
+            "email": owner.email,
+            "orcid_id": orcid_id,
+        }
+        # typed in by hand (not picked): it resolves to the owner, who isn't appended a second time
+        collection = Collection.create(self._data([typed_owner, JANE]))
+
+        authors = self._authors(collection)
+        self.assertEqual(authors[0], {"user_id": owner.id})
+        self.assertEqual(len(authors), 2)
+
+    def test_publish_checks_mandatory_author_fields(self):
+        collection = Collection.create(self._data([JANE]), owner_is_author=False)
+        self._add_published_article(collection)
+        collection.group.update_group({"flags": {"mandatory_author_fields": ["orcid_id"]}})
+        jane = self._authors(collection)[0]
+        actions = Account.find(1).actions_for
+
+        # draft saves stay permissive
+        self._update(collection, [jane])
+        # the publish action sends only the status: the stored authors are checked
+        with self.assertRaises(exc.MissingMandatoryField):
+            actions(Collection.find(collection.id)).update({"status": "public"})
+        # publishing with the authors sent checks the sent ones
+        with self.assertRaises(exc.MissingMandatoryField):
+            self._update(collection, [jane], status=collection.STATUS_PUBLIC)
+
+        # an override fills the missing value on this collection
+        self._update(collection, [dict(jane, orcid_id="0000-0002-1825-0097")])
+        actions(Collection.find(collection.id)).update({"status": "public"})
+        self.assertTrue(Collection.find(collection.id).is_public)
+
+    def test_publish_checks_mandatory_author_fields_while_updating_references(self):
+        # with a resource DOI, sending `references` takes the resource cleanup branch of the update, which skips the
+        # legacy author check chained after it; the ITBM check runs anyway
+        collection = Collection.create(self._data([JANE]), owner_is_author=False)
+        self._add_published_article(collection)
+        actions = Account.find(1).actions_for
+        actions(Collection.find(collection.id)).update({"resource_doi": "10.5555/abc", "resource_title": "Resource"})
+        self.assertEqual(Collection.find(collection.id).resource.resource_doi, "10.5555/abc")
+        collection.group.update_group({"flags": {"mandatory_author_fields": ["orcid_id"]}})
+
+        with self.assertRaises(exc.MissingMandatoryField):
+            actions(Collection.find(collection.id)).update({"status": "public", "references": []})
+
+    def test_person_list_emails_kept_as_sent(self):
+        # the generic sanitiser would URL-decode `%2B`, making it another address
+        collection = Collection.create(
+            self._data([{"type": 1, "last_name": "Tag", "email": "jane%2Btag@example.org"}]), owner_is_author=False
+        )
+        self.assertEqual(User.find(self._authors(collection)[0]["user_id"]).email, "jane%2Btag@example.org")
