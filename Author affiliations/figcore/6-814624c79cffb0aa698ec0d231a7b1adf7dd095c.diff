+# stored ITBM entries: a user id plus this item's overrides (Jane's family name is overridden on this item)
+ITBM_AUTHOR_ENTRIES = [{"user_id": 5, "last_name": "Smith"}, {"user_id": 6}, {"user_id": 7}]
+
+
+def _user(user_id, user_type=1, name="", first_name="", last_name=""):
+    user = mock.Mock(id=user_id, type=user_type, first_name=first_name, last_name=last_name, orcid_id="")
+    user.name, user.email, user.affiliations = name, "", []
+    return user
+
+
+# an account user, a ghost user without a given name and an organization user
+ITBM_USERS = [
+    _user(5, name="Jane Smyth", first_name="Jane", last_name="Smyth"),
+    _user(6, name="Doe", last_name="Doe"),
+    _user(7, user_type=2, name="Wellcome Sanger Institute"),
+]
+
+
+def _itbm_article(entries=ITBM_AUTHOR_ENTRIES):
+    """An ITBM item: its authors are only in the `authors` person_list field, the legacy authors are empty."""
+    itbm_article = deepcopy(article)
+    itbm_article.has_itbm = True
+    itbm_article.authors = []
+    itbm_article.get_field_value = mock.Mock(side_effect=lambda name: deepcopy(entries) if name == "authors" else None)
+    return itbm_article
+
+
+class ItbmUsersTestCase(unittest.TestCase):
+    """The ITBM entries are merged with their users, looked up here instead of in the database."""
+
+    def setUp(self):
+        super().setUp()
+        self.patched = {}
+        for name, value in (("find_all", ITBM_USERS), ("ids_with_account", {5})):
+            patcher = mock.patch.object(User, name, return_value=value)
+            self.patched[name] = patcher.start()
+            self.addCleanup(patcher.stop)
+
+
+class TestCitationAuthors(ItbmUsersTestCase):
+    def test_itbm_authors_come_from_the_authors_field(self):
+        authors = citations.get_citation_authors(_itbm_article())
+
+        self.assertEqual(
+            authors,
+            [
+                citations.authors.CitationAuthor("Jane Smith", "Jane", "Smith", 1),
+                citations.authors.CitationAuthor("Doe", "", "Doe", 1),
+                citations.authors.CitationAuthor("Wellcome Sanger Institute", "", "", 2),
+            ],
+        )
+        # citations don't read has_account, so its user_account lookup is skipped
+        self.patched["ids_with_account"].assert_not_called()
+
+    def test_itbm_without_authors(self):
+        self.assertEqual(citations.get_citation_authors(_itbm_article(entries=None)), [])
+
+    def test_legacy_authors_come_from_the_users(self):
+        authors = citations.get_citation_authors(article)
+
+        self.assertEqual([a.name for a in authors], ["John Brooks", "Anna Jenkin", "The MICE Collaboration"])
+        # legacy authors are users too: the type is the user's
+        self.assertEqual([a.type for a in authors], [1, 1, 1])
