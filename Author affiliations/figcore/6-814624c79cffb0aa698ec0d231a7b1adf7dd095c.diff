+class TestResolvePersonList(PersonListUsersTestCase):
+    def test_merges_user_and_overrides(self):
+        user = self.make_user()
+        organization = self.make_organization()
+        stored = [
+            {
+                "user_id": user.id,
+                "last_name": "Lee-Brown",
+                "orcid_id": None,
+                "is_corresponding": True,
+                "affiliations": [{"name": "Lab"}],
+            },
+            {"user_id": organization.id, "contributors": "Jane"},
+            {"user_id": self.account_user.id},
+        ]
+        person, org, account_user = resolve_person_list(stored)
+        self.assertEqual(
+            person,
+            {
+                "type": 1,
+                "user_id": user.id,
+                "has_account": False,
+                "first_name": "Ann",
+                "last_name": "Lee-Brown",
+                "name": "Ann Lee-Brown",
+                "email": "a*****e@uni.edu",
+                "orcid_id": None,
+                "is_corresponding": True,
+                "affiliations": [{"ror_id": None, "name": "Lab"}],
+                "ror_id": None,
+                "contributors": None,
+            },
+        )
+        self.assertEqual(
+            org,
+            {
+                "type": 2,
+                "user_id": organization.id,
+                "has_account": False,
+                "first_name": None,
+                "last_name": None,
+                "name": "Wellcome Sanger Institute",
+                "email": "i**o@sanger.ac.uk",
+                "orcid_id": None,
+                "is_corresponding": False,
+                "affiliations": [],
+                "ror_id": "05cy4wa09",
+                "contributors": "Jane",
+            },
+        )
+        self.assertTrue(account_user["has_account"])
+        self.assertEqual(account_user["name"], self.account_user.name)
+
+    def test_unmasked_for_internal_callers(self):
+        user = self.make_user()
+        self.assertEqual(resolve_person_list([{"user_id": user.id}], mask_emails=False)[0]["email"], "ann.lee@uni.edu")
+
+    def test_without_has_account_skips_the_account_lookup(self):
+        user = self.make_user()
+        stored = [{"user_id": user.id, "last_name": "Lee-Brown"}, {"user_id": self.account_user.id}]
+        with_lookup = resolve_person_list(stored)
+
+        with patch.object(User, "ids_with_account", wraps=User.ids_with_account) as ids_with_account:
+            without_lookup = resolve_person_list(stored, with_has_account=False)
+
+        ids_with_account.assert_not_called()
+        # has_account is unknown (None); every other value is the same as with the lookup
+        self.assertEqual([entry["has_account"] for entry in without_lookup], [None, None])
+        self.assertEqual(
+            [dict(entry, has_account=None) for entry in with_lookup],
+            without_lookup,
+        )
