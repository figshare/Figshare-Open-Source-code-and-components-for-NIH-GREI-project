 from figcore.lib.text_bytes import ensure_str
 
 
+# what `mask_email` leaves of a local part: all stars (short ones), or the first and last character around stars
+MASKED_LOCAL_PART_REGEX = re.compile(r"^(\*{1,3}|[^*]\*{2,}[^*])$")
+
+
+def mask_email(email):
+    """Hide an email's local part, keeping its first and last character (all of it when it's shorter than 4)."""
+    if not email:
+        return email
+    name, domain = email.split("@", 1)
+    if len(name) < 4:
+        name = "*" * len(name)
+    else:
+        name = name[0] + "*" * (len(name) - 2) + name[-1]
+    return "@".join([name, domain])
+
+
+def is_masked_email(value):
+    """Whether `value` has the shape `mask_email` produces. A real address can only look like this if its local part
+    is made of stars in the same places, which callers accept as masked."""
+    if not isinstance(value, str) or value.count("@") != 1:
+        return False
+    name, domain = value.split("@")
+    return bool(domain) and "*" not in domain and bool(MASKED_LOCAL_PART_REGEX.match(name))
+
