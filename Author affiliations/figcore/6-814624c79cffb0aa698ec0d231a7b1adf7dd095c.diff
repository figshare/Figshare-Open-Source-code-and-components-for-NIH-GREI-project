+from itertools import count
+from unittest import TestCase
+
+from mock import Mock, patch
+
+import figcore.exc as fig_exc
+from figcore.api import User
+from figcore.api.underlying_field.person_list import (
+    PersonListProcessor,
+    check_mandatory_author_fields,
+    ensure_owner,
+    normalize_ror_id,
+    omit_empty,
+    person_lists_differ,
+    process_person_list_blob,
+    process_person_list_fields,
+    replace_linked_user,
+    resolve_person_list,
+)
+from figcore.lib.data.user_static import UserStatic
+from tests import BaseTestTransactioned
+
+# the smallest valid typed person and organization entries, which most tests extend
+PERSON = {"type": 1, "first_name": "Jane", "last_name": "Smith"}
+ORG = {"type": 2, "name": "Wellcome Sanger Institute"}
+
+
+def process(entries, field_name="authors", **kwargs):
+    return PersonListProcessor(field_name, **kwargs).process(entries)
+
+
+class TestHelpers(TestCase):
+    def test_omit_empty(self):
+        self.assertEqual(
+            omit_empty({"a": None, "b": "", "c": [], "d": False, "e": 0, "f": "x", "g": True}),
+            {"e": 0, "f": "x", "g": True},
+        )
+
+    def test_normalize_ror_id(self):
+        for value in ("041kmwe10", " 041KMWE10 ", "https://ror.org/041kmwe10", "https://ror.org/041kmwe10/"):
+            self.assertEqual(normalize_ror_id(value, "p"), "041kmwe10")
+
+    def test_normalize_ror_id_invalid(self):
+        for value in (
+            "141kmwe10",
+            "041kmwe1",
+            "041kmwel0",
+            "https://example.org/041kmwe10",
+            "http://ror.org/041kmwe10",
+            123,
+        ):
+            with self.assertRaises(fig_exc.InvalidFormat) as ctx:
+                normalize_ror_id(value, "authors[0].ror_id")
+            self.assertEqual(ctx.exception.field, "authors[0].ror_id")
+            # the raw input is not echoed back in the error
+            self.assertNotIn(str(value), str(ctx.exception))
+
+    def test_check_mandatory_author_fields(self):
+        # merged values (read shape); organizations only need their name
+        entries = [{"type": 2, "name": "Org", "last_name": None}, {"type": 1, "first_name": None, "last_name": "Smith"}]
+        check_mandatory_author_fields(entries)
+        with self.assertRaises(fig_exc.MissingMandatoryField) as ctx:
+            check_mandatory_author_fields(entries, ["first_name"])
+        self.assertEqual(ctx.exception.field, "authors[1].first_name")
+
+    def test_ensure_owner(self):
+        owner = Mock(id=7)
+        other = {"user_id": 3}
+        self.assertEqual(ensure_owner([other], owner, prepend=True), [{"user_id": 7}, other])
+        self.assertEqual(ensure_owner([other], owner, prepend=False), [other, {"user_id": 7}])
+        self.assertEqual(ensure_owner(None, owner, prepend=True), [{"user_id": 7}])
+
+        listed = {"user_id": 7, "last_name": "X", "is_corresponding": True}
+        self.assertEqual(ensure_owner([other, listed], owner, prepend=True), [other, listed])
+
+    def test_replace_linked_user(self):
+        new_owner = Mock(id=8)
+        other = {"user_id": 3}
+        old = {
+            "user_id": 7,
+            "last_name": "Old",
+            "email": None,
+            "is_corresponding": True,
+            "affiliations": [{"name": "A"}],
+        }
+        # the old owner's overrides go, the per-item data stays
+        new_entry = {"user_id": 8, "is_corresponding": True, "affiliations": [{"name": "A"}]}
+        self.assertEqual(replace_linked_user([other, old], 7, new_owner), [other, new_entry])
+        # the new user is already listed: the old entry is dropped, no duplicate
+        listed = {"user_id": 8, "last_name": "Listed"}
+        self.assertEqual(replace_linked_user([old, listed], 7, new_owner), [listed])
+        # nothing for the old user: unchanged
