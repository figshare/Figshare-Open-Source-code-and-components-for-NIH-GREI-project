diff --git a/tests/api/user/test_api.py b/tests/api/user/test_api.py
index 14a451f95..6d5fd236f 100644
--- a/tests/api/user/test_api.py
+++ b/tests/api/user/test_api.py
@@ -963,6 +963,56 @@ class TestUserClassMethods(BaseTest):
             )
         self.assertEqual(exc_context.exception.field, "name")
 
+    def test_process_users_list_does_not_merge_affiliations_into_profile(self):
+        """process_users_list must NOT write article affiliations to user_profile.grid_ids.
+
+        Previously, FTP/publisher uploads merged affiliations into user profiles,
+        polluting real profiles with unverified data (FIG-47076).
+        """
+        # Set up a user with a known grid_id on their profile
+        account = Account.find(1)
+        user = account.user
+        original_grid_ids = ["grid.original.1"]
+        with self.DB.get_session() as db_session:
+            UserDBCalls.update_user_profile_model(db_session, user.id, {"grid_ids": original_grid_ids})
+
+        # Call process_users_list with different affiliations (simulating an FTP upload)
+        article_affiliations = ["grid.ftp.999"]
+        User.process_users_list([{"id": user.id, "affiliations": article_affiliations}])
+
+        # Verify the profile grid_ids were NOT changed
+        with self.DB.get_session() as db_session:
+            profile = UserDBCalls.get_profile(db_session, user.id)
+            self.assertEqual(profile.grid_ids, original_grid_ids)
+
+    def test_process_users_list_returns_article_affiliations_from_payload(self):
+        """process_users_list should use the affiliations from the payload on the article."""
+        account = Account.find(1)
+        user = account.user
+
+        article_affiliations = ["grid.from.payload"]
+        result = User.process_users_list([{"id": user.id, "affiliations": article_affiliations}])
+
+        self.assertEqual(len(result), 1)
+        self.assertEqual(result[0]["affiliations"], article_affiliations)
+
+    def test_process_users_list_does_not_read_profile_grid_ids_as_fallback(self):
+        """When no affiliations in payload, must NOT fall back to profile grid_ids (FIG-47077).
+
+        Profile-derived affiliations were being sent to DataCite, producing
+        inaccurate metadata. Affiliations should only come from the article
+        payload, not from user profiles.
+        """
+        account = Account.find(1)
+        user = account.user
+        with self.DB.get_session() as db_session:
+            UserDBCalls.update_user_profile_model(db_session, user.id, {"grid_ids": ["grid.profile.1"]})
+
+        result = User.process_users_list([{"id": user.id}])
+
+        self.assertEqual(len(result), 1)
+        self.assertEqual(result[0]["affiliations"], [])
+
 
