+    @classmethod
+    def _drop_legacy_itbm_keys(cls, form_data, article_id=None, account_id=None):
+        """Drop legacy keys that have no meaning for ITBM items.
+
+        ITBM items keep their authors only in the authors underlying field (`fields`), never in the legacy
+        `authors` column / article_user table. Legacy payloads (API v2, the ORCID import task, ...) still send a
+        top-level `authors` list ({"name": ...} / {"id": ...} entries, without `user_id`); left in, it reaches the
+        legacy author writes in `ArticleInternals` and fails there (FIG-47778). Translating these payloads into
+        ITBM fields is tracked in FIG-47813.
+        """
+        if form_data.pop("authors", None) is not None:
+            # logged (ids only, no author names) so FIG-47813 can measure how many legacy callers still send it
+            FigcoreLogger.info(
+                f"Ignoring legacy `authors` key for ITBM item (account {account_id or form_data.get('account_id')}, "
+                f"article {article_id})"
+            )
+
