@@ -202,6 +202,36 @@ class TestCreateItbmAuthors(ItbmAuthorsTestBase):
         with self.assertRaises(fig_exc.InvalidFormat):
             Article.create_itbm_article(self.data)
 
+    def test_legacy_authors_key_ignored(self):
+        # API v2 legacy payloads send a top-level `authors` list ({"name": ...} / {"id": ...} entries, no user_id);
+        # ITBM items read their authors only from the authors underlying field, so that key must not reach the
+        # legacy article_user writes (it used to raise KeyError: 'user_id' -> HTTP 500, FIG-47778)
+        for legacy_authors in ([{"name": "John Doe M001"}], [{"id": self.owner.id}]):
+            for owner_is_author in (True, False):
+                with self.subTest(legacy_authors=legacy_authors, owner_is_author=owner_is_author):
+                    data = dict(self.data, authors=legacy_authors)
+                    article = Article.find(Article.create_itbm_article(data, owner_is_author=owner_is_author).id)
+
+                    expected_names = ["Jane Doe", "John Doe"]
+                    if owner_is_author:
+                        expected_names.insert(0, self.owner.name)
+                    self.assertEqual(self.names(article), expected_names)
+                    self.assertEqual(article.authors, [])
+                    self.assertFalse(article.metadata.authors)
+
+    def test_legacy_authors_key_ignored_through_project_actions(self):
+        # the route from the bug report: POST /v2/account/projects/{id}/articles -> ProjectActions.create_article
+        project = Project.create_project({"account_id": 1, "institution_id": 1, "group_id": 1, "title": "project"})
+        data = dict(self.data, authors=[{"name": "John Doe M001"}])
+        del data["account_id"], data["institution_id"], data["group_id"]
+
+        article = Account.find(1).actions_for(project).create_article(data)
+
+        article = Article.find(article.id)
+        self.assertEqual(article.project_id, project.id)
+        self.assertEqual(self.names(article), [self.owner.name, "Jane Doe", "John Doe"])
+        self.assertEqual(article.authors, [])
+
 
