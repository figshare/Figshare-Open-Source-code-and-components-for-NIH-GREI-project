diff --git a/tests/api/user/test_update_public_profile.py b/tests/api/user/test_update_public_profile.py
index a852c2b31..37d99a133 100644
--- a/tests/api/user/test_update_public_profile.py
+++ b/tests/api/user/test_update_public_profile.py
@@ -444,3 +444,28 @@ class TestUpdatePublicProfile(BaseTestTransactioned):
             self.admin_account.actions_for(self.inst_user).update_public_profile({"last_name": "aaaaa"})
 
         self.admin_account.actions_for(self.inst_user).update_public_profile({"first_name": "", "last_name": "a" * 255})
+
+    def test_affiliations_max_limit(self):
+        # Exactly 100 affiliations should be accepted
+        affiliations_100 = [{"ror_id": f"ror-{i}", "name": f"Org {i}", "url": ""} for i in range(100)]
+        self.figsh_account.actions_for(self.figsh_user).update_public_profile({"affiliations": affiliations_100})
+        self.assertEqual(len(self.figsh_user.affiliations), 100)
+
+        # 101 affiliations should be rejected
+        affiliations_101 = [{"ror_id": f"ror-{i}", "name": f"Org {i}", "url": ""} for i in range(101)]
+        with self.assertRaises(fig_exc.InvalidValue):
+            self.figsh_account.actions_for(self.figsh_user).update_public_profile({"affiliations": affiliations_101})
+
+    def test_affiliations_not_a_list(self):
+        with self.assertRaises(fig_exc.InvalidValue):
+            self.figsh_account.actions_for(self.figsh_user).update_public_profile({"affiliations": "not a list"})
+
+    def test_affiliations_falsy_non_list_rejected(self):
+        # Falsy non-list values should still be rejected, not silently skipped
+        for invalid_value in ["", 0, {}, False]:
+            with self.assertRaises(fig_exc.InvalidValue, msg=f"Expected InvalidValue for {invalid_value!r}"):
+                self.figsh_account.actions_for(self.figsh_user).update_public_profile({"affiliations": invalid_value})
+
+    def test_affiliations_empty_list_accepted(self):
+        # An empty list is a valid value (user clearing all affiliations)
+        self.figsh_account.actions_for(self.figsh_user).update_public_profile({"affiliations": []})
