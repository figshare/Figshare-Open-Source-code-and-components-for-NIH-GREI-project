index aadd160d1..7232e2f6f 100644
--- a/src/figcore/graphql/interceptors/user.py
+++ b/src/figcore/graphql/interceptors/user.py
@@ -50,6 +50,17 @@ def publications(obj, info, offset, limit):
     return {"elements": elements_with_defaults, "has_more": has_more}
 
 
+def ror_ids(obj, info):
+    # a list of objects stored in a JSON column is not resolved by the generic db layer (like
+    # `publications`): read the decoded column and give every entry all the RorAffiliation keys
+    ror_ids = obj["_raw_db"]["user_profile.ror_ids"] or []
+    if not isinstance(ror_ids, list):
+        return []
+
+    default = {"ror_id": None, "name": None, "url": None, "order": None}
+    return [{**default, **ror_id} for ror_id in ror_ids if isinstance(ror_id, dict)]
+
+
 def hide_email(obj, info=None):
     if obj:
         name, domain = obj.split("@")
