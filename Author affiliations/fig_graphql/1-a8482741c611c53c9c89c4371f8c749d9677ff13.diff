+from typing import Dict
+from elasticsearch_dsl import Search, Q
+
+from figcore.lib.es8.client import elasticsearch_client
+
+# Only return active organizations (matching InstitutionStatic.ROR_STATUS_MAP)
+ROR_STATUS_ACTIVE = 1
+ROR_URL_PREFIX = "https://ror.org/"
+
+
+def search_ror_organizations(
+    obj,
+    info,
+    search_term: str,
+    page_size: int = 10,
+    cursor: str = None,
+) -> Dict[str, any]:
+    """Search ROR organizations for affiliation autocomplete.
+
+    Matches on org name (search-as-you-type), exact ror_id, and parent_ror_id
+    so a ROR ID returns both the org and its children.
+    Accepts full ROR URLs (https://ror.org/...) or stripped IDs.
+    """
+    index = "ror"
+
+    # Strip ROR URL prefix if user pastes a full URL
+    stripped_term = search_term.replace(ROR_URL_PREFIX, "") if search_term.startswith(ROR_URL_PREFIX) else search_term
+
+    search = Search()
+    search = search.filter("term", status=ROR_STATUS_ACTIVE)
+    search = search.query(
+        Q(
+            "bool",
+            should=[
+                Q(
+                    "multi_match",
+                    query=stripped_term,
+                    fields=["name.search", "name.search._2gram", "name.search._3gram"],
+                    type="bool_prefix",
+                    operator="and",
+                ),
+                Q("term", ror_id=stripped_term),
+                Q("term", parent_ror_id=stripped_term),
+            ],
+            minimum_should_match=1,
+        )
+    )
+
+    sort = [{"by": "_score", "type": "desc"}]
+    result = elasticsearch_client.execute(
+        index=index, search=search, page_size=page_size, cursor=cursor, sort=sort, cursor_sorting="ror_id"
+    )
+
+    organizations = []
+    for hit in result["hits"]:
+        org = hit["_source"]
+        organizations.append(
+            {
+                "ror_id": org["ror_id"],
+                "name": org["name"],
+            }
+        )
+
+    return {"cursor": result.get("cursor"), "count": result.get("total"), "elements": organizations}
