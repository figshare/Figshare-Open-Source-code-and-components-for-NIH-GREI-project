@@ -0,0 +1,13 @@
+import json
+
+
+def resolve_affiliations(obj, info):
+    """Resolve ror_ids from the raw DB JSON blob into a list of affiliation dicts."""
+    raw = obj.get("_raw_db", {}).get("user_profile.ror_ids", "[]")
+    if not raw or raw == "[]" or raw == "{}":
+        return []
+    if isinstance(raw, (bytes, bytearray)):
+        raw = raw.decode("utf-8")
+    if isinstance(raw, str):
+        raw = json.loads(raw)
+    return raw
