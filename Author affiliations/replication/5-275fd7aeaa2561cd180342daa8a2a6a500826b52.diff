+def get_itbm_authors(database, authors_raw, is_item=False):
+    """Build ES author objects by merging DB user data with inline .fields overrides.
+
+    Delegates to get_authors() for the DB query and affiliation handling, then
+    overlays any fields present in each .fields entry — those take priority
+    (e.g. a curator-edited first_name overrides the account name).
+
+    Args:
+        database: DB connection object.
+        authors_raw: List of person_list entry dicts from the fields blob.
+            Each entry has: type (1=person, 2=org), user_id, affiliations [{ror_id, name}],
+            and optionally first_name, last_name, orcid_id, name (overrides).
+        is_item: If True, include first_name/last_name in author objects (items only).
+
+    Returns:
+        Tuple (authors, affiliations) matching the shape of get_authors():
+          - authors: list of ES author dicts
+          - affiliations: deduplicated top-level affiliation dicts [{id, title}]
+    """
+    if not authors_raw:
+        return [], []
+
+    # get_authors expects a JSON string of [{user_id, affiliations}, ...].
+    # The .fields entries already carry that shape, so we pass them through directly.
+    authors, affiliations = get_authors(database, json.dumps(authors_raw), is_item=is_item)
+
+    # Build a lookup keyed by user_id so we can match DB authors to .fields entries.
+    author_by_user_id = {a["user_id"]: a for a in authors}
+
+    # Override DB values with .fields values where present.
+    for entry in authors_raw:
+        user_id = entry.get("user_id") or 0
+        author_es = author_by_user_id.get(user_id)
+        if not author_es:
+            continue
+
+        is_org = entry.get("type") == PERSON_TYPE_ORGANIZATIONAL
+
+        if is_org:
+            # Organizational author: name is stored directly; no first/last or orcid.
+            if entry.get("name"):
+                author_es["name"] = entry["name"]
+            author_es["orcid_id"] = ""
+            if is_item:
+                author_es["first_name"] = ""
+                author_es["last_name"] = ""
+        else:
+            # Personal author: overlay .fields values where present.
+            # Stored entries only include keys that differ from the user profile:
+            #   - key present with a value → override to this value
+            #   - key present with None → explicitly cleared on this item
+            #   - key absent → keep the DB/profile value
+            has_first = "first_name" in entry
+            has_last = "last_name" in entry
+            first_name = (entry["first_name"] or "") if has_first else ""
+            last_name = (entry["last_name"] or "") if has_last else ""
+            if has_first or has_last:
+                if is_item:
+                    if has_first:
+                        author_es["first_name"] = first_name
+                    if has_last:
+                        author_es["last_name"] = last_name
+                # Recompose name from the final first/last (DB base + .fields overrides).
+                final_first = author_es.get("first_name", "") if is_item else first_name
+                final_last = author_es.get("last_name", "") if is_item else last_name
+                author_es["name"] = f"{final_first} {final_last}".strip() or author_es["name"]
+            if "orcid_id" in entry:
+                author_es["orcid_id"] = entry["orcid_id"] or ""
+
+    return authors, affiliations
+
