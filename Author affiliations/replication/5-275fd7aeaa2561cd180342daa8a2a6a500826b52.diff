+"""Unit tests for get_authors affiliation handling."""
+
+import json
+
+from mock import MagicMock
+from replication.indexers.common.common import get_authors
+from replication.indexers.lib.db_api import DbApi
+
+AUTHOR_DB_RESULT = {
+    "user.id": 1000015,
+    "user.url_name": "John_Doe",
+    "user.name": "John Doe",
+    "user.is_active": 1,
+    "user.is_public": 1,
+    "user.first_name": "John",
+    "user.last_name": "Doe",
+    "user_account.account_id": 123456,
+    "user_profile.orcid_id": "0000-0000-0000-1234",
+}
+
+
+def _mock_db(mocker, authors_json):
+    """Set up DB mock and call get_authors."""
+    mocker.patch.object(DbApi, "get_multiple", return_value=[AUTHOR_DB_RESULT])
+    return get_authors("core", authors_json, is_item=True)
+
+
+def test_legacy_affiliations_with_name_are_indexed(mocker):
+    """legacy_affiliations with ror_id and name should appear in both per-author and top-level."""
+    authors_json = json.dumps(
+        [
+            {
+                "user_id": 1000015,
+                "affiliations": [],
+                "legacy_affiliations": [{"ror_id": "03yrm5c26", "name": "University of Cambridge"}],
+            }
+        ]
+    )
+
+    authors, affiliations = _mock_db(mocker, authors_json)
+
+    assert authors[0]["affiliations"] == ["03yrm5c26"]
+    assert affiliations == [{"id": "03yrm5c26", "title": "University of Cambridge"}]
+
+
+def test_legacy_affiliations_without_name_indexed_per_author_only(mocker):
+    """legacy_affiliations with ror_id but no name: per-author yes, top-level no."""
+    authors_json = json.dumps(
+        [
+            {
+                "user_id": 1000015,
+                "affiliations": [],
+                "legacy_affiliations": [{"ror_id": "04test00", "name": ""}],
+            }
+        ]
+    )
+
+    authors, affiliations = _mock_db(mocker, authors_json)
+
+    # Per-author should have the ror_id
+    assert authors[0]["affiliations"] == ["04test00"]
+    # Top-level should be empty (no name)
+    assert affiliations == []
+
+
+def test_affiliations_and_legacy_combined(mocker):
+    """Both affiliations and legacy_affiliations should be combined."""
+    authors_json = json.dumps(
+        [
+            {
+                "user_id": 1000015,
+                "affiliations": [{"ror_id": "01abc1234", "name": "Harvard University"}],
+                "legacy_affiliations": [{"ror_id": "03yrm5c26", "name": "University of Cambridge"}],
+            }
+        ]
+    )
+
+    authors, affiliations = _mock_db(mocker, authors_json)
+
+    assert sorted(authors[0]["affiliations"]) == ["01abc1234", "03yrm5c26"]
+    assert len(affiliations) == 2
+    aff_ids = {a["id"] for a in affiliations}
+    assert aff_ids == {"01abc1234", "03yrm5c26"}
+
+
+def test_legacy_string_format(mocker):
+    """Legacy affiliations as plain strings (old format) should still work."""
+    authors_json = json.dumps(
+        [
+            {
+                "user_id": 1000015,
+                "affiliations": [],
+                "legacy_affiliations": ["03yrm5c26"],
+            }
+        ]
+    )
+
+    authors, affiliations = _mock_db(mocker, authors_json)
+
+    # Per-author gets the string ror_id
+    assert authors[0]["affiliations"] == ["03yrm5c26"]
+    # Top-level: string format has no name, skipped
+    assert affiliations == []
+
+
+def test_empty_affiliations(mocker):
+    """Both empty affiliations and no legacy should produce empty results."""
+    authors_json = json.dumps(
+        [
+            {
+                "user_id": 1000015,
+                "affiliations": [],
+            }
+        ]
+    )
+
+    authors, affiliations = _mock_db(mocker, authors_json)
+
+    assert authors[0]["affiliations"] == []
+    assert affiliations == []
+
+
+def test_skip_affiliations(mocker):
+    """When skip_affiliations=True, no affiliations should be set."""
+    authors_json = json.dumps(
+        [
+            {
+                "user_id": 1000015,
+                "affiliations": [{"ror_id": "03yrm5c26", "name": "Uni"}],
+            }
+        ]
+    )
+
+    mocker.patch.object(DbApi, "get_multiple", return_value=[AUTHOR_DB_RESULT])
+    authors, affiliations = get_authors("core", authors_json, skip_affiliations=True, is_item=True)
+
+    assert "affiliations" not in authors[0]
+    assert affiliations == []
+
+
+def test_deduplication(mocker):
+    """Same ror_id from two authors should appear once at top-level."""
+    authors_json = json.dumps(
+        [
+            {"user_id": 1000015, "affiliations": [{"ror_id": "03yrm5c26", "name": "Uni"}]},
+            {"user_id": 1000015, "affiliations": [{"ror_id": "03yrm5c26", "name": "Uni"}]},
+        ]
+    )
+
+    mocker.patch.object(DbApi, "get_multiple", return_value=[AUTHOR_DB_RESULT, AUTHOR_DB_RESULT])
+    authors, affiliations = get_authors("core", authors_json, is_item=True)
+
+    # Both authors get the ror_id
+    assert authors[0]["affiliations"] == ["03yrm5c26"]
+    assert authors[1]["affiliations"] == ["03yrm5c26"]
+    # Top-level is deduplicated
+    assert len(affiliations) == 1
+    assert affiliations[0] == {"id": "03yrm5c26", "title": "Uni"}
