+"""Unit tests for get_itbm_authors — DB-first with .fields overrides."""
+
+import json
+
+from replication.indexers.common import itbm_helpers as itbm_helpers_module
+from replication.indexers.common.itbm_helpers import get_itbm_authors
+
+
+# Simulated get_authors return for a linked person (DB-sourced).
+def _db_author(
+    user_id=1000015,
+    name="John Doe",
+    orcid_id="0000-0000-0000-9999",
+    account_id=123456,
+    is_active=1,
+    is_public=1,
+    url_name="John_Doe",
+    affiliations=None,
+    is_item=False,
+    first_name="John",
+    last_name="Doe",
+):
+    """Build a DB-sourced ES author dict as get_authors would return.
+
+    When is_item=True, includes first_name/last_name (matching get_authors behaviour).
+    """
+    author = {
+        "user_id": user_id,
+        "account_id": account_id,
+        "is_active": is_active,
+        "is_public": is_public,
+        "url_name": url_name,
+        "name": name,
+        "orcid_id": orcid_id,
+        "affiliations": affiliations or [],
+    }
+    if is_item:
+        author["first_name"] = first_name
+        author["last_name"] = last_name
+    return author
+
+
+def _person_entry(
+    user_id=1000015,
+    first_name="John",
+    last_name="Doe",
+    orcid_id="0000-0000-0000-1234",
+    affiliations=None,
+):
+    """Build a personal (type=1) person_list entry dict from .fields."""
+    return {
+        "type": 1,
+        "user_id": user_id,
+        "first_name": first_name,
+        "last_name": last_name,
+        "email": "test@example.com",
+        "orcid_id": orcid_id,
+        "is_corresponding": False,
+        "affiliations": affiliations or [],
+    }
+
+
+def _org_entry(user_id=1000020, name="ACME Corp", contributors="", affiliations=None):
+    """Build an organizational (type=2) person_list entry dict from .fields."""
+    return {
+        "type": 2,
+        "user_id": user_id,
+        "name": name,
+        "contributors": contributors,
+        "is_corresponding": False,
+        "affiliations": affiliations or [],
+    }
+
+
+def _mock_get_authors(mocker, authors_return, affiliations_return=None):
+    """Patch get_authors to return the given (authors, affiliations) tuple."""
+    return mocker.patch.object(
+        itbm_helpers_module,
+        "get_authors",
+        return_value=(authors_return, affiliations_return or []),
+    )
+
+
+# ── Override logic ────────────────────────────────────────────────────
+
+
+def test_fields_override_name_over_db(mocker):
+    """When .fields has first_name/last_name, they override the DB name."""
+    db_author = _db_author(is_item=True, first_name="John", last_name="Doe", name="John Doe")
+    _mock_get_authors(mocker, [db_author])
+
+    # .fields entry has a different name than DB.
+    entries = [_person_entry(first_name="Jonathan", last_name="Doe")]
+    authors, _ = get_itbm_authors("core", entries, is_item=True)
+
+    assert authors[0]["name"] == "Jonathan Doe"
+    assert authors[0]["first_name"] == "Jonathan"
+    # last_name unchanged — same in both .fields and DB.
+    assert authors[0]["last_name"] == "Doe"
+
+
+def test_fields_override_orcid_over_db(mocker):
+    """When .fields has orcid_id, it overrides the DB orcid."""
+    db_author = _db_author(orcid_id="0000-0000-0000-9999")
+    _mock_get_authors(mocker, [db_author])
+
+    entries = [_person_entry(orcid_id="0000-0000-0000-1234")]
+    authors, _ = get_itbm_authors("core", entries, is_item=True)
+
+    assert authors[0]["orcid_id"] == "0000-0000-0000-1234"
+
+
+def test_db_values_kept_when_fields_absent(mocker):
+    """When .fields entry has no override keys, DB values are preserved."""
+    db_author = _db_author(
+        name="John Doe",
+        orcid_id="0000-0000-0000-9999",
+        first_name="John",
+        last_name="Doe",
+        is_item=True,
+    )
+    _mock_get_authors(mocker, [db_author])
+
+    # .fields entry without override keys — DB values should remain.
+    entries = [_person_entry()]
+    for key in ("first_name", "last_name", "orcid_id"):
+        del entries[0][key]
+    authors, _ = get_itbm_authors("core", entries, is_item=True)
+
+    assert authors[0]["name"] == "John Doe"
+    assert authors[0]["first_name"] == "John"
+    assert authors[0]["last_name"] == "Doe"
+    assert authors[0]["orcid_id"] == "0000-0000-0000-9999"
+
+
+def test_explicitly_cleared_fields_override_db(mocker):
+    """When .fields has None/empty for a key, it clears the DB value.
+
+    Stored entries use None to mean "cleared on this item" and absent key
+    to mean "keep the profile value".
+    """
+    db_author = _db_author(
+        orcid_id="0000-0000-0000-9999",
+        first_name="John",
+        last_name="Doe",
+        name="John Doe",
+        is_item=True,
+    )
+    _mock_get_authors(mocker, [db_author])
+
+    # All override keys present but cleared.
+    entries = [_person_entry(first_name=None, last_name=None, orcid_id="")]
+    authors, _ = get_itbm_authors("core", entries, is_item=True)
+
+    assert authors[0]["orcid_id"] == ""
+    assert authors[0]["first_name"] == ""
+    assert authors[0]["last_name"] == ""
+    # Name falls back to DB when cleared first/last produce an empty string.
+    assert authors[0]["name"] == "John Doe"
+
+
+# ── Organization authors ─────────────────────────────────────────────
+
+
+def test_org_overrides_name_clears_orcid(mocker):
+    """Org entry: name from .fields, orcid forced to empty."""
+    # Ghost user in DB has a name and orcid from account creation.
+    db_author = _db_author(user_id=1000020, name="Ghost User", orcid_id="0000-1111-2222-3333")
+    _mock_get_authors(mocker, [db_author])
+
+    entries = [_org_entry(user_id=1000020, name="ACME Corp")]
+    authors, _ = get_itbm_authors("core", entries, is_item=False)
+
+    assert authors[0]["name"] == "ACME Corp"
+    assert authors[0]["orcid_id"] == ""
+
+
+def test_org_clears_first_last_name_for_items(mocker):
+    """Org entry with is_item=True: first/last name forced to empty strings."""
+    db_author = _db_author(user_id=1000020, is_item=True, first_name="Ghost", last_name="User")
+    _mock_get_authors(mocker, [db_author])
+
+    entries = [_org_entry(user_id=1000020)]
+    authors, _ = get_itbm_authors("core", entries, is_item=True)
+
+    assert authors[0]["first_name"] == ""
+    assert authors[0]["last_name"] == ""
+
+
+# ── Collections vs items ─────────────────────────────────────────────
+
+
+def test_collections_exclude_first_last_name(mocker):
+    """Collections (is_item=False) should not include first_name/last_name."""
+    db_author = _db_author()
+    _mock_get_authors(mocker, [db_author])
+
+    entries = [_person_entry()]
+    authors, _ = get_itbm_authors("core", entries, is_item=False)
+
+    # get_authors with is_item=False doesn't add first_name/last_name.
+    # The override logic shouldn't add them either.
+    assert "first_name" not in authors[0]
+    assert "last_name" not in authors[0]
+
+
+def test_items_include_first_last_name_from_fields(mocker):
+    """Items (is_item=True): first_name/last_name come from .fields override."""
+    db_author = _db_author(is_item=True, first_name="John", last_name="Doe")
+    _mock_get_authors(mocker, [db_author])
+
+    entries = [_person_entry(first_name="Jonathan", last_name="Doe")]
+    authors, _ = get_itbm_authors("core", entries, is_item=True)
+
+    assert authors[0]["first_name"] == "Jonathan"
+    assert authors[0]["last_name"] == "Doe"
+
+
+# ── Affiliations ─────────────────────────────────────────────────────
+
+
+def test_affiliations_passed_through_from_get_authors(mocker):
+    """Affiliations are handled entirely by get_authors — verify pass-through."""
+    db_author = _db_author(affiliations=["03yrm5c26", "01abc1234"])
+    top_level = [
+        {"id": "03yrm5c26", "title": "University of Cambridge"},
+        {"id": "01abc1234", "title": "Harvard University"},
+    ]
+    _mock_get_authors(mocker, [db_author], top_level)
+
+    entries = [
+        _person_entry(
+            affiliations=[
+                {"ror_id": "03yrm5c26", "name": "University of Cambridge"},
+                {"ror_id": "01abc1234", "name": "Harvard University"},
+            ]
+        )
+    ]
+    authors, affiliations = get_itbm_authors("core", entries, is_item=True)
+
+    assert sorted(authors[0]["affiliations"]) == ["01abc1234", "03yrm5c26"]
+    assert len(affiliations) == 2
+
+
+# ── get_authors is called correctly ──────────────────────────────────
+
+
+def test_get_authors_called_with_json_and_is_item(mocker):
+    """get_itbm_authors passes the raw entries as JSON to get_authors."""
+    mock = _mock_get_authors(mocker, [_db_author()])
+
+    entries = [_person_entry()]
+    get_itbm_authors("core", entries, is_item=True)
+
+    mock.assert_called_once()
+    call_args = mock.call_args
+    assert call_args[0][0] == "core"
+    # Second arg is JSON-encoded entries.
+    assert json.loads(call_args[0][1]) == entries
+    assert call_args[1]["is_item"] is True
+
+
+# ── Edge cases ───────────────────────────────────────────────────────
+
+
+def test_empty_authors_list(mocker):
+    """Empty input returns empty output without calling get_authors."""
+    mock = _mock_get_authors(mocker, [])
+
+    authors, affiliations = get_itbm_authors("core", [], is_item=True)
+
+    assert authors == []
+    assert affiliations == []
+    mock.assert_not_called()
+
+
+def test_none_authors_list(mocker):
+    """None input returns empty output."""
+    mock = _mock_get_authors(mocker, [])
+
+    authors, affiliations = get_itbm_authors("core", None, is_item=True)
+
+    assert authors == []
+    assert affiliations == []
+    mock.assert_not_called()
+
+
+def test_mixed_person_and_org_authors(mocker):
+    """Person and org entries in same call both get overrides applied."""
+    person_db = _db_author(user_id=1000015, is_item=True, name="John Doe", orcid_id="0000-0000-0000-9999")
+    org_db = _db_author(user_id=1000020, is_item=True, name="Ghost User", orcid_id="0000-1111-2222-3333")
+    _mock_get_authors(mocker, [person_db, org_db])
+
+    entries = [
+        _person_entry(user_id=1000015, first_name="Jonathan", last_name="Doe", orcid_id="0000-0000-0000-1234"),
+        _org_entry(user_id=1000020, name="ACME Corp"),
+    ]
+    authors, _ = get_itbm_authors("core", entries, is_item=True)
+
+    # Person gets .fields overrides.
+    assert authors[0]["name"] == "Jonathan Doe"
+    assert authors[0]["orcid_id"] == "0000-0000-0000-1234"
+    # Org gets name override and cleared orcid.
+    assert authors[1]["name"] == "ACME Corp"
+    assert authors[1]["orcid_id"] == ""
+
+
+def test_only_partial_name_override(mocker):
+    """When only first_name is in .fields, last_name stays from DB."""
+    db_author = _db_author(is_item=True, name="John Doe", first_name="John", last_name="Doe")
+    _mock_get_authors(mocker, [db_author])
+
+    # Only first_name is overridden; last_name key is absent (no override).
+    entries = [_person_entry(first_name="Jonathan")]
+    del entries[0]["last_name"]
+    authors, _ = get_itbm_authors("core", entries, is_item=True)
+
+    assert authors[0]["first_name"] == "Jonathan"
+    # last_name stays from DB since .fields doesn't override it.
+    assert authors[0]["last_name"] == "Doe"
+    # name recomposed from final first (overridden) + final last (DB).
+    assert authors[0]["name"] == "Jonathan Doe"
