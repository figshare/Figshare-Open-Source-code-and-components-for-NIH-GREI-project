+    @classmethod
+    def get_item_affiliations(cls, project_id):
+        """Collect deduplicated affiliations from all published items in the project.
+
+        For each item, affiliations are extracted from the authors' inline data:
+        - ITBM items: authors are in article_metadata_version.fields blob
+        - Legacy items: authors are in article_metadata_version.authors column
+
+        Returns a list of {"id": ror_id, "title": name} dicts.
+        """
+        db_fields = ["article_metadata_version.authors", "article_metadata_version.fields"]
+        rows = get_multiple_by_id(cls.DATABASE, project_id, PROJECT_ITEMS_AUTHORS_QUERY, db_fields)
+
+        affiliations = []
+        seen_ror_ids = set()
+
+        for row in rows:
+            item_authors = cls._extract_authors_from_item(row)
+            for author in item_authors:
+                # Legacy items can store authors as plain IDs (e.g. [1000015]) — skip non-dict entries.
+                if not isinstance(author, dict):
+                    continue
+                # Combine affiliations and legacy_affiliations (from GRID migration),
+                # mirroring the logic in common.get_authors for items.
+                affs = list(author.get("affiliations") or []) + list(author.get("legacy_affiliations") or [])
+                for aff in affs:
+                    if isinstance(aff, dict):
+                        ror_id = aff.get("ror_id", "")
+                        name = aff.get("name", "")
+                    elif isinstance(aff, str):
+                        # Legacy string format — no name available, skip.
+                        continue
+                    else:
+                        continue
+                    if ror_id and name and ror_id not in seen_ror_ids:
+                        seen_ror_ids.add(ror_id)
+                        affiliations.append({"id": ror_id, "title": name})
+
+        return affiliations
+
+    @staticmethod
+    def _extract_authors_from_item(row):
+        """Extract the authors list from an item's DB row.
+
+        Tries the ITBM fields blob first (richer data), then falls back to
+        the legacy authors column.
+        """
+        # ITBM path: authors are inside the fields blob as a person_list entry.
+        fields_raw = row.get("article_metadata_version.fields")
+        if fields_raw:
+            try:
+                fields_blob = json.loads(fields_raw) if isinstance(fields_raw, str) else fields_raw
+                for field_data in fields_blob.values():
+                    if field_data.get("field_name") == "authors" and isinstance(field_data.get("value"), list):
+                        return field_data["value"]
+            except (json.JSONDecodeError, AttributeError):
+                pass
+
+        # Legacy path: authors column with [{user_id, affiliations}, ...].
+        authors_raw = row.get("article_metadata_version.authors")
+        if authors_raw:
+            try:
+                if isinstance(authors_raw, (bytes, bytearray)):
+                    authors_raw = authors_raw.decode("utf-8")
+                authors = json.loads(authors_raw) if isinstance(authors_raw, str) else authors_raw
+                if isinstance(authors, list):
+                    return authors
+            except (json.JSONDecodeError, AttributeError):
+                pass
+
+        return []
+
