+# ---------------------------------------------------------------------------
+# get_item_affiliations / _extract_authors_from_item unit tests
+# ---------------------------------------------------------------------------
+
+
+def test_extract_authors_from_item_itbm_fields_blob():
+    """ITBM items: authors are inside the fields blob as a person_list entry."""
+    fields_blob = json.dumps(
+        {
+            "1": {"field_name": "title", "field_type": "text", "internal_type": "core", "value": "Test Item"},
+            "3": {
+                "field_name": "authors",
+                "field_type": "person_list",
+                "internal_type": "core",
+                "value": [
+                    {"name": "Alice", "affiliations": [{"ror_id": "abc123", "name": "Uni A"}]},
+                    {"name": "Bob", "affiliations": []},
+                ],
+            },
+        }
+    )
+    row = {"article_metadata_version.fields": fields_blob, "article_metadata_version.authors": None}
+    result = Project._extract_authors_from_item(row)
+    assert len(result) == 2
+    assert result[0]["name"] == "Alice"
+    assert result[0]["affiliations"] == [{"ror_id": "abc123", "name": "Uni A"}]
+
+
+def test_extract_authors_from_item_legacy_authors_column():
+    """Legacy items: authors are in the authors column as a JSON list."""
+    authors_json = json.dumps(
+        [
+            {"user_id": 100, "affiliations": [{"ror_id": "xyz789", "name": "Uni X"}], "legacy_affiliations": []},
+        ]
+    )
+    row = {"article_metadata_version.fields": None, "article_metadata_version.authors": authors_json}
+    result = Project._extract_authors_from_item(row)
+    assert len(result) == 1
+    assert result[0]["affiliations"] == [{"ror_id": "xyz789", "name": "Uni X"}]
+
+
+def test_extract_authors_from_item_empty_row():
+    """Both fields and authors are empty — returns empty list."""
+    row = {"article_metadata_version.fields": None, "article_metadata_version.authors": None}
+    assert Project._extract_authors_from_item(row) == []
+
+
+def test_extract_authors_from_item_empty_itbm_authors_is_authoritative():
+    """An empty ITBM authors list is authoritative — legacy authors column must NOT be used as fallback."""
+    fields_blob = json.dumps(
+        {
+            "3": {
+                "field_name": "authors",
+                "field_type": "person_list",
+                "internal_type": "core",
+                "value": [],
+            }
+        }
+    )
+    # Legacy column has authors, but the ITBM blob says empty — ITBM wins.
+    legacy_authors = json.dumps([{"user_id": 100, "affiliations": [{"ror_id": "xyz", "name": "Uni"}]}])
+    row = {"article_metadata_version.fields": fields_blob, "article_metadata_version.authors": legacy_authors}
+    assert Project._extract_authors_from_item(row) == []
+
+
+def test_get_item_affiliations_deduplicates_and_includes_legacy(mocker):
+    """get_item_affiliations deduplicates by ror_id and includes legacy_affiliations."""
+    # Two items: one ITBM with an affiliation, one legacy with the same + a legacy_affiliations entry.
+    itbm_row = {
+        "article_metadata_version.fields": json.dumps(
+            {
+                "3": {
+                    "field_name": "authors",
+                    "field_type": "person_list",
+                    "internal_type": "core",
+                    "value": [{"name": "Alice", "affiliations": [{"ror_id": "aaa111", "name": "Uni A"}]}],
+                }
+            }
+        ),
+        "article_metadata_version.authors": None,
+    }
+    legacy_row = {
+        "article_metadata_version.fields": None,
+        "article_metadata_version.authors": json.dumps(
+            [
+                {
+                    "user_id": 200,
+                    "affiliations": [{"ror_id": "aaa111", "name": "Uni A"}],  # duplicate
+                    "legacy_affiliations": [{"ror_id": "bbb222", "name": "Uni B"}],
+                }
+            ]
+        ),
+    }
+    mocker.patch(
+        "replication.indexers.project.project.get_multiple_by_id",
+        return_value=[itbm_row, legacy_row],
+    )
+    result = Project.get_item_affiliations(1234)
+
+    # aaa111 appears in both items — deduplicated to one entry. bbb222 from legacy_affiliations included.
+    assert len(result) == 2
+    ror_ids = {a["id"] for a in result}
+    assert ror_ids == {"aaa111", "bbb222"}
+
+
+def test_get_item_affiliations_skips_id_only_authors(mocker):
