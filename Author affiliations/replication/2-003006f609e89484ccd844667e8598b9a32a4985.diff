diff --git a/scripts/migrations/2026-11.sh b/scripts/migrations/2026-11.sh
new file mode 100755
index 0000000..2a42038
--- /dev/null
+++ b/scripts/migrations/2026-11.sh
@@ -0,0 +1,42 @@
+#!/bin/bash
+# Add affiliations mapping to the user index.
+#
+# The user indexer now writes affiliations (parsed from user_profile.affiliations blob).
+# The mapping is dynamic: strict, so it must be patched BEFORE the updated indexers
+# are deployed. New indices created from the updated schema already include the field.
+#
+# Existing documents will have no value until they are reindexed (scripts/reindex.py).
+#
+# Usage:
+#   ES_URL=http://localhost:9200 bash scripts/migrations/2026-11.sh
+
+ES_URL="${ES_URL:=http://localhost:9200}"
+
+AFFILIATIONS_MAPPING='{
+  "properties": {
+    "affiliations": {
+      "dynamic": "strict",
+      "properties": {
+        "name": {"type": "text"},
+        "ror_id": {"type": "keyword", "normalizer": "fig_keyword"},
+        "url": {"type": "keyword", "normalizer": "fig_keyword"},
+        "order": {"type": "integer"}
+      }
+    }
+  }
+}'
+
+echo "Updating mapping for user index..."
+HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" -XPUT "${ES_URL}/user/_mapping" \
+  --header 'Content-Type: application/json' \
+  --data-raw "${AFFILIATIONS_MAPPING}")
+if [ "$HTTP_CODE" = "200" ]; then
+  echo "  Success."
+elif [ "$HTTP_CODE" = "404" ]; then
+  echo "  user index not found — skipping."
+else
+  echo "  Failed to update user index (HTTP ${HTTP_CODE})" && exit 1
+fi
+
+echo ""
+echo "Migration complete."
