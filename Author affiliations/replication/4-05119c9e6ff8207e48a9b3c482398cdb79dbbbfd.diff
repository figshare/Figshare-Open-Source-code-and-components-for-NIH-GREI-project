diff --git a/tests/replication/user/test_get_last_work.py b/tests/replication/user/test_get_last_work.py
new file mode 100644
index 0000000..ba149d7
--- /dev/null
+++ b/tests/replication/user/test_get_last_work.py
@@ -0,0 +1,42 @@
+import json
+
+import pytest
+from replication.indexers.lib.es_api import EsApi
+from replication.indexers.user.user import User
+from tests.replication.user.data import (
+    LAST_WORK_ES_RESPONSE,
+    LAST_WORK_EXPECTED,
+    LAST_WORK_ES_EMPTY_RESPONSE,
+)
+
+
+def test_get_last_work_with_published_item(mocker):
+    """Returns title and published_date when the user has published items."""
+    mocker.patch.object(EsApi, "_make_es_request", return_value=json.dumps(LAST_WORK_ES_RESPONSE))
+
+    result = User._get_last_work(user_id=42)
+
+    assert result == LAST_WORK_EXPECTED
+    # Verify the ES query targets the correct indices and searches by user_id
+    EsApi._make_es_request.assert_called_once()
+    call_args = EsApi._make_es_request.call_args
+    assert "public_item_0,public_item_itbm_0" in call_args[0][0]
+    assert "ignore_unavailable=true" in call_args[0][0]
+    assert call_args[1]["data"]["query"]["term"]["authors.user_id"] == 42
+
+
+def test_get_last_work_no_published_items(mocker):
+    """Returns empty dict when the user has no published items."""
+    mocker.patch.object(EsApi, "_make_es_request", return_value=json.dumps(LAST_WORK_ES_EMPTY_RESPONSE))
+
+    result = User._get_last_work(user_id=99)
+
+    assert result == {}
+
+
+def test_get_last_work_es_request_fails(mocker):
+    """Propagates the exception so callers don't silently overwrite existing last_work."""
+    mocker.patch.object(EsApi, "_make_es_request", side_effect=Exception("ES connection refused"))
+
+    with pytest.raises(Exception, match="ES connection refused"):
+        User._get_last_work(user_id=42)
