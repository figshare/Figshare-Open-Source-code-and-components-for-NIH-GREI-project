+    @classmethod
+    def _get_last_work(cls, user_id):
+        """Query ES public item indices for the user's most recently published item.
+
+        Returns {"title": "...", "published_date": "..."} or empty dict if none found.
+        Raises on ES failures so callers don't silently overwrite existing data.
+        """
+        # Search for the most recent published item authored by this user
+        query = {
+            "query": {"term": {"authors.user_id": user_id}},
+            "sort": [{"dates.published": {"order": "desc"}}],
+            "size": 1,
+            "_source": ["title", "dates.published"],
+        }
+
+        # ignore_unavailable=true allows the search to succeed even if one of
+        # the index families (legacy or ITBM) doesn't exist on this instance.
+        response = es_api._make_es_request(
+            f"{es_api.host}/{PUBLIC_ITEM_ES_INDICES}/_search?ignore_unavailable=true",
+            method="POST",
+            data=query,
+        )
+        result = json.loads(response)
+        hits = result.get("hits", {}).get("hits", [])
+        if hits:
+            source = hits[0]["_source"]
+            return {
+                "title": source.get("title", ""),
+                "published_date": source.get("dates", {}).get("published"),
+            }
+
+        return {}
+
