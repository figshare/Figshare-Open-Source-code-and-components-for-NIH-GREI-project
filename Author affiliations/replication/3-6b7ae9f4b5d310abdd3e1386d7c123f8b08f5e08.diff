diff --git a/tests/replication/common/test_update_authors_last_work.py b/tests/replication/common/test_update_authors_last_work.py
new file mode 100644
index 0000000..1dab0ef
--- /dev/null
+++ b/tests/replication/common/test_update_authors_last_work.py
@@ -0,0 +1,110 @@
+from mock import MagicMock, call
+
+from replication.indexers.common.common import update_authors_last_work
+
+
+def _expected_script(title, published_date):
+    """Build the expected painless script payload for assertions."""
+    return {
+        "source": (
+            "if (ctx._source.last_work == null "
+            "|| ctx._source.last_work.published_date == null "
+            "|| params.published_date.compareTo(ctx._source.last_work.published_date.toString()) > 0) { "
+            "ctx._source.last_work = params.last_work; "
+            "}"
+        ),
+        "params": {
+            "published_date": published_date,
+            "last_work": {
+                "title": title,
+                "published_date": published_date,
+            },
+        },
+    }
+
+
+def test_updates_each_author_with_user_id(mocker):
+    """Each author with a user_id gets an ES script update on the user index."""
+    es_mock = MagicMock()
+    mocker.patch("replication.indexers.lib.es_api.es_api", es_mock)
+
+    authors = [
+        {"user_id": 10, "name": "Alice"},
+        {"user_id": 20, "name": "Bob"},
+    ]
+    update_authors_last_work(authors, "My Article", "2026-10-01 00:00:00")
+
+    expected = _expected_script("My Article", "2026-10-01 00:00:00")
+    es_mock.update_document_with_script.assert_has_calls(
+        [call("user", 10, expected), call("user", 20, expected)],
+        any_order=False,
+    )
+    assert es_mock.update_document_with_script.call_count == 2
+
+
+def test_skips_authors_without_user_id(mocker):
+    """Authors without a user_id (unlinked) are skipped."""
+    es_mock = MagicMock()
+    mocker.patch("replication.indexers.lib.es_api.es_api", es_mock)
+
+    authors = [
+        {"user_id": 10, "name": "Alice"},
+        {"name": "Unlinked Author"},
+        {"user_id": None, "name": "Also unlinked"},
+    ]
+    update_authors_last_work(authors, "My Article", "2026-10-01 00:00:00")
+
+    # Only user_id=10 should be updated
+    assert es_mock.update_document_with_script.call_count == 1
+    es_mock.update_document_with_script.assert_called_once_with(
+        "user", 10, _expected_script("My Article", "2026-10-01 00:00:00")
+    )
+
+
+def test_no_op_when_title_is_empty(mocker):
+    """No ES calls when title is empty."""
+    es_mock = MagicMock()
+    mocker.patch("replication.indexers.lib.es_api.es_api", es_mock)
+
+    update_authors_last_work([{"user_id": 10}], "", "2026-10-01 00:00:00")
+    update_authors_last_work([{"user_id": 10}], None, "2026-10-01 00:00:00")
+
+    es_mock.update_document_with_script.assert_not_called()
+
+
+def test_no_op_when_published_date_is_empty(mocker):
+    """No ES calls when published_date is empty."""
+    es_mock = MagicMock()
+    mocker.patch("replication.indexers.lib.es_api.es_api", es_mock)
+
+    update_authors_last_work([{"user_id": 10}], "My Article", "")
+    update_authors_last_work([{"user_id": 10}], "My Article", None)
+
+    es_mock.update_document_with_script.assert_not_called()
+
+
+def test_no_op_when_authors_is_empty(mocker):
+    """No ES calls when authors list is empty."""
+    es_mock = MagicMock()
+    mocker.patch("replication.indexers.lib.es_api.es_api", es_mock)
+
+    update_authors_last_work([], "My Article", "2026-10-01 00:00:00")
+
+    es_mock.update_document_with_script.assert_not_called()
+
+
+def test_continues_on_es_exception(mocker):
+    """If ES update fails for one author, continue with the rest."""
+    es_mock = MagicMock()
+    es_mock.update_document_with_script.side_effect = [Exception("not found"), None]
+    mocker.patch("replication.indexers.lib.es_api.es_api", es_mock)
+
+    authors = [
+        {"user_id": 10, "name": "Missing User"},
+        {"user_id": 20, "name": "Existing User"},
+    ]
+    # Should not raise
+    update_authors_last_work(authors, "My Article", "2026-10-01 00:00:00")
+
+    # Both should be attempted
+    assert es_mock.update_document_with_script.call_count == 2
