+def update_authors_last_work(authors, title, published_date):
+    """Update last_work on each author's user document if this article is more recent.
+
+    Uses a conditional ES script so that only a newer published_date overwrites
+    the existing value.  Compares ISO-8601 date strings lexicographically.
+    """
+    from replication.indexers.lib.es_api import es_api
+
+    if not title or not published_date:
+        return
+
+    script = {
+        "source": (
+            "if (ctx._source.last_work == null "
+            "|| ctx._source.last_work.published_date == null "
+            "|| params.published_date.compareTo(ctx._source.last_work.published_date.toString()) > 0) { "
+            "ctx._source.last_work = params.last_work; "
+            "}"
+        ),
+        "params": {
+            "published_date": published_date,
+            "last_work": {
+                "title": title,
+                "published_date": published_date,
+            },
+        },
+    }
+
+    for author in authors:
+        user_id = author.get("user_id")
+        if user_id:
+            try:
+                es_api.update_document_with_script("user", user_id, script)
+            except Exception:
+                # User may not exist in the user index yet — skip silently.
+                logger.debug("Could not update last_work for user_id=%s", user_id)
+
+
