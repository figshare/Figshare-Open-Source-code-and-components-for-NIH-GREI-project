+    def generate_funding_xml_itbm(self, root, field, funding_list):
+        if not funding_list:
+            return
+
+        # field.options may be None for rows that were created before the options column was added
+        options = field.options if isinstance(field.options, dict) else {}
+        # <fundingReferences> is created lazily to avoid an empty element when
+        # the list contains only free-text entries with no configured crosswalks.
+        funding_references = None
+
+        for funding in funding_list:
+            if funding.get("type") == "free_text_funding":
+                # Free-text funding uses crosswalk config from item_type_field.options, same
+                # format as custom fields. The old equivalent was standard_field.crosswalks:
+                #   {"datacite": {"item_type_default": [{"mapping": "fundingReference.funderName", "text": "{data[funder_name]}"}]}}
+                provider_crosswalks = options.get("crosswalks", {}).get(self.PROVIDER_NAME, [])
+                if not provider_crosswalks:
+                    continue
+                if funding_references is None:
+                    funding_references = ET.SubElement(root, "fundingReferences")
+                for crosswalk in provider_crosswalks:
+                    self.generate_custom_field_xml(funding_references, crosswalk, funding, {})
+            else:
+                if funding_references is None:
+                    funding_references = ET.SubElement(root, "fundingReferences")
+                funding_reference = ET.SubElement(funding_references, "fundingReference")
+                funder_name = ET.SubElement(funding_reference, "funderName")
+                funder_name.text = funding["funder_name"]
+
+                if funding["funder_identifier_type"] == "ROR":
+                    funder_identifier = ET.SubElement(funding_reference, "funderIdentifier")
+                    funder_identifier.set("funderIdentifierType", funding["funder_identifier_type"])
+                    funder_identifier.set("schemeURI", funding["funder_identifier_scheme_uri"])
+                    funder_identifier.text = funding["funder_identifier"]
+
+                award_number = ET.SubElement(funding_reference, "awardNumber")
+                if funding["award_uri"]:
+                    award_number.set("awardURI", funding["award_uri"])
+                award_number.text = funding["award_number"]
+
+                award_title = ET.SubElement(funding_reference, "awardTitle")
+                award_title.text = funding["award_title"]
+
     def reserve_doi(self, item_data, replace=True):
         item_doi = item_data.get("doi")
         standard_doi = self.doi_prefix + str(item_data["item_id"])
