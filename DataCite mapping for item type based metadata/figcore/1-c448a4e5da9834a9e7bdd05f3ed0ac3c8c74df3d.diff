+    def test_generate_funding_xml_itbm_free_text_uses_crosswalk(
+        self, mock_rm, mock_funding, mock_grid_find, mock_grids, mock_cats
+    ):
+        # free_text_funding dispatches to generate_custom_field_xml via the crosswalk config
+        # on field.options, not via the standard fundingReference block.
+        helper = DataCiteDOIHelper(**self.CONFIG)
+        root = ET.Element("resource")
+        field = mock.Mock()
+        field.options = {
+            "crosswalks": {"datacite": [{"mapping": "fundingReference.funderName", "text": "{data[funder_name]}"}]}
+        }
+        funding_list = [{"type": "free_text_funding", "funder_name": "Open Society Foundations"}]
+        helper.generate_funding_xml_itbm(root, field, funding_list)
+        xml = ET.tostring(root).decode()
+        self.assertIn("<fundingReferences>", xml)
+        self.assertIn("Open Society Foundations", xml)
+        # No <awardNumber> or <funderIdentifier> — crosswalk only produces what's configured
+        self.assertNotIn("<awardNumber>", xml)
+        self.assertNotIn("<funderIdentifier", xml)
