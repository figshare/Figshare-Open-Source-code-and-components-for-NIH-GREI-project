+    def add_custom_xml_itbm(self, root, field_options, value):
+        # Crosswalk config is read from item_type_field.options["crosswalks"][provider].
+        # This is the ITBM equivalent of custom_field.crosswalks, with two differences:
+        #   - wrapped under a "crosswalks" key (options may also carry other config, e.g. is_facet)
+        #   - no intermediate item-type key (item_type_field rows are already per item type)
+        # Old format (custom_field.crosswalks):
+        #   {"datacite": {"item_type_default": [{"mapping": "contributors.contributor.nameIdentifier", ...}]}}
+        # New format (item_type_field.options):
+        #   {"crosswalks": {"datacite": [{"mapping": "contributors.contributor.nameIdentifier", ...}]}}
+        if field_options and field_options.get("crosswalks", {}).get(self.PROVIDER_NAME, []):
+            duplicate_mapping = self._generate_duplicate_mapping(root, first_level_only=True)
+
+            for crosswalk in field_options["crosswalks"][self.PROVIDER_NAME]:
+                self.generate_custom_field_xml(root, crosswalk, value, duplicate_mapping)
