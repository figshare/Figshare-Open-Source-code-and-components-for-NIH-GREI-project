index f3ed7a14b..099068ee1 100644
--- a/tests/lib/identifier/doi/test_doi_helper.py
+++ b/tests/lib/identifier/doi/test_doi_helper.py
@@ -1,3 +1,4 @@
+from datetime import datetime, timedelta
 from mock import Mock
 
 from figcore.api import Article, Account
@@ -52,3 +53,53 @@ class TestDOIHelper(BaseTestTransactioned):
         helper = DOIHelper(**self.config)
         data = helper.article_data(article)
         self.assertEqual(data["crossref_res_rel"], "IsSupplementTo")
+
+    def test_article_data_issued_date_priority(self):
+        """Test that issued_date uses correct priority: pub_publish_date > online_publish_date > published_date"""
+
+        account = Account.find(1)
+        article_data = {
+            "title": "Test article",
+            "description": "Test description",
+            "is_active": 1,
+            "defined_type": 3,
+            "categories": [2],
+            "tags": ["test"],
+        }
+        article = account.create_article(article_data)
+        helper = DOIHelper(**self.config)
+
+        # Test 1: Only published_date is set
+        account.actions_for(article).publish()
+        article = Article.find(article.id).last_version
+        data = helper.article_data(article)
+        self.assertEqual(
+            data["issued_date"].date() if hasattr(data["issued_date"], "date") else data["issued_date"],
+            article.published_date.date() if hasattr(article.published_date, "date") else article.published_date,
+        )
+        self.assertIsNotNone(data["issued_date"])
+
+        # Test 2: online_publish_date takes priority over published_date
+        online_date = datetime.now() - timedelta(days=10)
+        self.execute_raw_sql(
+            f"UPDATE article_version SET online_publish_date='{online_date.strftime('%Y-%m-%d %H:%M:%S')}' WHERE article_id={article.id}"
+        )
+        article = Article.find(article.id).last_version
+        data = helper.article_data(article)
+        # Should now use online_publish_date (which is set, taking priority)
+        self.assertIsNotNone(data["issued_date"])
+
+        # Test 3: pub_publish_date takes priority over online_publish_date
+        pub_date = datetime.now() - timedelta(days=5)
+        self.execute_raw_sql(
+            f"UPDATE article_version SET pub_publish_date='{pub_date.strftime('%Y-%m-%d %H:%M:%S')}' WHERE article_id={article.id}"
+        )
+        article = Article.find(article.id).last_version
+        data = helper.article_data(article)
+        # Should now use pub_publish_date (highest priority)
+        # pub_publish_date is not None, so it should be selected
+        self.assertIsNotNone(article.pub_publish_date)
+        self.assertEqual(
+            data["issued_date"].date() if hasattr(data["issued_date"], "date") else data["issued_date"],
+            article.pub_publish_date.date() if hasattr(article.pub_publish_date, "date") else article.pub_publish_date,
+        )
