+    def test_issued_date_not_in_xml_when_none(self):
+        """Test that issued_date is not added to XML when None"""
+        from datetime import date
+
+        helper = DataCiteDOIHelper(**self.CONFIG)
+        item_data = dict(self.item_data)
+        item_data["issued_date"] = None
+        item_data["authors"] = [["Test Author", None, "Test", "Author", []]]
+        item_data["created_date"] = date(2019, 5, 23)
+
+        doi_xml = helper.build_xml(item_data)
+
