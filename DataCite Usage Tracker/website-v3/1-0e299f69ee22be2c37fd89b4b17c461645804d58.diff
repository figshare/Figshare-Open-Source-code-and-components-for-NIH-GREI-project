diff --git a/src/pages/item/DataCiteTracker/utils.js b/src/pages/item/DataCiteTracker/utils.js
new file mode 100644
index 000000000..ff867a39e
--- /dev/null
+++ b/src/pages/item/DataCiteTracker/utils.js
@@ -0,0 +1,32 @@
+/* eslint-disable new-cap */
+import { guard } from "@figshare/fcl/helpers/guard";
+
+
+const FIGSHARE_ARS = "da-ozpkks";
+const FIGSHARE_PLUS = "da-bis6ul";
+
+
+function getDataCiteTracker(repoId) {
+  const tracker = window.DataCiteTracker.Tracker({
+    repoId,
+    trackLocalhost: false,
+  });
+
+  return tracker;
+}
+
+export function trackItemDownloadOnDataCite({ doi }) {
+  guard(() => {
+    const isPrivate = window.location.pathname.startsWith("/account");
+
+    if (isPrivate) {
+      return;
+    }
+
+    const tracker1 = getDataCiteTracker(FIGSHARE_ARS);
+    tracker1.trackMetric("download", { doi });
+
+    const tracker2 = getDataCiteTracker(FIGSHARE_PLUS);
+    tracker2.trackMetric("download", { doi });
+  });
+}
diff --git a/src/pages/item/DataCiteTracker/utils.test.js b/src/pages/item/DataCiteTracker/utils.test.js
new file mode 100644
index 000000000..6d0621337
--- /dev/null
+++ b/src/pages/item/DataCiteTracker/utils.test.js
@@ -0,0 +1,40 @@
+import { trackItemDownloadOnDataCite } from "./utils";
+
+
+describe("trackItemDownloadOnDataCite", () => {
+  const doi = "test/doi";
+
+  it("doesn't call Tracker when pathname contains /account", () => {
+    global.window = Object.create(window);
+    Object.defineProperty(window, "location", {
+      value: { pathname: "/account/test" },
+      writable: true,
+    });
+
+    Object.defineProperty(window, "DataCiteTracker", {
+      value: { Tracker: jest.fn() },
+      writable: true,
+    });
+
+    trackItemDownloadOnDataCite({ doi });
+
+    expect(window.DataCiteTracker.Tracker).not.toHaveBeenCalled();
+  });
+
+  it("calls Tracker when pathname doesn't contain /account", () => {
+    global.window = Object.create(window);
+    Object.defineProperty(window, "location", {
+      value: { pathname: "/test" },
+      writable: true,
+    });
+
+    Object.defineProperty(window, "DataCiteTracker", {
+      value: { Tracker: jest.fn() },
+      writable: true,
+    });
+
+    trackItemDownloadOnDataCite({ doi });
+
+    expect(window.DataCiteTracker.Tracker).toHaveBeenCalled();
+  });
+});
