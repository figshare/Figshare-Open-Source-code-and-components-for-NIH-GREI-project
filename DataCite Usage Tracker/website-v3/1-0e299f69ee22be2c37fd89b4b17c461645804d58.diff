diff --git a/src/pages/item/DataCiteTracker/DataCiteTracker.jsx b/src/pages/item/DataCiteTracker/DataCiteTracker.jsx
new file mode 100644
index 000000000..633eaa52d
--- /dev/null
+++ b/src/pages/item/DataCiteTracker/DataCiteTracker.jsx
@@ -0,0 +1,35 @@
+import React from "react";
+import { string } from "prop-types";
+import { Helmet } from "react-helmet-async";
+
+
+const FIGSHARE_ARS = "da-ozpkks";
+const FIGSHARE_PLUS = "da-bis6ul";
+
+export function DataCiteTracker({ doi }) {
+
+  return (
+    <Helmet>
+      {/* Track View */}
+      <script
+        data-doi={doi}
+        data-repoid={FIGSHARE_ARS}
+        defer={true}
+        src="https://cdn.jsdelivr.net/npm/@datacite/datacite-tracker"
+      />
+
+      {/* Track View */}
+      <script
+        data-doi={doi}
+        data-repoid={FIGSHARE_PLUS}
+        defer={true}
+        src="https://cdn.jsdelivr.net/npm/@datacite/datacite-tracker"
+      />
+    </Helmet>
+  );
+}
+
+DataCiteTracker.propTypes = { doi: string.isRequired };
+DataCiteTracker.defaultProps = { doi: undefined };
+
+export default React.memo(DataCiteTracker);
